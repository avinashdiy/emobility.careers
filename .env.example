# ─────────────────────────────────────────────────────────────
# emobility.careers — environment template
# Copy to .env.local for development. Never commit secrets.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="eMobility Careers"

# Database (Postgres with pgvector)
# In production, include connection pool settings:
#   ?schema=public&connection_limit=10&pool_timeout=20
DATABASE_URL="postgresql://emce:emce_dev@localhost:5432/emce?schema=public"
# Used by docker-compose.prod.yml
POSTGRES_USER=emce
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=emce

# Redis (BullMQ + cache)
# Local dev: no auth. Production: include the password from compose --requirepass
#   REDIS_URL="redis://:CHANGE_ME@redis:6379"
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=change_me_in_prod

# NextAuth v5
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# OAuth providers
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL_PARSER="gpt-4o-mini"
OPENAI_MODEL_RERANK="gpt-4o"
OPENAI_MODEL_EMBEDDING="text-embedding-3-large"

# Object storage (MinIO local / S3 in prod)
#
# Two endpoints, two purposes:
#   S3_ENDPOINT  — internal address used by the web/worker container
#                  to reach MinIO. In Docker compose, this is the
#                  service name `minio:9000`. NOT browser-reachable.
#   S3_PUBLIC_URL — browser-reachable URL used to:
#                    1. Construct direct-fetch URLs to public buckets
#                       (avatars / logos via lib/storage.ts → publicUrl).
#                    2. Sign presigned download URLs (resume, ICS) so
#                       the signature matches the URL the browser hits.
#                  In production this should be a Caddy-proxied subdomain
#                  with NO path prefix stripping (see docker/Caddyfile
#                  → files.emobility.careers).
#
# Production values:
#   S3_ENDPOINT=http://minio:9000
#   S3_PUBLIC_URL=https://files.emobility.careers
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="emce_minio"
S3_SECRET_KEY="emce_minio_dev"
S3_BUCKET_RESUMES="emce-resumes"
S3_BUCKET_AVATARS="emce-avatars"
S3_BUCKET_LOGOS="emce-logos"
S3_BUCKET_DOCS="emce-docs"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000"

# GitHub Container Registry — used by docker-compose.prod.yml image refs
GHCR_USER=your-github-username

# Email — Amazon SES is the primary provider. Set the three AWS_SES_* vars
# below and the app will route every transactional email + magic-link
# sign-in through SES. If only RESEND_API_KEY is set, the app falls back
# to Resend (handy for local development without AWS).
AWS_SES_REGION="ap-south-1"
AWS_SES_ACCESS_KEY_ID=""
AWS_SES_SECRET_ACCESS_KEY=""
# Optional — only set if you've configured a SES Configuration Set for
# event publishing (bounces, complaints, opens, etc.).
AWS_SES_CONFIGURATION_SET=""

# Resend (optional fallback)
RESEND_API_KEY=""

# Sender identity used by both providers. Format:
#   "Display Name <verified@yourdomain.com>"
# The address must be a verified SES identity in production.
EMAIL_FROM="eMobility Careers <noreply@emobility.careers>"

# SMS (MSG91 — India)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="EMCAR"
MSG91_OTP_TEMPLATE_ID=""
MSG91_TXN_TEMPLATE_ID=""

# WhatsApp (Meta Cloud API — optional, post-v1)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Soketi (self-hosted Pusher-compatible).
# In production set HOST/PORT/TLS to your Caddy-fronted realtime
# subdomain — e.g.:
#   NEXT_PUBLIC_SOKETI_HOST="realtime.emobility.careers"
#   NEXT_PUBLIC_SOKETI_PORT=443
#   NEXT_PUBLIC_SOKETI_TLS=true
SOKETI_APP_ID="emce"
SOKETI_APP_KEY="emce_pusher_key"
SOKETI_APP_SECRET="emce_pusher_secret"
NEXT_PUBLIC_SOKETI_HOST="localhost"
NEXT_PUBLIC_SOKETI_PORT=6001
NEXT_PUBLIC_SOKETI_KEY="emce_pusher_key"
NEXT_PUBLIC_SOKETI_TLS=false

# DIYguru integration
DIYGURU_API_URL="https://campus.diyguru.com/api"
DIYGURU_API_KEY=""

# Razorpay (post-v1 — schema hooks ready)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Observability
SENTRY_DSN=""
LOG_LEVEL="info"

# SEO — instant indexing
# IndexNow (Bing, Yandex, Naver, Seznam, DuckDuckGo via fan-out)
# Generate: openssl rand -hex 16
# Spec: https://www.indexnow.org/documentation
INDEXNOW_KEY=""

# Google Indexing API (specifically for JobPosting URLs)
# Setup: https://developers.google.com/search/apis/indexing-api/v3/prereqs
# Paste the full service-account JSON (escape newlines if needed).
GOOGLE_INDEXING_SERVICE_ACCOUNT_KEY=""

# Search Console verification meta tag (optional — DNS verification is preferred)
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# Anti-spam — Cloudflare Turnstile (free CAPTCHA alternative)
# When BOTH keys are set, signup + signin + magic-link all gate on a
# Turnstile challenge. When unset, the gate is a no-op (dev / staging are
# unaffected by default). Honeypot + timing + disposable-email block + IP
# rate-limit + email verification all run regardless. Get keys at
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
