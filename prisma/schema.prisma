// Prisma schema for emobility.careers
// Models reflect the existing WordPress plugin's data model
// (see /tmp/emob-engine-v3/.../includes/Core/Migrator.php and migrations/)
// adapted for a Postgres + pgvector + NextAuth setup.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─── Identity & access ───────────────────────────────────────

enum Role {
  ADMIN
  EMPLOYER
  CANDIDATE
}

/// ISO 3166-1 alpha-2 country codes — the platform's "where in the
/// world is this user / job / company" dimension. We intentionally
/// model this as an enum (not free-text) so the routing layer,
/// sitemap shards, currency formatter, hreflang generator, and GSC
/// folder-target settings all agree on the SAME closed set of
/// supported countries. Adding a country = add an enum value AND a
/// row to lib/countries.ts AND a sitemap shard AND a GSC property.
///
/// IN is the default for backward compatibility — the ~50k existing
/// users all backfill to India, which is correct for ~99% of them.
/// Note: Existing String country fields on CandidateProfile,
/// RecruitmentDrive, and Institution use ISO codes too but stay as
/// String for now (no destructive migration). They'll converge with
/// this enum in a follow-up PR once we've cleaned the underlying
/// values.
enum Country {
  IN // India (default — existing user base)
  AE // United Arab Emirates
  AU // Australia
  US // United States
  GB // United Kingdom (ISO uses GB, NOT UK)
  MY // Malaysia
  BD // Bangladesh
  NP // Nepal
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Finer-grained moderation lifecycle (see `User.accountState`).
/// Distinct from `AccountStatus` because:
///   • `AccountStatus` is the legacy hard-state (ACTIVE / SUSPENDED /
///     DELETED) — gates auth + visibility platform-wide.
///   • `AccountState` is a moderation-policy state derived from
///     accumulated strikes. ACTIVE is the "in good standing" default;
///     WARNED is "next strike triggers a suspension"; SUSPENDED is the
///     same as AccountStatus.SUSPENDED but auto-stamped via the strike
///     state machine; BANNED is permanent (5 strikes).
///
/// Both fields are kept and updated in sync inside the strike helper.
/// Code paths read whichever fits the question — middleware reads
/// AccountStatus for the auth gate; the user-facing /me/account page
/// reads AccountState for the warning copy.
enum AccountState {
  ACTIVE /// Default — full platform access.
  WARNED /// 1-2 strikes. Banner shown on /me explaining the next
  /// strike triggers a 7-day suspension.
  SUSPENDED /// 3-4 strikes. 7-day cool-off; can read but not post,
  /// comment, answer, apply, or message. Auto-restored
  /// after 7 days back to WARNED.
  BANNED /// 5+ strikes. Permanent. Login blocked entirely.
}

/// Reasons an admin can issue a strike. Drives the "what happened"
/// copy shown to the user on /me/account so they know exactly what
/// triggered each strike — transparency is the deterrent. A strike
/// row carries an optional free-text `note` that admins use for
/// edge cases.
enum StrikeReason {
  COMMENT_HIDDEN /// Comment hidden by a moderator
  POST_REMOVED /// Post hidden / removed by a moderator
  REPORT_UPHELD /// User reported; report was actioned
  HARASSMENT /// Repeated inappropriate behaviour
  IMPERSONATION /// Pretending to be another person / brand
  SPAM /// Spammy posting / messaging
  TOS_VIOLATION /// Generic catch-all
  OTHER /// Free-text reason (see `note`)
}

/// Grievance ticket lifecycle. Maps to Indian IT Rules 2021's
/// 24-hour acknowledgement + 15-day resolution SLAs. ACK is auto-set
/// when a grievance officer first opens the ticket OR after 24h
/// elapses (worker tick — closes the SLA window even if no human
/// looked).
enum GrievanceStatus {
  OPEN /// New, no admin has touched it yet
  ACKNOWLEDGED /// Admin opened / commented (24h SLA met)
  IN_PROGRESS /// Admin actively working on it
  RESOLVED /// Admin closed with resolution notes
  REJECTED /// Out of scope / spam / duplicate
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  emailVerifiedAt  DateTime?
  passwordHash     String?
  name             String?
  image            String?
  role             Role          @default(CANDIDATE)
  status           AccountStatus @default(ACTIVE)
  /// Shadow-ban: posts and comments created while this is set are
  /// auto-hidden from public surfaces (visibility=PRIVATE on creation,
  /// hiddenAt stamped on comments). The user themselves still sees
  /// their content so they don't realise — that's the whole point of
  /// shadow-banning, vs an outright SUSPENDED status.
  shadowBannedAt   DateTime?
  shadowBannedById String?
  shadowBanReason  String?       @db.Text
  /// Cumulative moderation strikes — see model Strike + enum
  /// AccountState. Helper `lib/strikes.ts` is the only writer.
  strikes          Int           @default(0)
  accountState     AccountState  @default(ACTIVE)
  /// Auto-set to (now + 7d) when accountState transitions to
  /// SUSPENDED at 3 strikes. The notification-maintenance worker
  /// tick reads this to auto-restore at expiry.
  suspendedUntil   DateTime?
  locale           String        @default("en")
  /// User's "home" country — the dimension that drives default
  /// currency, time-zone, GSC subfolder, hreflang routing, and the
  /// "same country" lens on networking/discovery. Captured at signup
  /// (pre-filled from IP), changeable later from /me/settings. IN
  /// for all existing users via the backfill default.
  country          Country       @default(IN)
  /// Timestamp of the most recent EXPLICIT country choice. Stamped
  /// when:
  ///   • The user submitted the signup form (PR 1 — the dropdown
  ///     was the deliberate signal)
  ///   • They picked from the `ConfirmCountryBanner` (PR 6)
  ///   • They changed it from `/me/settings`
  ///
  /// Null = never confirmed. Two populations match:
  ///   1. The ~50k existing users whose `country` was backfilled to
  ///      IN by PR 1 without their input. ~99% are correctly Indian
  ///      but the 1% diaspora (Indians-abroad, returning expats)
  ///      need the prompt.
  ///   2. OAuth signups (Google + LinkedIn) that bypass the signup
  ///      form's country dropdown — they default to IN regardless
  ///      of their actual market.
  ///
  /// The banner reads `countryConfirmedAt IS NULL` and surfaces a
  /// one-question nudge. After save, the column is non-null and the
  /// banner never re-surfaces. Honours diaspora users without
  /// annoying the 99% who are correctly defaulted.
  countryConfirmedAt DateTime?
  phone            String?
  phoneVerifiedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lastLoginAt      DateTime?

  // Anti-spam signals captured at signup. signupIp + signupUserAgent give
  // moderators something to triage by when a wave of fake accounts shows
  // up (e.g. "every account from 1.2.3.4 in the last hour, suspend").
  // failedLoginCount + lockedUntil drive a temporary lockout after N bad
  // password attempts so credential-stuffing slows itself down.
  signupIp         String?
  signupUserAgent  String?   @db.Text
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  // First-login product-tour state. Null until the candidate finishes (or
  // explicitly skips) the welcome walkthrough. The site-header surfaces
  // the tour while this is null AND profileCompleteness < 90.
  productTourCompletedAt DateTime?

  // Placement-officer access flag — admin-grantable. When true, /tpo
  // becomes reachable for this user even though their `role` is not
  // ADMIN. Lets DIYguru placement coordinators run cohort dashboards
  // without seeing the rest of /admin (moderation, settings, etc.).
  isPlacementOfficer Boolean @default(false)

  accounts                Account[]
  sessions                Session[]
  candidateProfile        CandidateProfile?
  employerProfile         EmployerProfile?
  ownedCompanies          Company[]               @relation("CompanyOwner")
  postedJobs              JobPosting[]            @relation("JobPoster")
  notifications           Notification[]          @relation("NotificationRecipient")
  notificationsActedOn    Notification[]          @relation("NotificationActor")
  // Inverse of CandidateProfile.idVerificationReviewedBy — admin actions
  // recorded on the candidate's verification request. Audit-trailable
  // without a separate join table because the reviewer is always a User.
  idVerificationReviews   CandidateProfile[]      @relation("IDVerificationReviewer")
  // Inverse of PostComment.hiddenById — comments this admin has hidden.
  hiddenComments          PostComment[]           @relation("CommentHider")
  // Subscriptions / billing scaffolding (v1: schema only, no UI flow).
  subscriptions           Subscription[]          @relation("SubscriptionUser")
  // Hashtag policies + announcements + experiments authored by this admin.
  hashtagPolicies         HashtagPolicy[]         @relation("HashtagPolicyAuthor")
  announcements           Announcement[]          @relation("AnnouncementAuthor")
  experiments             Experiment[]            @relation("ExperimentAuthor")
  notificationPrefs       NotificationPreference?
  sentMessages            Message[]               @relation("MessageSender")
  applicationNotes        ApplicationNote[]
  stageHistoryActions     StageHistory[]          @relation("StageActor")
  auditEntries            AuditLog[]
  diyguruImports          DIYguruImportBatch[]
  verificationReviews     VerificationRequest[]   @relation("VerificationReviewer")
  teamInvitesSent         TeamInvite[]            @relation("TeamInviteInviter")
  recommendationsGiven    Recommendation[]        @relation("RecommendationGiver")
  recommendationsReceived Recommendation[]        @relation("RecommendationReceiver")
  skillEndorsementsGiven  SkillEndorsement[]      @relation("SkillEndorser")

  // Q&A — answers the user has authored, and the helpful-votes they've cast
  answersAuthored    Answer[]        @relation("AnswerAuthor")
  answerHelpfulVotes AnswerHelpful[] @relation("AnswerVoter")

  // Events — events the user has created (as a company admin) and
  // registrations they hold.
  eventsCreated      Event[]             @relation("EventCreator")
  eventRegistrations EventRegistration[] @relation("EventAttendee")

  // Social graph
  connectionRequests           Connection[]          @relation("ConnectionRequester")
  connectionsReceived          Connection[]          @relation("ConnectionRecipient")
  // Contact-share request flow — recruiter side (sent) + candidate
  // side (received). See `model ContactShareRequest` for the
  // lifecycle. Cascade-on-user-delete is fine: requests are tied to
  // a real User; if either party leaves, the row goes with them.
  contactShareRequestsSent     ContactShareRequest[] @relation("ContactShareRequester")
  contactShareRequestsReceived ContactShareRequest[] @relation("ContactShareTarget")
  // Strike trail — both sides for audit + admin dashboards.
  strikesReceived              Strike[]              @relation("StrikeTarget")
  strikesIssued                Strike[]              @relation("StrikeAuthor")
  // Grievance officer ticket queue (filer + assignee).
  grievancesFiled              GrievanceTicket[]     @relation("GrievanceFiler")
  grievancesAssigned           GrievanceTicket[]     @relation("GrievanceAssignee")
  followingUsers               Follow[]              @relation("Follower")
  followers                    Follow[]              @relation("FolloweeUser")
  posts                        Post[]                @relation("PostAuthor")
  postReactions                PostReaction[]
  postComments                 PostComment[]
  pollVotes                    PollVote[]            @relation("PollVoter")

  // Mentorship
  mentorProfile      MentorProfile?
  mentorshipBookings MentorshipSession[] @relation("MentorshipMentee")
  mentorshipReviews  MentorshipReview[]  @relation("MentorshipReviewer")

  // WordPress legacy tracking — set during the initial migration so re-runs
  // upsert by this id rather than creating duplicates. Cleared (or kept,
  // doesn't matter) after the WP site is decommissioned.
  wpLegacyId  Int?      @unique
  wpClaimedAt DateTime? // null until the user signs in for the first time post-import

  // Competitions
  competitionsHosted          Competition[]                  @relation("CompetitionPostedBy")
  competitionRegistrations    CompetitionRegistration[]      @relation("CompetitionLeader")
  competitionTeamMemberships  CompetitionTeamMember[]        @relation("CompetitionMember")
  competitionJudgeAssignments CompetitionJudge[]             @relation("CompetitionJudge")
  competitionTeamsVerified    CompetitionRegistration[]      @relation("CompetitionTeamVerifier")
  recruitmentDrivesCreated    RecruitmentDrive[]             @relation("RecruitmentDriveCreator")
  /// Back-relations for fair attendee management. `fairCheckInsConducted`
  /// is the audit trail of registrations this admin marked present
  /// at the venue. `fairRosterImports` is the audit trail of CSV
  /// roster uploads this admin made.
  fairCheckInsConducted       RecruitmentDriveRegistration[] @relation("FairCheckInBy")
  fairRosterImports           RecruitmentDriveRosterImport[] @relation("FairRosterImporter")
  /// College placement-cell sign-ups the user filed (typically one
  /// per TPO) + the moderation audit trail for admins who reviewed.
  placementCellsCreated       CollegePlacementCell[]         @relation("PlacementCellCreator")
  placementCellsReviewed      CollegePlacementCell[]         @relation("PlacementCellReviewer")
  companyClaimsFiled          CompanyClaim[]                 @relation("CompanyClaimant")
  companyClaimsReviewed       CompanyClaim[]                 @relation("CompanyClaimReviewer")
  articlesAuthored            Article[]                      @relation("ArticleAuthor")
  // SEO-targeted job-description templates this admin authored. See
  // `JobDescriptionTemplate` further down for the publishing flow.
  jdTemplatesAuthored         JobDescriptionTemplate[]       @relation("JDTemplateAuthor")
  hashtagSubscriptions        HashtagSubscription[]          @relation("HashtagSubscriber")
  profileViewsReceived        ProfileView[]                  @relation("ProfileViewed")
  profileViewsMade            ProfileView[]                  @relation("ProfileViewer")
  wordpressImportBatches      WordPressImportBatch[]         @relation("WordPressImporter")
  interviewSessions           InterviewSession[]             @relation("InterviewSessionUser")
  cvEvaluations               CvEvaluation[]                 @relation("CvEvaluationUser")

  // TPO / placement
  cohortsCreated Cohort[]

  // Verified-company badge audit — records each Experience row this
  // recruiter approved. Reverse of Experience.verifiedBy.
  experienceVerifications Experience[] @relation("ExperienceVerifier")

  // WhatsApp daily-digest subscriptions linked to this user (when they
  // subscribed while signed in).
  whatsappDigests WhatsAppDigestSubscription[] @relation("DigestSubscriber")

  // FeaturedSlot rows this admin curated.
  featuredSlotsCurated FeaturedSlot[] @relation("FeaturedCurator")

  // Wave C back-relations
  automationsCreated          PipelineAutomation[]     @relation("AutomationCreator")
  hiringAssistantsOwned       HiringAssistantConfig[]  @relation("HiringAssistantOwner")
  callingSessionsTriggered    CallingSession[]         @relation("CallingTriggerer")
  companyReviewsAuthored      CompanyReview[]          @relation("CompanyReviewAuthor")
  companyReviewsModerated     CompanyReview[]          @relation("CompanyReviewModerator")
  institutionReviewsAuthored  InstitutionReview[]      @relation("InstitutionReviewAuthor")
  institutionReviewsModerated InstitutionReview[]      @relation("InstitutionReviewModerator")
  discussionThreadsAuthored   EntityDiscussionThread[] @relation("DiscussionThreadAuthor")
  discussionRepliesAuthored   EntityDiscussionReply[]  @relation("DiscussionReplyAuthor")
  careerExplorations          CareerExplorationLog[]   @relation("CareerExplorerUser")

  // Wave A back-relations
  groupMemberships GroupMembership[] @relation("GroupMember")

  // Wave B back-relations
  outreachCadencesCreated OutreachCadence[]    @relation("OutreachCadenceCreator")
  outreachEnrollments     OutreachEnrollment[] @relation("OutreachEnrolledBy")

  // Admin notification template authoring + per-user dispatch logs.
  notificationTemplatesAuthored NotificationTemplate[] @relation("NotificationTemplateAuthor")
  notificationLogs              NotificationLog[]      @relation("NotificationLogUser")

  // Feature flag authoring + targeted enrolment.
  featureFlagsAuthored FeatureFlag[]       @relation("FeatureFlagAuthor")
  featureFlagTargets   FeatureFlagTarget[] @relation("FeatureFlagTargetUser")

  /// Inverse of CompanyEnrichmentProposal.reviewedBy — proposals this
  /// admin approved / rejected. Audit trail for "who applied X to
  /// company Y".
  companyEnrichmentProposalsReviewed CompanyEnrichmentProposal[] @relation("CompanyEnrichmentReviewed")

  // Academy integration (Phase 1.10 outbox webhook). Rows written by
  // /api/v1/sync/academy when academy POSTs lesson/course/cert/quiz
  // events. Cascade-on-delete: a user removal wipes their learning
  // history on careers; the source-of-truth rows remain on academy.
  learningCredentials LearningCredential[]

  @@index([role, status])
  // Country segmentation — analytics (DAU per country), feed
  // "same country" lens, signup geo distribution. Cheap to maintain.
  @@index([country])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── EV taxonomy ─────────────────────────────────────────────
// Domains: Battery Tech, Charging, Powertrain, Motor Control, etc.

model EVDomain {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  skills            Skill[]
  candidateDomains  CandidateEVDomain[]
  jobDomains        JobEVDomain[]
  salaryBenchmarks  SalaryBenchmark[]
  salarySubmissions SalarySubmission[]
  jdTemplates       JobDescriptionTemplate[]
}

model Skill {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  category   String?
  evDomainId String?
  evDomain   EVDomain? @relation(fields: [evDomainId], references: [id])
  createdAt  DateTime  @default(now())

  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  // FTS: GENERATED tsvector built post-push by scripts/setup-fts.sql.
  // The Prisma schema declares the column as Unsupported because
  // Prisma's `db push` can't generate the GENERATED ALWAYS expression
  // — the ALTER lives in setup-fts.sql and runs idempotently on every
  // setup-vps.sh. See lib/search-fts.ts for query usage.
  searchTsv Unsupported("tsvector")?

  @@index([evDomainId])
  @@index([category])
}

// ─── Candidate ───────────────────────────────────────────────

enum ProfileMode {
  FRESHER
  EXPERIENCED
  TECHNICIAN
  LEADERSHIP
}

// Person types — anyone on the platform has a CandidateProfile (the profile is
// universal). Person type drives badges, default fields, and discoverability.
enum PersonType {
  PROFESSIONAL // industry professional (default)
  STUDENT // college student / fresh graduate
  TRAINER // course creator / instructor
  FACULTY // college professor / academic
  TPO // Training & Placement Officer
  EXPERT // industry expert / consultant
  COMPANY_REP // founder / leadership posting on behalf of a company
}

enum AvailabilityStatus {
  IMMEDIATE
  DAYS_15
  DAYS_30
  DAYS_60
  NOT_LOOKING
  HIRED
}

enum CVVisibility {
  EVERYONE
  EMPLOYERS_ONLY
  PRIVATE
}

// Granular gates for sensitive fields. Both default to PRIVATE so first-time
// users don't leak personal data. The candidate can loosen each independently
// from /me/profile.
enum ContactVisibility {
  PRIVATE // owner only
  CONNECTIONS // 1st-degree connections
  EMPLOYERS_ONLY // verified employers (the LinkedIn cold-outreach pattern)
  EVERYONE // public — surfaced on the profile page
}

enum ResumeVisibility {
  PRIVATE // owner only — must apply to a job to share
  EMPLOYERS_ONLY // verified employers can download
  EVERYONE // public download link
}

enum RelocationPref {
  ANYWHERE
  WITHIN_STATE
  HOMETOWN_ONLY
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model CandidateProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug                  String             @unique
  firstName             String
  lastName              String?
  headline              String?
  summary               String?            @db.Text
  profilePhotoUrl       String?
  /// LinkedIn-style cover photo. Renders behind the avatar at the top
  /// of the public profile (1584×396 ideal, 4:1 ratio). Optional —
  /// falls back to the brand gradient when null. Stored as a public
  /// URL into the avatars bucket under the `banners/` prefix.
  bannerUrl             String?
  phone                 String?
  email                 String?
  location              String?
  // ISO 3166-1 alpha-2 country code (e.g. "IN", "US", "AE"). Captured
  // during onboarding so the profile header can render a flag icon and
  // job filters / matching can scope by country. Optional because legacy
  // profiles created before this column exists won't have it; UI prompts
  // the user to fill it in via a banner on /me when null.
  country               String?            @db.VarChar(2)
  // City name as the candidate typed it (free text — no canonical city
  // table for v1). Combined with `country` to render the
  // "City, Country" display string in the profile header.
  city                  String?
  preferredCities       String[]           @default([])
  relocationPref        RelocationPref     @default(ANYWHERE)
  profileMode           ProfileMode        @default(FRESHER)
  availabilityStatus    AvailabilityStatus @default(IMMEDIATE)
  noticePeriodDays      Int?
  totalExperienceMonths Int                @default(0)
  currentCtc            Decimal?           @db.Decimal(12, 2)
  expectedCtcMin        Decimal?           @db.Decimal(12, 2)
  expectedCtcMax        Decimal?           @db.Decimal(12, 2)
  ctcCurrency           String             @default("INR")
  resumeUrl             String?
  portfolioUrl          String?
  linkedinUrl           String?
  githubUrl             String?
  twitterUrl            String?
  websiteUrl            String?
  languagesSpoken       String[]           @default([])
  /// Design-thinking #5 — Skill-trade pairing.
  /// Free-form list of skills the candidate is actively trying to
  /// LEARN (vs the validated skills on CandidateSkill). Used to pair
  /// candidates with complementary teach/learn axes — "Sahil knows
  /// battery, learning motor; Priya knows motor, learning battery →
  /// suggest a knowledge swap". Stored as a string array (free
  /// strings, not skill IDs) because what someone wants to learn is
  /// often vaguer than their resume claims ("EV powertrain", "rust"
  /// — not necessarily in our canonical taxonomy yet).
  learningSkills        String[]           @default([])
  cvVisibility          CVVisibility       @default(EVERYONE)
  // ContactVisibility gates email + phone display on every public surface
  // (profile page, mentor page, search result hover). PRIVATE is the
  // default so a fresh signup never leaks contact info accidentally.
  // EMPLOYERS_ONLY is the LinkedIn pattern: verified employers can see
  // contact for cold-outreach within rate limits; everyone else cannot.
  contactVisibility     ContactVisibility  @default(PRIVATE)
  // ResumeVisibility gates the resume download (and CV-card surfacing)
  // independent of profile visibility. A user might keep their profile
  // public but hide the resume until applying to specific jobs.
  resumeVisibility      ResumeVisibility   @default(PRIVATE)
  openToWork            Boolean            @default(true)
  /// LinkedIn-style "#Hiring" frame for users who are recruiting (founders,
  /// hiring managers, agency recruiters). Mutually exclusive with
  /// `openToWork` at the editor + server-action level — both can't be true
  /// at once. The Avatar component renders a teal ring + "#Hiring" chip
  /// when this is on, mirroring the green ring + "#OpenToWork" chip flow.
  hiringNow             Boolean            @default(false)
  /// Free-text custom CTA chip rendered next to the name on the public
  /// profile (e.g. "Available for freelance", "Open to relocate",
  /// "Fundraising"). 160 chars cap; null hides the chip entirely.
  customCta             String?

  // AI-drafted resume — refreshed by the resume-draft worker whenever the
  // candidate edits experience/education/skills/headline/summary. The user
  // can flip `useAiResume` off in profile settings to surface their own
  // uploaded `resumeUrl` instead. Both are stored; the visibility gate
  // determines who can download whichever is active.
  aiResumeUrl         String?
  aiResumeGeneratedAt DateTime?
  useAiResume         Boolean   @default(true)

  // DIYguru verification
  isDIYguruVerified Boolean   @default(false)
  diyguruStudentId  String?
  diyguruVerifiedAt DateTime?
  labExposureTags   String[]  @default([])
  capstoneProject   Json?

  // ─── Twitter-style ID verification ────────────────────────
  // Distinct from email/phone/employer/diyguru verification. This is
  // the platform-issued "verified person" badge: the candidate uploads
  // an Aadhar (or other government ID) image, an admin reviews it, and
  // on approval the public profile + post cards render a blue
  // checkmark next to the name. Status flow:
  //
  //   NONE          — never submitted
  //   PENDING       — Aadhar uploaded, awaiting admin review
  //   VERIFIED      — admin approved (with or without ID document — admin
  //                   can bypass the upload for trusted users)
  //   REJECTED      — admin rejected; candidate can re-submit
  //
  // We deliberately don't store the raw Aadhar number — only the
  // uploaded image URL (MinIO). Admin reviews the image, then either
  // approves or rejects without recording the number anywhere. After
  // approval we surface the verification but never the underlying
  // document.
  idVerificationStatus       IDVerificationStatus @default(NONE)
  idVerificationDocUrl       String?
  idVerificationSubmittedAt  DateTime?
  idVerificationReviewedAt   DateTime?
  idVerificationReviewedById String?
  idVerificationReviewedBy   User?                @relation("IDVerificationReviewer", fields: [idVerificationReviewedById], references: [id])
  idVerificationNotes        String?              @db.Text

  // Optional Cohort link. A "primary cohort" — the course/batch this
  // candidate graduated from. Set when an admin or TPO claims a roster
  // entry against the candidate. Drives the TPO dashboard's per-cohort
  // funnel + placement-rate breakdown.
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  // Onboarding & parsing state
  onboardingCompletedAt DateTime?
  resumeParsedAt        DateTime?
  resumeParseDraft      Json?

  // Profile-completeness — denormalised %0..100, recomputed on every
  // profile-edit server action so we can filter, sort, and gate apply
  // without scanning every profile relation. Two thresholds drive product
  // gates: 50% unlocks feed/jobs browsing, 90% unlocks job applications.
  // The breakdown of which sections are filled lives in
  // `lib/profile-completeness.ts` so the gauge UI can show "+8% if you
  // add 1 experience" hints without re-querying.
  profileCompleteness Int @default(0)

  // Social graph (LinkedIn-style)
  personType          PersonType @default(PROFESSIONAL)
  pronouns            String?
  // For STUDENT / FACULTY / TPO: link to college / institution
  institution         String?
  graduationYear      Int?
  // For COMPANY_REP: link to a company they represent
  representsCompanyId String?
  representsCompany   Company?   @relation("CompanyRep", fields: [representsCompanyId], references: [id])
  // Counters (denormalised for cheap reads — kept fresh on mutations)
  connectionsCount    Int        @default(0)
  followersCount      Int        @default(0)
  followingCount      Int        @default(0)
  postsCount          Int        @default(0)

  // AI / search
  profileEmbedding Unsupported("vector(3072)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evDomains              CandidateEVDomain[]
  skills                 CandidateSkill[]
  experiences            Experience[]
  education              Education[]
  certifications         Certification[]
  projects               Project[]
  awards                 Award[]
  volunteerExperiences   VolunteerExperience[]
  applications           Application[]
  savedJobs              SavedJob[]
  savedByEmployers       SavedCandidate[]
  /// Fair attendee registrations (separate from job applications).
  fairRegistrations      RecruitmentDriveRegistration[]
  /// Booth interview slots booked by this candidate.
  interviewSlotBookings  RecruitmentDriveInterviewSlot[] @relation("InterviewSlotCandidate")
  jobAlerts              JobAlert[]
  documents              CandidateDocument[]
  assessmentAttempts     AssessmentAttempt[]
  featuredSlots          FeaturedSlot[]
  jobMatchCache          JobMatchCache[]
  whyCandidateExplanations WhyCandidateExplanation[]
  jobChangeAnnouncements JobChangeAnnouncement[]

  /// Whether the platform should write a public JobChangeAnnouncement
  /// when this candidate's `current` employer flips. Defaults to false
  /// (opt-in) — same posture LinkedIn took before they made it the
  /// default. Toggleable from /me/preferences.
  announceJobChange Boolean @default(false)

  /// LinkedIn "Profile viewing options". Default VISIBLE — the
  /// reciprocal-visibility model (you see who views you only when
  /// viewers also share their identity) is the strongest behavioural
  /// loop on the LinkedIn network. Switching to ANONYMOUS makes the
  /// viewer invisible on viewed users' /me/views pages but ALSO
  /// hides the viewer's own list on /me/views — they trade
  /// the data both ways. Toggleable from /me/views.
  viewerVisibility ViewerVisibility @default(VISIBLE)

  // FTS — see Skill.searchTsv comment for the pattern.
  searchTsv Unsupported("tsvector")?

  // Wave C back-relations
  verifiedSkillBadges VerifiedSkillBadge[]
  callingSessions     CallingSession[]
  credentialsHeld     CandidateCredential[]
  // Wave A #10 — recruiter-search appearance tracker
  searchAppearances   ProfileSearchAppearance[]
  // Wave B #21 — outreach sequence enrollments
  outreachEnrollments OutreachEnrollment[]

  @@index([profileMode, availabilityStatus, openToWork])
  @@index([isDIYguruVerified])
}

model CandidateEVDomain {
  candidateId String
  evDomainId  String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evDomain    EVDomain         @relation(fields: [evDomainId], references: [id], onDelete: Cascade)

  @@id([candidateId, evDomainId])
}

model CandidateSkill {
  candidateId String
  skillId     String
  proficiency SkillProficiency @default(INTERMEDIATE)
  yearsExp    Float?
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  // LinkedIn-style peer endorsements. Anyone signed-in (and not the
  // owner) can toggle an endorsement on each of the candidate's
  // skills; counts surface on the public profile next to each skill.
  endorsements SkillEndorsement[]

  @@id([candidateId, skillId])
}

// Peer endorsement on a single skill. Composite-keyed by
// (candidateId, skillId, fromUserId) so each user can endorse any
// given skill at most once — toggling re-clicks delete the row.
// Joins back to CandidateSkill via the (candidateId, skillId) pair
// so cascading a skill removal cascades the endorsements with it.
model SkillEndorsement {
  candidateId String
  skillId     String
  fromUserId  String
  createdAt   DateTime @default(now())

  candidateSkill CandidateSkill @relation(fields: [candidateId, skillId], references: [candidateId, skillId], onDelete: Cascade)
  fromUser       User           @relation("SkillEndorser", fields: [fromUserId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId, fromUserId])
  @@index([candidateId, skillId])
  @@index([fromUserId])
}

model Experience {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // Always required as plain text — survives company deletion / unmapped
  // companies. Optional FK below upgrades the entry to a structured link
  // (logo, page, follow-able). LinkedIn does the same: free-text fallback
  // for jobs at companies not on the platform.
  company     String
  companyId   String?
  companyRef  Company?         @relation("ExperienceCompany", fields: [companyId], references: [id], onDelete: SetNull)
  title       String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  current     Boolean          @default(false)
  description String?          @db.Text
  createdAt   DateTime         @default(now())

  // ─── Verification ───────────────────────────────────────────
  // A Verified Company badge ("✓ Engineer at Ather") lights up when one
  // of three things proves the candidate actually worked here:
  //   • EMAIL_DOMAIN  — they verified an OTP sent to an email matching
  //                     Company.emailDomains.
  //   • RECRUITER_APPROVAL — a verified employer at the same company
  //                          approved the claim.
  //   • ADMIN          — manual override for legacy / edge cases.
  // Stamped on the Experience row directly (not a separate table) since
  // there's never more than one verification per row, and the audit
  // fields (`verifiedEmail`, `verifiedByUserId`) capture how it was earned.
  verifiedAt       DateTime?
  verifiedMethod   ExperienceVerifyMethod?
  verifiedEmail    String?
  verifiedByUserId String?
  verifiedBy       User?                   @relation("ExperienceVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([candidateId, verifiedAt])
}

enum ExperienceVerifyMethod {
  EMAIL_DOMAIN
  RECRUITER_APPROVAL
  ADMIN
}

model Education {
  id             String           @id @default(cuid())
  candidateId    String
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // Always required as plain text. Optional institutionId promotes the entry
  // to a structured link with logo + alumni listing. The user can opt out
  // and leave it as text only.
  institution    String
  institutionId  String?
  institutionRef Institution?     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  degree         String?
  field          String?
  startYear      Int?
  endYear        Int?
  grade          String?
  description    String?          @db.Text
  createdAt      DateTime         @default(now())

  @@index([institutionId])
}

model Certification {
  id              String             @id @default(cuid())
  candidateId     String
  candidate       CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name            String
  issuer          String?
  issueDate       DateTime?
  expiresAt       DateTime?
  credentialId    String?
  credentialUrl   String?
  isDIYguru       Boolean            @default(false)
  diyguruVerified Boolean            @default(false)
  documentId      String?
  document        CandidateDocument? @relation(fields: [documentId], references: [id])
  createdAt       DateTime           @default(now())
}

model Project {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  description String?          @db.Text
  url         String?
  techStack   String[]         @default([])
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime         @default(now())
}

model Award {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  issuer      String?
  date        DateTime?
  description String?          @db.Text
  createdAt   DateTime         @default(now())
}

// ─── Company / Employer ──────────────────────────────────────

enum CompanyType {
  OEM
  STARTUP
  TIER1
  TIER2
  BATTERY
  CHARGING
  FLEET
  CONSULTING
  OTHER
}

enum CompanyVerification {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// Twitter-style "verified person" status on a CandidateProfile. Flow
// is documented next to the field in CandidateProfile. NONE is the
// default; PENDING means an admin has work to do; VERIFIED renders
// the blue checkmark; REJECTED puts the candidate back to "unverified"
// with an optional reason exposed to them so they can fix and re-submit.
enum IDVerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

/// State machine for a recruiter's request to see a candidate's email
/// + phone. Documented next to the field on `ContactShareRequest`.
enum ContactShareStatus {
  PENDING /// Recruiter has asked; candidate hasn't responded.
  GRANTED /// Candidate approved; recruiter can see contact.
  DENIED /// Candidate refused. Recruiter can re-request only after a
  /// cool-off — enforced server-side in requestContactShare.
  REVOKED /// Candidate previously granted but later changed their mind.
  EXPIRED /// PENDING request that aged past `expiresAt`. Set by the
  /// notification-maintenance cleanup tick so stale rows
  /// stop counting against rate limits / dashboard counts.
}

/// Per-call OpenAI usage record. Written by `lib/ai/track-cost.ts` after
/// every chat-completion / embedding call so /admin/ai-ops can report
/// cost-per-feature, daily spend, and surface error rates by model. We
/// use micro-USD (USD × 10^6) so we don't lose precision summing many
/// sub-cent calls; the dashboard divides back out for display.
model AICostLog {
  id               String   @id @default(cuid())
  /// Logical bucket — "resume-parse", "embedding-candidate",
  /// "embedding-job", "jd-assist", "rerank", "roast", "resume-draft".
  /// Free string so adding a new feature doesn't need a migration.
  feature          String
  /// OpenAI model name as called (e.g. "gpt-4o-mini",
  /// "text-embedding-3-large"). Lets us spot a cost spike when we
  /// upgrade a model without changing call patterns.
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  /// Cost in micro-USD (10^-6 dollars). 1234567 = $1.234567.
  costUsdMicros    Int      @default(0)
  /// Optional context for drill-down: which candidate's resume,
  /// which job's JD, etc.
  entityType       String?
  entityId         String?
  durationMs       Int?
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([feature, createdAt])
  @@index([createdAt])
}

enum CompanyTeamRole {
  ADMIN
  RECRUITER
  HIRING_MANAGER
  VIEWER
}

model Company {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  ownerUserId        String
  owner              User                @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  logoUrl            String?
  bannerUrl          String?
  website            String?
  description        String?             @db.Text
  about              String?             @db.Text
  companyType        CompanyType         @default(OTHER)
  teamSize           String?
  hqLocation         String?
  /// HQ country — the company's "home market" dimension. Drives
  /// the country directory at /companies?country=XX, the routing
  /// of its company page in per-country sitemap shards, and the
  /// default country filter when a recruiter from this company
  /// posts a new job. Independent of `hqLocation` (free-text
  /// "Bengaluru, India" string) so analytics can group cleanly.
  hqCountry          Country         @default(IN)
  /// Additional countries this company OPERATES in (beyond
  /// `hqCountry`). True multi-region support — JLR is HQ'd in
  /// GB but has a major India operation (Tata-owned design centre
  /// in Pune); Tesla is HQ'd in US but operates in AU, GB; Bee'ah
  /// is AE-HQ but partners across the Gulf. A company appears in
  /// `/[cc]/companies` when EITHER `hqCountry === cc` OR
  /// `operatesInCountries.contains(cc)`. JSON-LD `areaServed`
  /// renders as a list when this array is non-empty.
  ///
  /// Empty by default — every existing company stays single-
  /// country (the IN HQ default) until an admin explicitly flips
  /// it via /admin/companies. Doesn't include the HQ — that's
  /// always-implicit; the array is for ADDITIONAL markets only,
  /// so the union (hqCountry ∪ operatesInCountries) is the full
  /// "where do they operate" set.
  operatesInCountries Country[]     @default([])
  foundedYear        Int?
  evDomains          String[]            @default([])
  techStack          String[]            @default([])
  benefits           String[]            @default([])
  galleryUrls        String[]            @default([])
  linkedinUrl        String?
  twitterUrl         String?
  facebookUrl        String?
  // Email-domain allowlist for the "Verified Company" badge flow.
  // When a candidate verifies an OTP sent to e.g. anita@ather.com and
  // ather.com is in this list, every Experience row of theirs that has
  // companyId = this company's id auto-stamps as verified. Multiple
  // domains are supported because companies use ather.com / atherenergy.com /
  // ather.co etc. interchangeably.
  emailDomains       String[]            @default([])
  verificationStatus CompanyVerification @default(UNVERIFIED)
  // Free-text reason captured when an admin flips status to REJECTED.
  // Surfaced in the email sent to the owner and on the admin's view of
  // the company so the moderation history is auditable. Cleared when
  // the status flips back to UNVERIFIED / VERIFIED.
  rejectionReason    String?             @db.Text
  rejectionAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  team                 EmployerProfile[]
  invites              TeamInvite[]
  jobs                 JobPosting[]
  customStages         CustomPipelineStage[]
  slaConfigs           SLAConfig[]
  webhooks             Webhook[]
  apiKeys              ApiKey[]
  campusDrives         CampusDrive[]
  salarySubmissions    SalarySubmission[]    @relation("SalaryCompany")
  // Inverse of WebhookEvent.companyId + Subscription.companyId —
  // outbound webhook log + (future) billing subscriptions for this
  // company.
  webhookEvents        WebhookEvent[]
  companySubscriptions Subscription[]        @relation("SubscriptionCompany")
  // Social: people who represent this company (founders / PMs)
  reps                 CandidateProfile[]    @relation("CompanyRep")
  // One-way follows on the company page
  followedBy           Follow[]              @relation("FolloweeCompany")
  // Posts published as this company
  postsAsCompany       Post[]                @relation("PostAsCompany")
  followersCount       Int                   @default(0)

  // Competitions hosted by this company
  competitions Competition[] @relation("CompanyCompetitions")

  // Candidate-experience entries that link to this company (LinkedIn-style
  // "X people work here" surfacing on the company page)
  experienceLinks Experience[] @relation("ExperienceCompany")

  // Events & webinars hosted by this company
  events Event[]

  // Job-change announcements landing at this company (Who's Moving feed).
  // Inverse of JobChangeAnnouncement.toCompanyRef.
  incomingHires                  JobChangeAnnouncement[]   @relation("JobChangeToCompany")
  // Recruitment-drive (job fair) participation.
  recruitmentDriveParticipations RecruitmentDriveCompany[] @relation("RecruitmentDriveCompany")
  recruitmentDriveJobs           RecruitmentDriveJob[]     @relation("RecruitmentDriveJobCompany")
  // "I work here, prove me admin" claim queue. Reviewed via /admin/claims.
  claims                         CompanyClaim[]            @relation("CompanyClaims")

  // FTS — see Skill.searchTsv for the rationale.
  searchTsv Unsupported("tsvector")?

  // WordPress legacy tracking
  wpLegacyId Int? @unique

  // Wave C back-relations
  /// Company-level tier facet (e.g. OEM vs Tier1 vs startup) — used as
  /// a first-class filter alongside the existing `companyType` enum.
  /// Nullable until the admin classifies a company; defaults to null
  /// rather than OTHER so the UI can show "not classified" instead of
  /// silently bucketing OEMs as "Other".
  companyTier CompanyTier?
  automations PipelineAutomation[]
  reviews     CompanyReview[]
  awards      EmployerAward[]

  // Wave B #21 — outreach cadences scoped to the company
  outreachCadences OutreachCadence[]

  /// Admin-review queue for web-fetched data (logos / about /
  /// LinkedIn / founded year etc.). See CompanyEnrichmentProposal.
  enrichmentProposals CompanyEnrichmentProposal[] @relation("CompanyEnrichmentProposals")

  @@index([verificationStatus])
  // Country directory — feeds /companies?country=XX listings.
  @@index([hqCountry])
}

model EmployerProfile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  designation    String?
  teamRole       CompanyTeamRole @default(RECRUITER)
  isCompanyAdmin Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([companyId])
}

model TeamInvite {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        CompanyTeamRole @default(RECRUITER)
  token       String          @unique
  invitedById String
  invitedBy   User            @relation("TeamInviteInviter", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@unique([companyId, email])
  @@index([token])
}

// ─── Jobs ────────────────────────────────────────────────────

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  PAUSED
  CLOSED
}

/// Who can see + apply to this job. The default `PUBLIC` is the regular
/// open posting. `DIYGURU_ONLY` hides the listing from non-DIYguru-
/// verified candidates and blocks `applyToJob` server-side for them —
/// this is the channel emobility.careers uses to route the 8-10 daily
/// employer requirements exclusively to DIYguru students. `INVITE_ONLY`
/// is a future hook for jobs that recruiters share via direct invite
/// only (no public browse, no apply unless invited).
enum JobAudience {
  PUBLIC
  DIYGURU_ONLY
  INVITE_ONLY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

/// Period the salary range is quoted against. Internships /
/// part-time gigs are typically quoted MONTHLY (a stipend), full-
/// time roles are typically YEARLY. Defaulting to YEARLY preserves
/// the meaning of every row that existed before this column was
/// added (which was implicitly annual).
enum SalaryPeriod {
  YEARLY
  MONTHLY
}

enum SeniorityLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
}

model JobPosting {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  companyId            String
  company              Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedById           String
  postedBy             User           @relation("JobPoster", fields: [postedById], references: [id])
  title                String
  description          String         @db.Text
  responsibilities     String?        @db.Text
  requirements         String?        @db.Text
  benefits             String?        @db.Text
  /// Design-thinking #2 — Structured application narrative.
  /// Up to 3 recruiter-defined questions asked of every applicant at
  /// apply time. Shape: `[{ id: string, prompt: string, required?: bool }]`.
  /// Null when the recruiter didn't define any (most jobs at first).
  /// The point: replace "tell us why you're interested" (low-signal)
  /// with role-specific prompts like "describe a project where you
  /// implemented OCPP 1.6 in 2-3 lines" (high-signal). Answers land
  /// on `Application.questionAnswers` for ATS-side comparison.
  applicationQuestions Json?
  profileMode          ProfileMode    @default(EXPERIENCED)
  employmentType       EmploymentType @default(FULL_TIME)
  workMode             WorkMode       @default(ONSITE)
  seniorityLevel       SeniorityLevel @default(MID)
  locations            String[]       @default([])
  /// Country dimension for filter / routing / SEO. Independent of
  /// `locations` (which is free-text city list) and `salaryCurrency`
  /// (which is the recruiter's display unit, may diverge from
  /// country for multinational pay bands quoted in USD).
  country              Country        @default(IN)
  experienceMin        Int?
  experienceMax        Int?
  salaryMin            Decimal?       @db.Decimal(12, 2)
  salaryMax            Decimal?       @db.Decimal(12, 2)
  salaryCurrency       String         @default("INR")
  /// Canonical USD-equivalent salary midpoint. Computed from
  /// (salaryMin + salaryMax) / 2 converted via ExchangeRate. Lets us
  /// rank/compare/filter jobs across countries without re-converting
  /// on every query. Worker recomputes on salary edit or daily FX
  /// refresh. Nullable for legacy rows + jobs with salary hidden.
  salaryUsdCanonical   Float?
  /// Cross-border hiring toggle — when true, this job appears in
  /// `?relocation=true` queries from OTHER countries and carries a
  /// "🌍 Open to relocation" badge in the listing UI. The job's
  /// primary `country` still attributes it to its home market for
  /// hreflang + sitemap + GSC purposes; this is the opt-in signal
  /// that says "I'll consider candidates from anywhere." Default
  /// false — every existing job is single-country until the
  /// recruiter explicitly broadens it. Pairs with the "Open to
  /// work" candidate-side toggle for symmetric cross-border supply
  /// + demand discovery.
  openToRelocation     Boolean        @default(false)
  // Period the salary band is quoted against. YEARLY is the
  // overwhelming majority case (full-time roles). MONTHLY lets
  // recruiters post internships / contract stipends naturally —
  // "₹10,000/month" is how candidates think about a stipend, not
  // "₹120,000/year". Existing rows pre-migration default to YEARLY,
  // preserving their original meaning.
  salaryPeriod         SalaryPeriod   @default(YEARLY)
  // Salary disclosure rule: `salaryHidden` is opt-in by default for
  // PUBLIC jobs. For DIYGURU_ONLY jobs the createJob/updateJob server
  // actions force this to `false` regardless of what the form sends —
  // students shouldn't apply blind.
  salaryHidden         Boolean        @default(false)
  // Visibility audience. PUBLIC = visible everywhere; DIYGURU_ONLY =
  // visible + applicable only to DIYguru-verified candidates; INVITE_ONLY
  // = no browse listing, only reachable via direct invite. Defaults to
  // PUBLIC so existing jobs round-trip cleanly through the migration.
  audience             JobAudience    @default(PUBLIC)
  status               JobStatus      @default(DRAFT)
  applicationUrl       String?
  applicationEmail     String?
  headerImageUrl       String?
  appliesCount         Int            @default(0)
  viewsCount           Int            @default(0)
  publishedAt          DateTime?
  closesAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  jdEmbedding Unsupported("vector(3072)")?

  evDomains            JobEVDomain[]
  skills               JobSkill[]
  applications         Application[]
  savedBy              SavedJob[]
  jobAlerts            JobAlert[]
  assessments          Assessment[]
  campusDrives         CampusDriveJob[]
  reports              JobReport[]
  matchCache           JobMatchCache[]
  whyCandidateExplanations WhyCandidateExplanation[]
  recruitmentDriveJobs RecruitmentDriveJob[]
  // Posts that attach this job to the social feed
  feedPosts            Post[]
  // Competitions linked to this job (winner-perk pipeline)
  competitionPerks     CompetitionPerk[]

  // Wave C — #29 facet axes for this job
  /// Powertrain area this role lives in — Battery / BMS / Motor /
  /// Charging / etc. Optional because non-engineering roles (sales,
  /// HR) don't have a powertrain area.
  powertrainArea PowertrainArea?
  /// Battery pack size (kWh) the role touches. Used as a numeric
  /// filter facet — "I want roles working with packs over 50 kWh".
  /// Null when irrelevant.
  packSizeKwh    Int?
  /// Charger output (kW) the role designs / installs. Same pattern as
  /// packSizeKwh — first-class numeric filter when set.
  chargerKw      Int?
  /// Pulled-down filter: "Diversity hire preferred" / "Veteran-friendly" /
  /// "Women-returner programme". Free text comma-list — small enough to
  /// stay strings rather than another join table.
  diversityTags  String[]        @default([])

  credentials      JobCredential[]
  hiringAssistant  HiringAssistantConfig?
  automations      PipelineAutomation[]
  callingSessions  CallingSession[]
  // Wave B #21 — outreach cadences scoped to this job
  outreachCadences OutreachCadence[]
  // Fair booth interview slots optionally pinned to this job.
  interviewSlots   RecruitmentDriveInterviewSlot[] @relation("InterviewSlotJob")

  // FTS — see Skill.searchTsv for the rationale.
  searchTsv Unsupported("tsvector")?

  // WordPress legacy tracking
  wpLegacyId Int? @unique

  @@index([status, publishedAt])
  @@index([companyId, status])
  @@index([profileMode, workMode])
  @@index([audience, status])
  // Country filter — drives the /jobs?country=AE / per-country
  // sitemap shards / hreflang alternates. Compound with `status`
  // because every country query also wants only OPEN listings.
  @@index([country, status])
}

model JobEVDomain {
  jobId      String
  evDomainId String
  job        JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evDomain   EVDomain   @relation(fields: [evDomainId], references: [id], onDelete: Cascade)

  @@id([jobId, evDomainId])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean    @default(true)
  weight   Float      @default(1.0)
  job      JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

// ─── Applications & ATS ──────────────────────────────────────

enum ApplicationStage {
  APPLIED
  SCREENED
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum ApplicationSource {
  DIRECT
  REFERRAL
  CAMPUS
  AI_INVITED
  IMPORT
}

model Application {
  id                String               @id @default(cuid())
  jobId             String
  job               JobPosting           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         CandidateProfile     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage             ApplicationStage     @default(APPLIED)
  customStageId     String?
  customStage       CustomPipelineStage? @relation(fields: [customStageId], references: [id])
  rating            Int?
  source            ApplicationSource    @default(DIRECT)
  coverLetter       String?              @db.Text
  resumeSnapshotUrl String?
  matchScore        Float?
  matchExplanation  Json?
  /// Design-thinking #2 — Structured application narrative.
  /// Candidate's answers to the job's `applicationQuestions` (asked at
  /// apply time). Shape: `{ [questionId]: string }`. Null when the
  /// candidate skipped them or the job has no questions defined.
  /// Recruiters see these side-by-side in the ATS so they can compare
  /// "did this candidate actually answer the OCPP question" across 200
  /// applicants without opening every detail page.
  questionAnswers   Json?
  /// Wave B #17 — AI-generated one-paragraph "why this candidate
  /// matches" summary, cached after first generation so the ATS
  /// card doesn't re-prompt OpenAI on every render. Null until the
  /// recruiter (or the daily worker) triggers a generation pass.
  /// Markdown-free plain text, 80-140 words target.
  aiSummary         String?              @db.Text
  /// When the summary was last generated. Recruiter can manually
  /// regenerate via a "Refresh" button after a stage change or once
  /// the candidate's profile shows meaningful new content.
  aiSummaryAt       DateTime?
  appliedAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  withdrawnAt       DateTime?
  rejectedReason    String?

  notes                ApplicationNote[]
  history              StageHistory[]
  interviews           Interview[]
  messageThread        MessageThread?
  assessmentAttempts   AssessmentAttempt[]
  slaBreaches          SLABreach[]
  // Contact-share requests filed from this application's ATS row.
  // Optional 1:N — a recruiter could re-request if a previous one
  // expired or was denied.
  contactShareRequests ContactShareRequest[]

  // Optional FK to a RecruitmentDrive — set when the candidate
  // applied via /fairs/[slug] flow. Enables per-fair applicant
  // queues + analytics for recruiters and admins. NULL on direct
  // /jobs/[slug] applies (the bulk of traffic).
  recruitmentDriveId String?
  recruitmentDrive   RecruitmentDrive? @relation(fields: [recruitmentDriveId], references: [id], onDelete: SetNull)

  // Wave C #16 — vernacular calling agent
  callingSessions     CallingSession[]
  // Wave B #21 — outreach sequence enrollments tied to this application
  outreachEnrollments OutreachEnrollment[]
  // Wave C #23 — audit trail of automation rule evaluations against
  // this application. Each evaluation (fired or no-op) logs one row.
  automationLogs      PipelineAutomationLog[]

  @@unique([jobId, candidateId])
  @@index([jobId, stage])
  @@index([candidateId, stage])
  @@index([recruitmentDriveId, stage])
}

enum NoteVisibility {
  TEAM
  PRIVATE
}

model ApplicationNote {
  id            String         @id @default(cuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  body          String         @db.Text
  visibility    NoteVisibility @default(TEAM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model StageHistory {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  byUserId      String?
  byUser        User?             @relation("StageActor", fields: [byUserId], references: [id])
  reason        String?
  meta          Json?
  at            DateTime          @default(now())

  @@index([applicationId, at])
}

// Enterprise feature: company-defined ATS pipeline stages
model CustomPipelineStage {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  order              Int
  color              String?
  autoRejectionRules Json?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  applications Application[]
  slaConfigs   SLAConfig[]

  @@unique([companyId, name])
  @@index([companyId, order])
}

model SLAConfig {
  id               String              @id @default(cuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stageId          String
  stage            CustomPipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  slaHours         Int
  escalationAction Json?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
}

model SLABreach {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId       String
  breachedAt    DateTime    @default(now())
  notified      Boolean     @default(false)
}

// ─── Interviews ─────────────────────────────────────────────

enum InterviewMode {
  VIDEO
  PHONE
  ONSITE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model Interview {
  id                       String          @id @default(cuid())
  applicationId            String
  application              Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledAt              DateTime
  durationMins             Int             @default(45)
  mode                     InterviewMode   @default(VIDEO)
  location                 String?
  meetingUrl               String?
  interviewerIds           String[]        @default([])
  status                   InterviewStatus @default(SCHEDULED)
  feedback                 String?         @db.Text
  rating                   Int?
  googleEventId            String?
  icsUid                   String?         @unique
  // Reminder fanout markers — set by the interview-reminders cron when the
  // candidate has been pinged 24h or 1h before the slot.
  reminderDayBeforeSentAt  DateTime?
  reminderHourBeforeSentAt DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([applicationId, scheduledAt])
  @@index([status, scheduledAt])
}

// ─── Assessments ────────────────────────────────────────────

enum AssessmentType {
  MCQ
  CODING
  SKILL_TASK
  VIDEO_RESPONSE
}

model Assessment {
  id           String         @id @default(cuid())
  jobId        String?
  job          JobPosting?    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title        String
  type         AssessmentType
  questions    Json
  passingScore Float          @default(60)
  durationMins Int?
  isLibrary    Boolean        @default(false)
  // Pre-placement gate. When true on at least one assessment for a job,
  // the ATS blocks any forward stage transition (INTERVIEW / OFFER /
  // HIRED) until the candidate has an AssessmentAttempt with
  // `score >= passingScore` for that assessment. See
  // server/ats/actions.ts → moveStage for enforcement.
  gateAdvance  Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  attempts             AssessmentAttempt[]
  // Inverse of RecruitmentDriveJob.challengeAssessment — same
  // assessment can be reused as the challenge across multiple
  // fairs / drive-jobs without duplicating questions JSON.
  recruitmentDriveJobs RecruitmentDriveJob[] @relation("RecruitmentDriveJobChallenge")
  // Wave C #28 — sidecar carrying EV-skill library metadata. Optional
  // because most Assessment rows are job-scoped MCQs without
  // skill-library framing.
  skillMeta            SkillAssessmentMeta?

  @@index([jobId])
}

model AssessmentAttempt {
  id            String           @id @default(cuid())
  assessmentId  String
  assessment    Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?     @relation(fields: [applicationId], references: [id])
  startedAt     DateTime         @default(now())
  submittedAt   DateTime?
  score         Float?
  passed        Boolean?
  answers       Json?
  proctorMeta   Json?

  // Wave B #28 back-relation — the badge this attempt earned (when it
  // passed at or above the SkillAssessmentMeta.badgeThreshold).
  badge VerifiedSkillBadge? @relation("BadgeSourceAttempt")

  @@index([candidateId])
  @@index([assessmentId])
}

// ─── Messaging ──────────────────────────────────────────────

model MessageThread {
  id              String       @id @default(cuid())
  applicationId   String?      @unique
  application     Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // For cold outreach (no application yet)
  candidateUserId String?
  employerUserId  String?
  /// Free-form label identifying who/what created this thread. Null
  /// for the historical default (recruiter-initiated cold outreach
  /// + application-derived threads). Set to one of:
  ///   "MUTUAL_INTEREST" — both sides saved each other (#1)
  ///   "WARM_INTRO"      — alum-mediated request (#3)
  ///   "SKILL_TRADE"     — complementary-skills pairing (#5)
  ///   "HIRING_ASST"     — drafted by the AI hiring assistant
  /// Lets the UI add context badges ("This thread started because you
  /// both saved each other") without inferring from message content.
  source          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  lastMessageAt   DateTime?

  messages Message[]

  @@index([candidateUserId, employerUserId])
  @@index([lastMessageAt])
}

model Message {
  id          String        @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("MessageSender", fields: [senderId], references: [id])
  body        String        @db.Text
  attachments Json?
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([threadId, createdAt])
}

// ─── Notifications ──────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // The User whose action triggered this notification (commenter,
  // reactor, follower, recruiter who moved a stage). Nullable for
  // system-driven events (job alerts, kyc results) that don't have a
  // single human actor. Powers avatar rendering in the inbox + bell.
  actorId   String?
  actor     User?               @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  title     String
  body      String              @db.Text
  payload   Json?
  channel   NotificationChannel @default(IN_APP)
  link      String?
  readAt    DateTime?
  sentAt    DateTime?
  // Used to collapse repeats — e.g., 5 reactions on the same post
  // reuse the same `groupKey: "social.reaction:<postId>"` so a
  // future grouping pass can render "5 people reacted to your post".
  // Today the worker still writes one row per event; this column is
  // populated for forward compatibility.
  groupKey  String?
  // Auto-pruning marker. The cleanup worker deletes rows whose
  // `expiresAt < now()`. Defaults to 90 days from createdAt — set
  // by the worker when the row is written (see workers/processors/
  // notifications.ts), not at the schema layer.
  expiresAt DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, groupKey])
  @@index([expiresAt])
}

model NotificationPreference {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Per-event channel toggles. Default is conservative (in-app + email; SMS off).
  applicationUpdatesEmail Boolean  @default(true)
  applicationUpdatesSMS   Boolean  @default(false)
  messagesEmail           Boolean  @default(true)
  messagesSMS             Boolean  @default(false)
  interviewsEmail         Boolean  @default(true)
  interviewsSMS           Boolean  @default(true)
  jobAlertsEmail          Boolean  @default(true)
  jobAlertsSMS            Boolean  @default(false)
  marketingEmail          Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

// ─── Saved items & alerts ───────────────────────────────────

model SavedJob {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         JobPosting       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  @@unique([candidateId, jobId])
}

model SavedCandidate {
  id             String           @id @default(cuid())
  candidateId    String
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  employerUserId String
  note           String?
  createdAt      DateTime         @default(now())

  @@unique([candidateId, employerUserId])
}

model JobAlert {
  id          String                @id @default(cuid())
  candidateId String
  candidate   CandidateProfile      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  query       String
  filters     Json
  jobId       String?
  job         JobPosting?           @relation(fields: [jobId], references: [id])
  frequency   String                @default("daily")
  channels    NotificationChannel[]
  isActive    Boolean               @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime              @default(now())
}

// ─── DIYguru integration ────────────────────────────────────

model DIYguruImportBatch {
  id           String   @id @default(cuid())
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  fileUrl      String?
  rowCount     Int
  matchedCount Int      @default(0)
  importedAt   DateTime @default(now())
  notes        String?

  rosterEntries DIYguruRoster[]
}

model DIYguruRoster {
  id              String             @id @default(cuid())
  importBatchId   String
  importBatch     DIYguruImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  studentId       String?
  email           String
  fullName        String
  phone           String?
  courseName      String?
  courseSlug      String?
  completionDate  DateTime?
  grade           String?
  labTags         String[]           @default([])
  capstoneTitle   String?
  claimedByUserId String?
  claimedAt       DateTime?
  createdAt       DateTime           @default(now())

  // First-class cohort link — see model Cohort below. Optional because
  // legacy roster rows imported before cohorts existed should still
  // round-trip; new uploads always attach a cohort at admin-time.
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([importBatchId, email])
  @@index([email])
  @@index([studentId])
  @@index([cohortId])
}

/// WhatsApp daily digest subscription — "5 fresh EV jobs delivered to
/// phones, not inboxes". The country runs on WhatsApp; daily emails are
/// dead in Tier 2/3. The flow:
///
///   1. Visitor enters phone + filters at /digest. We create a row with
///      status=PENDING and send a confirmation message via WA Cloud API.
///   2. On successful send we flip to ACTIVE (we trust the user owns the
///      number; unsubscribe is one tap from any digest message).
///   3. The whatsapp-digest worker ticks every morning, pulls 5 fresh
///      OPEN jobs matching each subscription's filters, sends via WA.
///   4. Send failures auto-PAUSE after 5 in a row so we don't burn
///      Cloud API credits on dead numbers.
enum WhatsAppSubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  UNSUBSCRIBED
}

model WhatsAppDigestSubscription {
  id                String                     @id @default(cuid())
  // E.164-normalised phone number — the unique key. Multiple users can
  // share a number (family device) so we don't link against User.phone.
  phone             String                     @unique
  // Optional link to a User account. Set when a signed-in user
  // subscribes; null when the subscriber came in via the public /digest
  // form anonymously.
  userId            String?
  user              User?                      @relation("DigestSubscriber", fields: [userId], references: [id], onDelete: SetNull)
  // Filter prefs — empty = all jobs.
  evDomainSlugs     String[]                   @default([])
  location          String?
  profileMode       ProfileMode?
  status            WhatsAppSubscriptionStatus @default(PENDING)
  confirmedAt       DateTime?
  // Last successful digest send + the URL-safe token used in the
  // unsubscribe link inside each message. We rotate this on every send
  // so a leaked link only unsubscribes the next batch.
  lastSentAt        DateTime?
  unsubscribeToken  String                     @unique
  // Auto-pause guardrail: count consecutive WA send failures. 5 strikes
  // and the worker flips status to PAUSED.
  failedSendsInARow Int                        @default(0)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, lastSentAt])
}

/// "Featured This Week" — five candidates spotlighted weekly on Pulse +
/// the home page. Curated by admins; gives candidates an aspirational
/// reason to fill their profile + a recruiter audience for the platform.
///
/// `weekStart` is the Monday of the week (00:00 IST). Slots are
/// `position` 1..5 — UI honours the order.
model FeaturedSlot {
  id              String           @id @default(cuid())
  candidateId     String
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  position        Int
  // Editorial copy — admin curates. Falls back to the candidate's
  // headline at render time.
  spotlightReason String?
  // Optional override image — used for promotional images / posters.
  imageUrl        String?
  featuredById    String?
  featuredBy      User?            @relation("FeaturedCurator", fields: [featuredById], references: [id], onDelete: SetNull)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  @@unique([weekStart, position])
  @@index([weekStart, isActive])
}

/// AI Resume Roast result — the no-signup viral hook. Anyone uploads a
/// resume, the AI scores it on EV-specific dimensions (battery exposure,
/// charging knowledge, motor & power electronics, software, etc.), and we
/// persist the score so the result URL is shareable as
/// /roast/[id]. Each row also gets an OG image at the same path so the
/// LinkedIn / WhatsApp unfurl shows the actual score, not a stock image.
///
/// Privacy: we never store the raw resume bytes — only the parsed text
/// hashes + the score. Roast records aren't tied to a User by default; an
/// `anonId` cookie lets returning users reach their previous roasts. When
/// a roaster signs up, we link the row via `claimedByUserId`.
model ResumeRoast {
  id              String   @id @default(cuid())
  // Anonymous browser cookie ID — lets a visitor see "your past roasts"
  // before they sign up. Optional because some roasts are admin-tools.
  anonId          String?
  // Once the visitor signs up, link the roast to them so it shows on
  // /me/profile as "your most recent roast" with a fix-it CTA.
  claimedByUserId String?
  // 0..100 overall — the headline number on the share card.
  scoreOverall    Int
  // Per-domain breakdown (battery / charging / motors / software /
  // experience / clarity). JSON because the rubric may evolve.
  scoreBreakdown  Json
  // 3-5 specific actionable items, structured as { title, body, severity }.
  feedback        Json
  // The resume text length in chars — used as a sanity signal in the
  // admin moderation view; never the raw text itself.
  textLength      Int
  // IP at time of roast — abuse triage only. Auto-purge after 30 days.
  ip              String?
  createdAt       DateTime @default(now())

  @@index([anonId])
  @@index([claimedByUserId])
  @@index([createdAt])
}

/// A *cohort* is a named DIYguru course-batch — e.g. "EV Powertrain Mar 2025".
/// Lets the TPO dashboard slice placement metrics by group, and lets students
/// filter by their batch on their public profile.
///
/// DIYguruRoster.cohortId is optional + set when an admin imports a CSV (or
/// backfilled later). CandidateProfile.cohortId is copied forward when a
/// roster entry is claimed, so candidate-by-cohort queries don't need a
/// join through DIYguruRoster.
///
/// Status governs the TPO dashboard's filter: ACTIVE = currently placing,
/// ARCHIVED = wrapped up, hidden by default.
enum CohortStatus {
  ACTIVE
  ARCHIVED
}

model Cohort {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String // "EV Powertrain — Mar 2025"
  courseName  String // "EV Powertrain"
  courseSlug  String? // "ev-powertrain"
  // ISO-8601 batch identifier, e.g. "2025-03". Helps sort + group.
  batchCode   String?
  startDate   DateTime?
  endDate     DateTime?
  // Free-text owner — for v1, the institution can be a string ("DIYguru
  // Pune Lab"). Later we may relate this to the `Institution` table.
  institution String?
  description String?      @db.Text
  // Expected total seats / actual graduates — used by the TPO dashboard
  // to show a "claimed %" against the roster.
  capacity    Int?
  status      CohortStatus @default(ACTIVE)
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  rosterEntries DIYguruRoster[]
  candidates    CandidateProfile[]

  @@index([status, courseSlug])
  @@index([batchCode])
}

// ─── KYC / verification ─────────────────────────────────────

enum DocumentType {
  CERTIFICATE
  DEGREE
  EXPERIENCE_LETTER
  ID_PROOF
  OFFER_LETTER
  OTHER
}

model CandidateDocument {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  docType     DocumentType
  fileUrl     String
  fileName    String
  fileSize    Int?
  mimeType    String?
  isShared    Boolean          @default(false)
  sharedWith  Json?
  verified    Boolean          @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime         @default(now())

  certifications       Certification[]
  verificationRequests VerificationRequest[]
}

enum VerificationEntity {
  CANDIDATE
  COMPANY
}

enum VerificationRequestType {
  ID_VERIFICATION
  KYC
  CERTIFICATION
  COMPANY_KYC
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model VerificationRequest {
  id            String                  @id @default(cuid())
  entityType    VerificationEntity
  entityId      String
  requestType   VerificationRequestType
  documentId    String?
  document      CandidateDocument?      @relation(fields: [documentId], references: [id])
  idType        String?
  idNumberHash  String?
  status        VerificationStatus      @default(PENDING)
  reviewerId    String?
  reviewer      User?                   @relation("VerificationReviewer", fields: [reviewerId], references: [id])
  reviewerNotes String?                 @db.Text
  createdAt     DateTime                @default(now())
  reviewedAt    DateTime?

  @@index([entityType, entityId, status])
  @@index([status])
}

// ─── Institutions (schools, colleges, universities) ─────────
//
// Companion to `Company` for the academic side. Candidates can attach an
// Education entry to a known Institution (Education.institutionId), which
// upgrades the entry to a structured link with logo + alumni listing on
// the institution page. If the institution isn't on the platform yet,
// candidates can create a new one inline — admin reviews/dedupes later
// (similar to Company verification flow).
//
// Why a separate model from Company? Different shape (board / affiliation /
// established year / program count), different discoverability surface
// (alumni vs employees), different KYC reviewer (academic admin not company
// admin).

enum InstitutionType {
  UNIVERSITY
  COLLEGE
  SCHOOL // K-12
  ITI // Industrial Training Institute (India)
  POLYTECHNIC
  RESEARCH_INSTITUTE
  TRAINING_CENTER
  OTHER
}

enum InstitutionVerification {
  UNVERIFIED // user-created, awaiting admin review
  PENDING // admin review in progress
  VERIFIED // confirmed by admin
  REJECTED // duplicate or fake — hidden from search
}

model Institution {
  id                 String                  @id @default(cuid())
  slug               String                  @unique
  name               String
  type               InstitutionType         @default(COLLEGE)
  shortName          String? // common abbreviation (e.g. "IIT Delhi")
  city               String?
  state              String?
  country            String                  @default("IN")
  website            String?
  logoUrl            String?
  bannerUrl          String?
  about              String?                 @db.Text
  foundedYear        Int?
  affiliation        String? // affiliating university / accreditation board
  // The user who first added this institution (when self-served). Helps
  // admin trace user-created entries during review.
  createdById        String?
  verificationStatus InstitutionVerification @default(UNVERIFIED)
  verifiedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // ─── EV-industry ranking ──────────────────────────────────
  //
  // Editorial / admin-curated scores across seven pillars that power
  // /institutions/rankings. Each is 0-100 (NULL = "not yet scored",
  // institution is excluded from the ranked list but still
  // discoverable via /institutions search). Scores are not derived
  // from on-platform behaviour — they reflect the institution's
  // standing as an EV-industry talent producer based on published
  // research, faculty, placement, lab infrastructure, content
  // alignment with AICTE/NSDC standards, alumni in EV roles, and EV
  // startups incubated. See scripts/seed-institution-rankings.ts for
  // the canonical scoring rubric and per-institution rationale.
  evScoreResearch       Int? // R&D output: papers, patents, lab capacity
  evScoreFaculty        Int? // faculty depth + industry experience
  evScorePlacement      Int? // EV-industry placement rate + recruiters
  evScoreInfrastructure Int? // labs, EVs, charging infra on campus
  evScoreContent        Int? // curriculum depth + AICTE/NSDC alignment
  evScoreAlumni         Int? // alumni in EV roles + leadership presence
  evScoreStartups       Int? // EV startups incubated + founder pipeline

  // Composite overall — average of the 7 pillars, persisted so the
  // /rankings page can sort + paginate without recomputing per
  // request. Recomputed by the seed script whenever pillar scores
  // change.
  evScoreOverall Int?

  // Explicit ranks. Lower = better, 1-indexed, NULL for unranked.
  // Set by the seed script in two passes: provisional rank from
  // evScoreOverall, then hard overrides for editorial pins (eg.
  // eMobility Academy by DIYguru = #1 IN, #2 global). Persisting the
  // resolved rank avoids surfacing different orderings under churn.
  evRankIndia  Int?
  evRankGlobal Int?

  // Short editorial blurb explaining why this institution earns its
  // rank — surfaced inline on the rankings page so the ordering reads
  // as deliberate, not opaque. Plain text, ≤500 chars.
  evRankingNote String? @db.Text

  // ─── Detailed enrichment data ────────────────────────────────
  //
  // Populated by scripts/seed-institution-enrichment.ts in batches
  // of ~100 institutions. Every field is optional — institutions
  // without enrichment data still render fine, the page just shows
  // fewer sections.
  //
  // JSON columns are used for nested arrays so we can iterate the
  // shape without a schema change for every tweak.

  /// Array of { name, focus, established?, headFaculty?, website? }
  researchCentres      Json?
  /// Array of { oem, type: "research"|"placement"|"curriculum"|"funding"|"internship", since?, projects? }
  oemCollaborations    Json?
  /// Array of { title, area, lead?, funding?, status? }
  ongoingResearch      Json?
  /// Array of { name, level: "UG"|"PG"|"PHD"|"CERTIFICATE"|"DIPLOMA", duration?, evFocus?, seats?, fees? }
  programsOffered      Json?
  /// Array of { name, currentRole, currentCompany, batch?, linkedin? }.
  /// Capped at ~10 per institution; the public page renders a card grid.
  notableAlumni        Json?
  /// JSON shape: { medianCtcLakhs?, placementRate?, highestCtcLakhs?,
  /// recruiterCount?, year? }. Lives behind the "Placement report"
  /// tab on /institutions/<slug>.
  placementStats       Json?
  /// Free-text top recruiter list. Surfaces as chips on the placement
  /// tab and feeds the institution's recruiter-cluster signal.
  topRecruiters        String[] @default([])
  /// Standard accreditation labels — "NAAC A+", "NBA accredited",
  /// "UGC", "AICTE", "AACSB" etc. Rendered as chips on the hero.
  accreditations       String[] @default([])
  /// Major lab / equipment names — "Battery formation lab",
  /// "Dynamometer test cell", "Anechoic EMC chamber". Rendered as a
  /// bullet list on the Research tab.
  facilities           String[] @default([])
  /// Broader non-OEM industry partnerships — utilities, government
  /// bodies, standards orgs, multilateral funders.
  industryPartnerships String[] @default([])
  /// Free-form long-form text rendered on the Research tab.
  researchOverview     String?  @db.Text
  /// Free-form long-form text on the Placement tab — narrative
  /// around hiring story, common career paths, programme-to-recruiter
  /// mappings.
  placementOverview    String?  @db.Text

  educationLinks   Education[]
  competitionTeams CompetitionRegistration[] @relation("CompetitionTeamInstitution")
  /// Self-served college placement-cell sign-ups (one per
  /// (institution, user) pair via the unique constraint on the
  /// child table). See `CollegePlacementCell`.
  placementCells   CollegePlacementCell[]
  reviews          InstitutionReview[]

  // FTS — see Skill.searchTsv for the rationale. Built across name +
  // shortName (tier A) + city/state (tier B) + about (tier C).
  searchTsv Unsupported("tsvector")?

  @@index([verificationStatus, name])
  @@index([type, city])
  @@index([evRankIndia])
  @@index([evRankGlobal])
  @@index([evScoreOverall])
}

// ─── College placement cell — self-served college sign-up ─────────
//
// The brochure's "150+ Hiring Partner Network + 400+ Institutional
// Partners" claim implies a college-side audience the platform
// didn't model. Today `User.isPlacementOfficer` is admin-grantable
// only, which means scaling college participation requires a DIYguru
// staffer to manually flip the flag for every new institution. This
// model gives college TPOs a self-serve sign-up flow that lands in
// an admin moderation queue.
//
// Flow:
//   1. TPO opens /colleges/register, picks (or creates) an
//      Institution, fills contact info → row created in PENDING.
//   2. Admin reviews at /admin/colleges → APPROVED flips
//      `User.isPlacementOfficer = true` so /tpo opens for them.
//   3. Approved TPO can bulk-import their college's batch into
//      any active fair via the existing roster CSV import flow
//      (gate widened from admin-only → admin OR approved TPO).
//
// Unique on (institutionId, createdById) so a TPO can't submit
// the same college twice; an admin can manually create extras if
// genuinely needed.

enum CollegePlacementCellStatus {
  PENDING // Awaiting admin review
  APPROVED // /tpo unlocked + can bulk-invite students to fairs
  REJECTED // Application turned down (with optional reason)
  REVOKED // Admin pulled access after approval (kept for audit)
}

model CollegePlacementCell {
  id            String                     @id @default(cuid())
  institutionId String
  institution   Institution                @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User                       @relation("PlacementCellCreator", fields: [createdById], references: [id], onDelete: Cascade)
  status        CollegePlacementCellStatus @default(PENDING)

  /// Self-declared contact details — visible to admins reviewing
  /// the application + later to recruiters who want to coordinate
  /// directly with a college that's sending students to their booth.
  contactName  String
  contactEmail String
  contactPhone String?
  designation  String? // "TPO Coordinator", "Director of Placement"
  studentCount Int? // Self-declared cohort size (helps admin gauge)
  /// Free-form note the TPO can include with their application —
  /// e.g. "We're aligned with the Pune edition + want to import 60
  /// of our B.Tech finals". Admin reads this when moderating.
  notes        String? @db.Text

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("PlacementCellReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Admin-entered reason for REJECTED status, surfaced back to
  /// the TPO so they know what to fix on a re-application.
  rejectionReason String?

  /// Stable, cryptographically-random token (24 chars) used as the
  /// suffix of the TPO's shareable student-invite URL:
  /// `/fairs/[slug]/register?as=candidate&tpo=<inviteToken>`.
  /// Generated when the placement cell is APPROVED. Persists across
  /// re-approval cycles so a previously-shared link keeps working
  /// even after a brief REVOKED → re-approved hop. Null while
  /// PENDING / REJECTED. Admin can rotate via a separate action if
  /// the link leaks.
  inviteToken String? @unique

  /// Candidates who self-registered via this TPO's invite link.
  /// Each registration carries the `viaTpoUserId` of the placement
  /// cell's `createdById`; the relation here is convenience for the
  /// TPO dashboard's "students from my link" query.
  referredRegistrations RecruitmentDriveRegistration[] @relation("RegistrationViaTpo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionId, createdById])
  @@index([status, createdAt])
  @@index([createdById])
  @@index([inviteToken])
}

// ─── Campus drives (DIYguru / college hiring) ───────────────

enum CampusDriveStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CampusCandidateStatus {
  REGISTERED
  SHORTLISTED
  ASSESSED
  INTERVIEWED
  OFFERED
  HIRED
  REJECTED
}

model CampusDrive {
  id             String            @id @default(cuid())
  // URL-safe identifier used by the public landing page at /campus/[slug].
  // Generated server-side from the title + company; unique across drives.
  slug           String?           @unique
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  title          String
  institution    String
  city           String?
  state          String?
  driveDate      DateTime
  driveEndDate   DateTime?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  // Free-form intro shown on the landing page hero. Markdown-friendly so
  // the host can paste pitch copy with paragraphs + lists.
  description    String?           @db.Text
  // Optional banner used as the landing-page hero — falls back to the
  // company logo on a hero gradient when null.
  bannerImageUrl String?
  maxCandidates  Int?
  status         CampusDriveStatus @default(DRAFT)
  // Auto-filled with `${APP_URL}/campus/${slug}` when slug is set; the
  // free-text fallback is preserved for legacy drives that already
  // pointed at an external Unstop / Naukri page.
  landingPageUrl String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  jobs       CampusDriveJob[]
  candidates CampusCandidate[]

  @@index([companyId, status])
}

model CampusDriveJob {
  driveId String
  jobId   String
  drive   CampusDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  job     JobPosting  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([driveId, jobId])
}

model CampusCandidate {
  id              String                @id @default(cuid())
  driveId         String
  drive           CampusDrive           @relation(fields: [driveId], references: [id], onDelete: Cascade)
  userId          String?
  name            String
  email           String
  phone           String?
  college         String?
  degree          String?
  yearOfPassing   Int?
  cgpa            Float?
  skills          String[]              @default([])
  resumeUrl       String?
  status          CampusCandidateStatus @default(REGISTERED)
  assessmentScore Float?
  notes           String?
  createdAt       DateTime              @default(now())

  @@index([driveId, status])
}

// ─── Salary intelligence ────────────────────────────────────

model SalaryBenchmark {
  id           String   @id @default(cuid())
  evDomainId   String
  evDomain     EVDomain @relation(fields: [evDomainId], references: [id])
  role         String
  location     String
  experience   String?
  minSalary    Decimal  @db.Decimal(12, 2)
  medianSalary Decimal  @db.Decimal(12, 2)
  maxSalary    Decimal  @db.Decimal(12, 2)
  currency     String   @default("INR")
  source       String?
  lastUpdated  DateTime @default(now())

  @@index([evDomainId, role, location])
}

/// Salary Compass — Levels.fyi for India's EV industry. Anonymous
/// crowd-sourced compensation submissions. The viral mechanic:
///   1. Visitor lands on /salaries, sees teaser data with locked details.
///   2. Submits one salary anonymously → unlocks the full database for
///      30 days (cookie-driven).
///   3. Submission is admin-moderated before going live (PENDING by default).
/// Aggregations only — never per-row display, never names.
enum SalarySubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model SalarySubmission {
  id                String                 @id @default(cuid())
  // Optional FK to Company. Free-text companyName is always required so
  // submissions for unlisted companies still aggregate.
  companyId         String?
  company           Company?               @relation("SalaryCompany", fields: [companyId], references: [id], onDelete: SetNull)
  companyName       String
  jobTitle          String
  evDomainId        String?
  evDomain          EVDomain?              @relation(fields: [evDomainId], references: [id], onDelete: SetNull)
  profileMode       ProfileMode            @default(EXPERIENCED)
  yearsExp          Int
  location          String?
  // Total CTC in lakhs (INR-default). Stored as Float (not Decimal)
  // because aggregation maths needs JS doubles and we never use these
  // for billing precision.
  ctcLakhs          Float
  // Optional split — base / bonus / esop in lakhs. Recruiters love this
  // breakdown; we ask but don't require it.
  baseLakhs         Float?
  bonusLakhs        Float?
  esopLakhs         Float?
  currency          String                 @default("INR")
  status            SalarySubmissionStatus @default(PENDING)
  // Anonymity: only set when the submitter explicitly opts in via the
  // "Tag this to my profile" toggle on the form. Default null.
  submittedByUserId String?
  // Anti-spam audit fields. Cookie ID lets us honour "one submission per
  // browser per day" without auth.
  ip                String?
  cookieId          String?
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime               @default(now())

  @@index([companyId, status])
  @@index([status, createdAt])
  @@index([cookieId])
}

// ─── Webhooks & API keys (enterprise) ───────────────────────

model Webhook {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url           String
  secret        String
  events        String[]
  isActive      Boolean   @default(true)
  retryCount    Int       @default(0)
  lastTriggered DateTime?
  lastStatus    Int?
  lastError     String?
  createdAt     DateTime  @default(now())

  logs WebhookLog[]
}

model WebhookLog {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  responseCode Int?
  responseBody String?  @db.Text
  durationMs   Int?
  attempt      Int      @default(1)
  status       String
  createdAt    DateTime @default(now())

  @@index([webhookId, createdAt])
}

model ApiKey {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String
  keyPrefix    String    @unique
  keyHash      String
  name         String
  permissions  Json
  rateLimit    Int       @default(60)
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  requestCount Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

// ─── Social graph (LinkedIn-style) ─────────────────────────

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  BLOCKED
}

/// A symmetric "1st-degree connection" once accepted.
/// Stored as a single row keyed by (requesterId, recipientId); we never
/// duplicate to keep the graph small and dedupe trivial.
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  recipientId String
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User             @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status      ConnectionStatus @default(PENDING)
  message     String?          @db.Text
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

/// Recruiter → candidate request to see contact (email + phone).
/// LinkedIn-style consent flow: even when contactVisibility is the
/// strict-but-pragmatic default, an employer who wants to reach a
/// candidate by email/phone has to ASK; the candidate has to GRANT.
///
/// Lifecycle:
///   PENDING  ── candidate clicks Approve ─→ GRANTED
///            ── candidate clicks Deny    ─→ DENIED
///            ── 30 days pass               ─→ EXPIRED (cleanup tick)
///   GRANTED  ── candidate clicks Revoke ─→ REVOKED
///
/// Multiple PENDING rows from the same recruiter to the same candidate
/// are blocked at the server-action layer (resubmit re-uses the row).
/// DENIED has a server-enforced cool-off (90 days) before another
/// PENDING from the same pair is allowed — stops harassment loops.
///
/// `applicationId` is optional context: when the request was sent
/// from an ATS row (recruiter reviewing applications), we record
/// which application triggered it so the candidate sees "Acme HR
/// asked for your contact about your application to {Job Title}"
/// in the inbox card.
model ContactShareRequest {
  id              String             @id @default(cuid())
  requesterUserId String
  requester       User               @relation("ContactShareRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  /// Always a candidate userId (i.e. CandidateProfile.userId). We
  /// don't bother adding a FK to CandidateProfile because the
  /// User → CandidateProfile relation is 1:1 and User is the more
  /// reliable join key (employer user → candidate user).
  targetUserId    String
  target          User               @relation("ContactShareTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  status          ContactShareStatus @default(PENDING)
  /// Free-text "why I want your contact" message from the recruiter.
  /// Surfaced verbatim in the candidate's inbox card. 1000 char cap
  /// enforced server-side.
  message         String?            @db.Text
  /// Optional ATS context — see model docstring.
  applicationId   String?
  application     Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  /// PENDING requests auto-expire 30 days after creation. We stamp
  /// this at insert time rather than computing on read so cleanup
  /// can use a simple WHERE expiresAt < NOW() index scan.
  expiresAt       DateTime
  /// Status-change timestamps. Multi-column instead of one column
  /// + last-status because dashboards want "granted in last 30 days"
  /// and "denied recently" as separate counts.
  grantedAt       DateTime?
  deniedAt        DateTime?
  revokedAt       DateTime?
  /// Optional reason given by the candidate when they DENIED the
  /// request. Surfaced to the recruiter in their dashboard but
  /// never to other admins / users. Most candidates leave it null.
  denyReason      String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  /// One open / decided thread per pair — re-submission reuses the
  /// row. Composite unique handles both the create-or-update case
  /// at the action layer and the "is there an active grant" lookup
  /// in canSeeContact.
  @@unique([requesterUserId, targetUserId])
  @@index([targetUserId, status])
  @@index([requesterUserId, status])
  /// Cleanup tick scans on this for PENDING rows past `expiresAt`.
  @@index([status, expiresAt])
}

/// One-way follow: candidates following experts/influencers and users
/// following companies. Each row targets exactly one of `followeeUserId`
/// or `followeeCompanyId` (validated in the action layer).
model Follow {
  id                String   @id @default(cuid())
  followerId        String
  followeeUserId    String?
  followeeCompanyId String?
  follower          User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeUser      User?    @relation("FolloweeUser", fields: [followeeUserId], references: [id], onDelete: Cascade)
  followeeCompany   Company? @relation("FolloweeCompany", fields: [followeeCompanyId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([followerId, followeeUserId])
  @@unique([followerId, followeeCompanyId])
  @@index([followeeUserId])
  @@index([followeeCompanyId])
}

enum PostKind {
  TEXT // default — body only, optional `mediaUrls` for legacy
  IMAGE // 1+ image attachments, body is caption
  VIDEO // single uploaded video file (≤10MB)
  EMBED // YouTube / Vimeo / Instagram / LinkedIn video URL
  DOCUMENT // single PDF / DOCX / PPTX (≤10MB)
  ARTICLE // long-form, with title + cover image
  POLL // attached Poll (free or paid response)
  QUESTION // Quora-style — body is the question; community submits Answer rows
}

enum EmbedProvider {
  YOUTUBE
  VIMEO
  INSTAGRAM
  LINKEDIN
  TWITTER
}

enum PostAttachmentType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PostVisibility {
  PUBLIC // shows on the global feed and tag pages
  CONNECTIONS // 1st-degree connections only
  PRIVATE // hidden (drafts)
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  INSIGHTFUL
  FUNNY
  LOVE
}

model Post {
  id             String         @id @default(cuid())
  authorId       String
  author         User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // Optionally posted as a company page (LinkedIn style "Acme Co posted").
  asCompanyId    String?
  asCompany      Company?       @relation("PostAsCompany", fields: [asCompanyId], references: [id], onDelete: SetNull)
  body           String         @db.Text
  mediaUrls      String[]       @default([])
  hashtags       String[]       @default([])
  mentions       String[]       @default([]) // raw @handles, not yet resolved
  visibility     PostVisibility @default(PUBLIC)
  // Optional join to a Job — turns a job into a feed item.
  attachedJobId  String?
  attachedJob    JobPosting?    @relation(fields: [attachedJobId], references: [id], onDelete: SetNull)
  // For reposts:
  repostOfId     String?
  repostOf       Post?          @relation("PostRepost", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts        Post[]         @relation("PostRepost")
  reactionsCount Int            @default(0)
  commentsCount  Int            @default(0)
  repostsCount   Int            @default(0)
  // LinkedIn-style "Featured" pin — the author can spotlight up to 3 of
  // their posts on the top of their public profile. `featuredAt` doubles
  // as a sort key so the pinned strip is rendered in the order the user
  // pinned them; null when not featured.
  featured       Boolean        @default(false)
  featuredAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // ─── Rich content (LinkedIn-style) ─────────────────────────
  // Posts can carry attachments (images / video / document), an embed (a
  // third-party video URL), an inline poll, or article-form (cover + title).
  // `kind` is the primary classifier; the other fields are nullable and
  // populated only for that kind. `mediaUrls` (legacy String[]) stays for
  // back-compat — new uploads go through `attachments` instead.
  kind              PostKind       @default(TEXT)
  // ARTICLE
  articleTitle      String?
  articleCoverUrl   String?
  // EMBED
  embedUrl          String?
  embedProvider     EmbedProvider?
  embedTitle        String?
  embedThumbnailUrl String?

  reactions   PostReaction[]
  comments    PostComment[]
  attachments PostAttachment[]
  poll        Poll?
  // Quora-style answers — populated only when `kind == QUESTION`.
  answers     Answer[]
  // Denormalised count, kept in sync inside the same transaction as
  // answer create/delete. Mirrors `commentsCount` so feed cards can
  // surface "12 answers" without a per-row aggregate query.
  answerCount Int              @default(0)

  @@index([authorId, createdAt])
  @@index([visibility, createdAt])
  @@index([hashtags])
  @@index([kind, createdAt])
}

// Generic attachment row — one image / video / document file in MinIO.
// Multiple per Post for image carousels (LinkedIn allows up to 9 images).
model PostAttachment {
  id        String             @id @default(cuid())
  postId    String
  post      Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      PostAttachmentType
  url       String // public MinIO/S3 URL
  fileName  String
  mime      String
  byteSize  Int
  // Type-specific metadata in JSON: image dims, video duration, doc page
  // count. Optional — readers tolerate missing fields.
  meta      Json?
  order     Int                @default(0)
  createdAt DateTime           @default(now())

  @@index([postId, order])
}

model Poll {
  id             String   @id @default(cuid())
  postId         String   @unique
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  question       String
  // Polls auto-close at this point — voting after this is rejected by the
  // server action. UI continues to show the totals.
  closesAt       DateTime
  // When true, voters can pick more than one option (LinkedIn doesn't but
  // we surface the toggle). Default false.
  multipleChoice Boolean  @default(false)
  totalVotes     Int      @default(0)
  createdAt      DateTime @default(now())

  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text   String
  order  Int    @default(0)
  // Denormalised count, kept fresh by the vote action.
  votes  Int    @default(0)

  voteRows PollVote[]

  @@index([pollId, order])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("PollVoter", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  // One row per (poll, user, option). Single-choice polls enforce
  // uniqueness on (poll, user) at the action level by deleting prior votes
  // before inserting. Multi-choice polls allow multiple option rows per
  // user; the (poll, user, option) tuple stays unique.
  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
}

model PostReaction {
  postId    String
  userId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model PostComment {
  id           String        @id @default(cuid())
  postId       String
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String
  author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String        @db.Text
  parentId     String?
  parent       PostComment?  @relation("CommentReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies      PostComment[] @relation("CommentReply")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  /// Soft-hide for moderation. When `hiddenAt` is non-null the comment
  /// disappears from the public thread and is surfaced as
  /// "[hidden by a moderator]" to non-author viewers. The author still
  /// sees their original body so they can edit + appeal. Different from
  /// hard-delete (which removes the row) because we want the audit
  /// trail + the option to restore. `hiddenById` records which admin
  /// took the action; `hiddenReason` carries an optional note shown to
  /// the author when they next view their comment.
  hiddenAt     DateTime?
  hiddenById   String?
  hiddenBy     User?         @relation("CommentHider", fields: [hiddenById], references: [id], onDelete: SetNull)
  hiddenReason String?       @db.Text

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([hiddenAt])
}

// ─── Answers (Quora-style, attached to a QUESTION-kind Post) ──
//
// Comments stay attached to all post kinds (short clarifications,
// reactions). Answers are first-class entities for QUESTION posts —
// they have their own body, helpful-vote count, and rank on the post
// detail page above comments.
model Answer {
  id           String   @id @default(cuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body         String   @db.Text
  // Helpful-vote count surfaced as a sort key. Vote rows live in
  // AnswerHelpful so we can show "you've already voted" UI.
  helpfulCount Int      @default(0)
  // Hashtag + mention slugs extracted from the body at write time.
  // Mirrors Post.hashtags / Post.mentions so the same surfacing logic
  // (tag pages, mention notifications) can apply uniformly later.
  hashtags     String[] @default([])
  mentions     String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  helpfulVotes AnswerHelpful[]

  @@index([postId, helpfulCount])
  @@index([authorId])
  @@index([hashtags])
}

model AnswerHelpful {
  answerId  String
  userId    String
  createdAt DateTime @default(now())

  answer Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User   @relation("AnswerVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@id([answerId, userId])
  @@index([userId])
}

// ─── Events & Webinars ────────────────────────────────────────
//
// Hosted by a Company. Users register via EventRegistration. The
// public list page (/events) shows OPEN events ordered by startsAt;
// each event detail page (/events/[slug]) renders a register button
// for signed-in users and is embedded under /company/[slug]/events.

enum EventType {
  WEBINAR // 100% online
  IN_PERSON // physical location only
  HYBRID // both
}

enum EventStatus {
  DRAFT // not visible publicly yet
  OPEN // visible, accepting registrations
  CANCELLED // shown with a "cancelled" banner so registered users see the change
  COMPLETED // past event — kept for archive + companies' history tab
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED // post-event mark-up (used for analytics + certificates later)
  NO_SHOW
}

model Event {
  id          String  @id @default(cuid())
  slug        String  @unique
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Nullable so SetNull can fire when a creator is deleted — events
  // outlive their creator (recruiter leaves the company, event stays
  // bookable for everyone who already registered).
  createdById String?
  createdBy   User?   @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)

  title       String
  description String      @db.Text
  eventType   EventType   @default(WEBINAR)
  status      EventStatus @default(DRAFT)

  // Timing — startsAt is required; endsAt optional for short demos that
  // don't need a hard end. timezone is the IANA name shown to users
  // alongside the local-time conversion ("19:00 IST"). All timestamps
  // are stored in UTC.
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String    @default("Asia/Kolkata")
  registrationDeadline DateTime?

  // For IN_PERSON / HYBRID events. Optional — falls back to "TBA" in UI.
  location String?

  // For WEBINAR / HYBRID events. Visible only to registered users (the
  // page hides it from anonymous viewers to discourage gate-jumping).
  meetingUrl String?

  coverImageUrl String?
  // Soft cap. Enforced at register time; set to null for unlimited.
  capacity      Int?

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, startsAt])
  @@index([status, startsAt])
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User                    @relation("EventAttendee", fields: [userId], references: [id], onDelete: Cascade)
  status    EventRegistrationStatus @default(REGISTERED)
  // Optional free-text the registrant types when signing up — questions
  // they want answered, dietary needs for in-person, etc.
  notes     String?                 @db.Text
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

// ─── Broadcasts (admin → user fanout) ──────────────────────

enum BroadcastStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum BroadcastTarget {
  ALL_USERS
  ALL_CANDIDATES
  ALL_EMPLOYERS
  DIYGURU_VERIFIED
  OPEN_TO_WORK
  EMPLOYERS_VERIFIED
  // Fair-scoped audiences. Used by the placement team to reach
  // everyone tied to a specific recruitment drive (candidates,
  // employers, TPOs, or all three) without spamming the platform
  // at large. Requires `targetDriveId` to be set on the Broadcast row.
  FAIR_REGISTERED_CANDIDATES
  FAIR_REGISTERED_EMPLOYERS
  FAIR_REGISTERED_TPOS
  FAIR_ALL_REGISTRANTS
}

model Broadcast {
  id             String                @id @default(cuid())
  title          String
  body           String                @db.Text
  link           String?
  target         BroadcastTarget       @default(ALL_USERS)
  /// Required when `target` is one of the FAIR_* values. Scopes the
  /// audience query to the relevant RecruitmentDrive. Null for
  /// platform-wide broadcasts. SetNull on drive delete so a sent
  /// broadcast's audit trail survives the drive being archived.
  targetDriveId  String?
  targetDrive    RecruitmentDrive?     @relation("BroadcastTargetDrive", fields: [targetDriveId], references: [id], onDelete: SetNull)
  channels       NotificationChannel[]
  status         BroadcastStatus       @default(DRAFT)
  recipientCount Int                   @default(0)
  sentCount      Int                   @default(0)
  failedCount    Int                   @default(0)
  createdById    String
  createdAt      DateTime              @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([targetDriveId])
}

// ─── Job reports / moderation ──────────────────────────────

enum JobReportReason {
  SPAM
  MISLEADING
  FRAUDULENT
  INAPPROPRIATE
  EXPIRED
  OTHER
}

enum JobReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

model JobReport {
  id             String          @id @default(cuid())
  jobId          String
  job            JobPosting      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reporterUserId String?
  reason         JobReportReason
  details        String?         @db.Text
  status         JobReportStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewerNotes  String?         @db.Text
  ip             String?
  createdAt      DateTime        @default(now())

  @@index([jobId])
  @@index([status, createdAt])
}

// ─── Audit log ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// ─── Mentorship ─────────────────────────────────────────────
// Any user can apply to become a mentor. Admin reviews KYC docs (PAN/Aadhaar/
// expert-credential) before flipping `isPublished` to true. Mentors set a
// weekly recurring availability (MentorAvailability rows with `kind=RECURRING`)
// and optional one-off date overrides (`kind=OVERRIDE`). Mentees book a
// MentorshipSession; if `priceMinor > 0` we kick off a Razorpay order and
// flip `paymentStatus` via webhook. Free sessions skip checkout entirely.

enum MentorKycStatus {
  DRAFT // mentor still editing — not submitted
  PENDING // submitted, awaiting admin review
  APPROVED // KYC cleared — mentor can publish
  REJECTED // admin rejected — mentor can resubmit after fix
}

enum MentorshipMode {
  VIDEO
  PHONE
  CHAT
}

enum MentorshipSessionStatus {
  PENDING_PAYMENT // mentee booked but Razorpay payment not yet captured
  CONFIRMED // payment captured (or free); slot is locked
  COMPLETED // mentor marked as held
  CANCELLED // either side cancelled before the slot
  NO_SHOW // marked by the mentor after the slot
  REFUNDED // payment was reversed (admin or auto on cancel)
}

enum MentorshipPaymentStatus {
  FREE // session was free, no order created
  PENDING // Razorpay order created, awaiting capture
  PAID // capture confirmed via webhook
  REFUNDED // refund issued
  FAILED // payment failed / abandoned
}

enum MentorAvailabilityKind {
  RECURRING // dayOfWeek + startMinute + endMinute (weekly)
  OVERRIDE // specific date — adds extra hours
  BLOCKED // specific date — blocks an otherwise-available window
}

model MentorProfile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Public mentor display
  headline             String // "Senior Battery Engineer · 12yr · Ola Electric"
  bio                  String          @db.Text
  expertiseTags        String[]        @default([]) // freeform: "BMS", "powertrain"
  evDomainSlugs        String[]        @default([]) // canonical EV-domain slugs
  languages            String[]        @default([]) // ISO codes: "en", "hi"
  yearsExperience      Int             @default(0)
  // Pricing — minor units (paise for INR). 0 = free.
  pricePerSessionMinor Int             @default(0)
  currency             String          @default("INR")
  acceptingFree        Boolean         @default(false)
  acceptingPaid        Boolean         @default(false)
  // Session config — durations the mentor offers
  sessionDurations     Int[]           @default([30, 45, 60]) // minutes
  bufferMinutes        Int             @default(15) // gap between bookings
  defaultMode          MentorshipMode  @default(VIDEO)
  meetingProvider      String? // "google-meet" | "zoom" | "manual"
  // KYC + publishing gate
  kycStatus            MentorKycStatus @default(DRAFT)
  kycSubmittedAt       DateTime?
  kycReviewedAt        DateTime?
  kycReviewerId        String?
  kycRejectionNote     String?         @db.Text
  isPublished          Boolean         @default(false)
  // Aggregate stats
  totalSessions        Int             @default(0)
  totalEarningsMinor   Int             @default(0) // lifetime earnings (gross)
  avgRating            Float           @default(0)
  totalRatings         Int             @default(0)
  responseRateBps      Int             @default(0) // 0-10000
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  availabilityRules MentorAvailability[]
  sessions          MentorshipSession[]
  reviews           MentorshipReview[]
  payouts           MentorshipPayout[]

  @@index([isPublished, kycStatus])
  @@index([avgRating])
}

model MentorAvailability {
  id          String                 @id @default(cuid())
  mentorId    String
  mentor      MentorProfile          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  kind        MentorAvailabilityKind
  // For RECURRING: dayOfWeek 0–6 (Sun–Sat) + minutes from midnight (mentor TZ).
  dayOfWeek   Int? // 0=Sun … 6=Sat
  startMinute Int? // 0–1440
  endMinute   Int? // 0–1440
  // For OVERRIDE / BLOCKED: a specific date window.
  startAt     DateTime?
  endAt       DateTime?
  timezone    String                 @default("Asia/Kolkata")
  createdAt   DateTime               @default(now())

  @@index([mentorId, kind])
  @@index([mentorId, startAt])
}

model MentorshipSession {
  id                       String                  @id @default(cuid())
  mentorId                 String
  mentor                   MentorProfile           @relation(fields: [mentorId], references: [id], onDelete: Restrict)
  menteeUserId             String
  mentee                   User                    @relation("MentorshipMentee", fields: [menteeUserId], references: [id])
  scheduledAt              DateTime
  durationMins             Int
  mode                     MentorshipMode          @default(VIDEO)
  topic                    String // mentee's question / agenda
  menteeNotes              String?                 @db.Text
  meetingUrl               String?
  icsUid                   String?                 @unique
  status                   MentorshipSessionStatus @default(PENDING_PAYMENT)
  // Pricing snapshot — frozen at booking time
  priceMinor               Int                     @default(0)
  currency                 String                  @default("INR")
  // Razorpay
  paymentStatus            MentorshipPaymentStatus @default(FREE)
  razorpayOrderId          String?                 @unique
  razorpayPaymentId        String?                 @unique
  refundAt                 DateTime?
  // Reminder fanout markers (mirrors Interview model conventions)
  reminderDayBeforeSentAt  DateTime?
  reminderHourBeforeSentAt DateTime?
  // Stamped after the booking confirmation email + ICS calendar
  // attachment is sent. Without this marker the reminder worker
  // could re-send the same calendar invite on every tick.
  calendarInviteSentAt     DateTime?
  // Post-session
  mentorNotes              String?                 @db.Text
  completedAt              DateTime?
  cancelledAt              DateTime?
  cancelledByUserId        String?
  cancellationReason       String?                 @db.Text
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  review MentorshipReview?

  @@index([mentorId, scheduledAt])
  @@index([menteeUserId, scheduledAt])
  @@index([status, scheduledAt])
}

model MentorshipReview {
  id             String            @id @default(cuid())
  sessionId      String            @unique
  session        MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mentorId       String
  mentor         MentorProfile     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  reviewerUserId String
  reviewer       User              @relation("MentorshipReviewer", fields: [reviewerUserId], references: [id])
  rating         Int // 1–5
  body           String?           @db.Text
  isPublic       Boolean           @default(true)
  createdAt      DateTime          @default(now())

  @@index([mentorId, createdAt])
}

// Payout ledger — admin manually settles. We surface owed totals per mentor
// (sum of CONFIRMED/COMPLETED PAID sessions minus already-paid-out rows) and
// the admin records the disbursement here.
enum MentorPayoutStatus {
  PENDING
  PROCESSING
  PAID
  ON_HOLD
  REVERSED
}

model MentorshipPayout {
  id          String             @id @default(cuid())
  mentorId    String
  mentor      MentorProfile      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  // Sum of sessions covered by this payout, captured at creation time.
  amountMinor Int
  currency    String             @default("INR")
  // Range over which sessions were aggregated.
  periodStart DateTime
  periodEnd   DateTime
  status      MentorPayoutStatus @default(PENDING)
  // Admin-entered transaction reference (NEFT/UPI ref).
  externalRef String?
  notes       String?            @db.Text
  paidAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([mentorId, status])
}

// ─── Competitions / Challenges (Unstop-style) ────────────────
// A company drafts a Competition with one or more CompetitionStages. Admin
// reviews the draft and either approves (status → APPROVED → goes LIVE on
// `publishedAt`) or rejects with a note. Candidates register either solo or
// as a team (CompetitionRegistration + CompetitionTeamMember). For team
// invites we accept email-only invitees and resolve them to a userId on
// account creation. Each registration moves through stages — a submission
// per stage (CompetitionSubmission) — judges score (CompetitionScore), top-
// scoring registrations advance. Final winners are listed in CompetitionPrize
// (rank-keyed) and admin disburses prize money via PrizePayout (manual ledger).

enum CompetitionType {
  HACKATHON
  CASE_STUDY
  QUIZ
  DESIGN_CHALLENGE
  INNOVATION
  INTERNSHIP_HUNT
  IDEATHON
  RESEARCH
}

enum CompetitionStatus {
  DRAFT // host editing
  PENDING_REVIEW // submitted to admin
  CHANGES_REQUESTED // admin asked for changes
  APPROVED // admin approved — will go LIVE at publishedAt
  LIVE // currently accepting registrations / submissions
  JUDGING // submissions closed, judges scoring
  RESULTS // results announced
  CLOSED // archive
  REJECTED // admin rejected entirely
}

enum CompetitionStageKind {
  REGISTRATION
  QUIZ // tied to an Assessment
  SUBMISSION // file + write-up
  INTERVIEW
  PRESENTATION
}

enum RegistrationStatus {
  REGISTERED
  SUBMITTED
  SHORTLISTED
  FINALIST
  WINNER
  RUNNER_UP
  ELIMINATED
  DISQUALIFIED
  WITHDRAWN
}

enum TeamMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum TeamMemberRole {
  LEADER
  MEMBER
}

model Competition {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  title                String
  tagline              String?
  description          String            @db.Text
  bannerImageUrl       String?
  // Host is a company on the platform; postedBy is the user who drafted it.
  hostCompanyId        String
  hostCompany          Company           @relation("CompanyCompetitions", fields: [hostCompanyId], references: [id], onDelete: Cascade)
  postedById           String
  postedBy             User              @relation("CompetitionPostedBy", fields: [postedById], references: [id])
  type                 CompetitionType   @default(HACKATHON)
  evDomainSlugs        String[]          @default([])
  eligibility          String?           @db.Text
  rules                String?           @db.Text
  judgingCriteria      Json? // [{ name, weight, description }]
  // Team rules — solo competitions set isTeamBased=false, leave min/max null.
  isTeamBased          Boolean           @default(false)
  minTeamSize          Int?
  maxTeamSize          Int?
  // Lifecycle dates
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startsAt             DateTime
  endsAt               DateTime
  resultsAt            DateTime?
  // Aggregate prize info — broken down per rank in CompetitionPrize.
  totalPrizePoolMinor  Int               @default(0)
  prizeCurrency        String            @default("INR")
  // Moderation
  status               CompetitionStatus @default(DRAFT)
  submittedAt          DateTime?
  reviewedById         String?
  reviewedAt           DateTime?
  reviewerNotes        String?           @db.Text
  publishedAt          DateTime?
  isFeatured           Boolean           @default(false)
  // Stats
  registrationsCount   Int               @default(0)
  submissionsCount     Int               @default(0)
  viewCount            Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  stages        CompetitionStage[]
  registrations CompetitionRegistration[]
  prizes        CompetitionPrize[]
  perks         CompetitionPerk[]
  judges        CompetitionJudge[]
  announcements CompetitionAnnouncement[]

  @@index([status, publishedAt])
  @@index([hostCompanyId, status])
  @@index([type, status])
}

model CompetitionStage {
  id                 String               @id @default(cuid())
  competitionId      String
  competition        Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  order              Int
  name               String
  description        String?              @db.Text
  kind               CompetitionStageKind
  // For QUIZ stages we point at an existing Assessment in the host's library.
  assessmentId       String?
  startsAt           DateTime
  endsAt             DateTime
  // Advancement gate — top N or score threshold.
  advanceTopN        Int?
  advanceMinScore    Float?
  // For team stages, whether all members must attend / submit.
  requiresAllMembers Boolean              @default(false)
  createdAt          DateTime             @default(now())

  submissions CompetitionSubmission[]

  @@unique([competitionId, order])
  @@index([competitionId, kind])
}

model CompetitionRegistration {
  id             String             @id @default(cuid())
  competitionId  String
  competition    Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // The leader is the registering user (also for solo competitions).
  leaderUserId   String
  leader         User               @relation("CompetitionLeader", fields: [leaderUserId], references: [id])
  teamName       String?
  status         RegistrationStatus @default(REGISTERED)
  currentStageId String?
  registeredAt   DateTime           @default(now())
  withdrawnAt    DateTime?
  finalRank      Int? // populated when results are announced
  finalScore     Float?
  notes          String?            @db.Text

  // ─── Public team-page fields (added for the Team EV Challenge feature) ───
  // The registration row IS the team for our purposes — these fields just
  // give the team a face. Captain fills them in on /me/teams/[id]; once
  // verification clears + captain publishes, the public page is live at
  // /teams/[teamSlug].

  /// URL-safe slug for /teams/[slug]. NULL until the captain creates one
  /// (registration row creates first, captain enters team profile next).
  /// Globally unique so team URLs are stable + sharable.
  teamSlug           String?                @unique
  /// Square logo (square crop preferred, 256×256 minimum). Stored in MinIO
  /// avatars bucket like Company logos.
  teamLogoUrl        String?
  teamBio            String?                @db.Text
  /// The real-world event the team is preparing for ("eBAJA SAEINDIA 2026",
  /// "Formula Bharat 2025"). Free text in v1; v2 swaps to canonical
  /// ExternalEvent table.
  externalEvent      String?
  /// Their team number / ID at the external event (eBAJA team #234).
  externalTeamId     String?
  /// College the team represents — free-text fallback.
  /// Captured even when `institutionId` is set so the public team
  /// page can render a name without joining (and so legacy rows
  /// created before the canonical FK existed keep displaying).
  institution        String?
  /// Optional FK to the canonical Institution table. When set, the
  /// public team page links the institution name to /institutions/[slug]
  /// and counts the team toward the institution's leaderboard.
  /// NULL is fine — captains can pick from the autocomplete or type
  /// free text; we don't force them to find a canonical entry.
  institutionId      String?
  institutionRef     Institution?           @relation("CompetitionTeamInstitution", fields: [institutionId], references: [id], onDelete: SetNull)
  facultyAdvisor     String?
  /// Used during verification — admin pings this address to confirm the
  /// team is real. Required for VERIFIED status.
  facultyEmail       String?
  /// JSON: { instagram?, linkedin?, website?, youtube?, github? }. Same
  /// shape as Company.socialLinks so we can reuse the URL-validation +
  /// render helpers.
  socialLinks        Json?
  /// Page visibility ladder. DRAFT until captain explicitly publishes
  /// (and team is VERIFIED). HIDDEN if captain or admin pulled it.
  publicPageStatus   TeamPagePublicStatus   @default(DRAFT)
  publishedAt        DateTime?
  /// Verification ladder. UNVERIFIED → captain submits docs →
  /// PENDING_REVIEW → admin approves → VERIFIED. Only VERIFIED teams
  /// can publish + receive prize disbursement; submission and member
  /// onboarding work at any state (so we never lose growth signups
  /// while waiting for admin review).
  verificationStatus TeamVerificationStatus @default(UNVERIFIED)
  verificationNote   String?                @db.Text
  verifiedAt         DateTime?
  verifiedById       String?
  verifiedBy         User?                  @relation("CompetitionTeamVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  members     CompetitionTeamMember[]
  submissions CompetitionSubmission[]
  scores      CompetitionScore[]

  // (No unique on (competitionId, leaderUserId).) A user CAN lead
  // multiple teams in the same competition — for cross-college
  // captains entering one team per college, or for staging /
  // demo workflows. The captain dashboard handles N teams
  // gracefully and the register page lands the captain on /me/teams
  // (the list view) when they already have ≥1 team for the comp.
  @@index([competitionId, leaderUserId])
  @@index([competitionId, status])
  @@index([publicPageStatus, publishedAt])
  @@index([verificationStatus])
}

/// Public-page visibility for a competition team.
enum TeamPagePublicStatus {
  /// Captain hasn't published yet. Members can still see /me/teams/[id].
  DRAFT
  /// Live at /teams/[slug]. Indexable, shareable, listed on /pulse.
  PUBLISHED
  /// Was published, then captain or admin took it down.
  HIDDEN
}

/// Admin-driven verification state.
enum TeamVerificationStatus {
  UNVERIFIED // freshly registered
  PENDING_REVIEW // captain submitted for review
  VERIFIED // admin approved
  REJECTED // admin rejected (with note)
}

model CompetitionTeamMember {
  id              String                  @id @default(cuid())
  registrationId  String
  registration    CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  // Either userId (existing platform user) or invitedEmail (pending signup).
  userId          String?
  user            User?                   @relation("CompetitionMember", fields: [userId], references: [id])
  invitedEmail    String?
  inviteToken     String?                 @unique
  role            TeamMemberRole          @default(MEMBER)
  status          TeamMemberStatus        @default(INVITED)
  /// When the invite expires. Captain can resend (regenerates the
  /// token + bumps this). NULL on rows created before the team-
  /// challenge feature shipped — `acceptTeamInvite` treats NULL as
  /// non-expiring for backwards compat.
  invitedAt       DateTime                @default(now())
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  /// Free-text role assigned by the captain — "Driver", "Suspension
  /// Lead", "Powertrain Engineer". Surfaces on the public team page.
  positionTitle   String?

  @@unique([registrationId, invitedEmail])
  @@index([registrationId])
  @@index([userId])
}

model CompetitionSubmission {
  id                String                  @id @default(cuid())
  registrationId    String
  registration      CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  stageId           String
  stage             CompetitionStage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  title             String
  summary           String?                 @db.Text
  body              String?                 @db.Text // rich write-up
  attachmentUrls    String[]                @default([])
  externalUrl       String? // GitHub / Figma / Drive
  /// First-class field for a working-prototype video. Validated as a
  /// YouTube / Vimeo / MinIO URL on the server action. Surfaced on the
  /// public team page when the team has published. Optional — not all
  /// competition formats want a video deliverable.
  prototypeVideoUrl String?
  submittedAt       DateTime                @default(now())
  isLate            Boolean                 @default(false)

  scores CompetitionScore[]

  @@unique([registrationId, stageId])
  @@index([stageId])
}

// Per-judge per-submission score row. Final per-submission score is the
// average across judges (server-side aggregation).
model CompetitionScore {
  id               String                  @id @default(cuid())
  submissionId     String
  submission       CompetitionSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  registrationId   String
  registration     CompetitionRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  judgeUserId      String
  // Per-criterion scores keyed by criterion name. Server validates against the
  // competition's judgingCriteria definition.
  scoresByCriteria Json
  total            Float
  feedback         String?                 @db.Text
  createdAt        DateTime                @default(now())

  @@unique([submissionId, judgeUserId])
}

model CompetitionJudge {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  judgeUserId   String
  judge         User        @relation("CompetitionJudge", fields: [judgeUserId], references: [id])
  // Limit which stages this judge scores (empty = all).
  stageIds      String[]    @default([])
  invitedAt     DateTime    @default(now())

  @@unique([competitionId, judgeUserId])
}

model CompetitionPrize {
  id                    String             @id @default(cuid())
  competitionId         String
  competition           Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  rank                  Int // 1, 2, 3 … or 0 for "honourable mentions"
  title                 String // "Winner", "Runner-up"
  description           String?
  cashAmountMinor       Int                @default(0)
  currency              String             @default("INR")
  inKind                String? // e.g. "Lifetime DIYguru access"
  // Sponsor name (defaults to host company)
  sponsor               String?
  // Disbursement (manual admin ledger)
  awardedRegistrationId String?
  payoutStatus          MentorPayoutStatus @default(PENDING)
  payoutExternalRef     String?
  payoutNotes           String?            @db.Text
  paidAt                DateTime?

  @@unique([competitionId, rank])
}

// "Perks" tie a competition to one or more JobPosting / Internship — the host
// commits that finalists / winners get fast-tracked into ATS for that role.
// On results-announce the system auto-creates an Application with source=
// AI_INVITED for the awarded registration's candidate.
model CompetitionPerk {
  id            String           @id @default(cuid())
  competitionId String
  competition   Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  jobId         String
  job           JobPosting       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Which ranks get the perk. e.g. [1,2,3] or [0] for finalists.
  forRanks      Int[]            @default([])
  // What stage of ATS the candidate is dropped into.
  ataStage      ApplicationStage @default(SHORTLISTED)
  notes         String?

  @@unique([competitionId, jobId])
}

model CompetitionAnnouncement {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  title         String
  body          String      @db.Text
  postedById    String
  createdAt     DateTime    @default(now())

  @@index([competitionId, createdAt])
}

// ─── Editable platform settings ──────────────────────────────
//
// Tiny key/value store of admin-editable settings (site name, support email,
// feature flags, maintenance toggle, etc.). Loaded by `lib/settings.ts` with
// a small in-memory cache so reading these is effectively free; cache is
// invalidated whenever an admin saves a value through `/admin/settings`.
//
// Why a generic table instead of one column per setting? Adding a new
// setting must not require a Prisma migration — admins shouldn't have to
// redeploy to add a "support phone number" field. The trade-off is that
// callers must know the key by string. Defaults are baked into
// `lib/settings.ts` so missing rows resolve to sensible values.

enum SiteSettingType {
  STRING
  TEXT
  NUMBER
  BOOLEAN
  URL
  EMAIL
  JSON
}

model SiteSetting {
  key         String          @id
  value       String          @db.Text
  type        SiteSettingType @default(STRING)
  category    String? // grouping for the admin UI (e.g. "identity", "email", "feature")
  label       String? // human label shown in the admin form
  description String? // help text shown under the field
  updatedAt   DateTime        @updatedAt
  updatedById String?

  @@index([category])
}

// ─── Volunteer experience ────────────────────────────────────
//
// Same shape as Experience minus the company-FK upgrade — volunteer
// roles rarely map to a Company entity (they're at NGOs, schools,
// community groups). Kept as a separate model rather than a `kind`
// discriminator on Experience so the public profile can render the
// two as distinct sections (LinkedIn does the same) and so the
// completeness scorer can weight them differently if we ever want.

model VolunteerExperience {
  id           String           @id @default(cuid())
  candidateId  String
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  organization String
  role         String
  /// Cause area — Education, Environment, Health, etc. Optional;
  /// surfaced as a small chip on the profile card.
  cause        String?
  startDate    DateTime
  endDate      DateTime?
  current      Boolean          @default(false)
  description  String?          @db.Text
  createdAt    DateTime         @default(now())

  @@index([candidateId])
}

// ─── Peer recommendations ────────────────────────────────────
//
// LinkedIn-style written endorsements. The receiver controls
// visibility — every rec lands as PENDING and only flips to VISIBLE
// when the receiver approves it (avoids spammy / drive-by recs from
// strangers). Receivers can also HIDE without deleting (LinkedIn
// pattern: hidden recs come back if visibility flips later).

enum RecommendationStatus {
  PENDING /// just written, awaiting receiver approval
  VISIBLE /// approved by the receiver — shows on their public profile
  HIDDEN /// hidden by the receiver, not shown publicly
}

model Recommendation {
  id           String               @id @default(cuid())
  fromUserId   String
  fromUser     User                 @relation("RecommendationGiver", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User                 @relation("RecommendationReceiver", fields: [toUserId], references: [id], onDelete: Cascade)
  /// Free-text endorsement. 280–1200 chars enforced server-side; the
  /// floor stops 5-word "great person" recs that read as spam.
  body         String               @db.Text
  /// How the giver knew the receiver — "Worked together at Ola Electric",
  /// "Reported to me at Ather", "Studied together at IIT Madras", etc.
  /// Surfaces as the relationship caption under each rec on the profile.
  relationship String
  status       RecommendationStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  /// One rec per (giver, receiver) pair — re-writes update in place.
  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

// ─── Email / SMS delivery telemetry ─────────────────────────
//
// Provider webhooks (SES SNS, Resend, MSG91 DLR) post here so the
// admin dashboard can show bounce rates, complaints, and per-domain
// delivery health. Each row is one provider event; we don't try to
// stitch a one-to-one with sent messages because providers retry on
// their own and not every send produces a downstream event.

enum DeliveryChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum DeliveryEventKind {
  // Provider acknowledged receipt of the message.
  ACCEPTED
  // Successfully delivered to the recipient mailbox / handset.
  DELIVERED
  // Hard bounce (invalid address) — sender reputation hit.
  BOUNCED
  // Recipient marked as spam / complaint loop.
  COMPLAINED
  // Provider error, retryable.
  DEFERRED
  // Permanent failure (DLR-level), non-retryable.
  FAILED
  // Recipient opened (email pixel) — best-effort metric.
  OPENED
  // Recipient clicked a tracked link.
  CLICKED
}

model EmailDeliveryEvent {
  id                String            @id @default(cuid())
  channel           DeliveryChannel
  kind              DeliveryEventKind
  /// The recipient address as the provider reported it. We hash on
  /// presentation in the admin dashboard so PII isn't loose in
  /// rendering, but store raw so support tickets can correlate.
  recipient         String
  /// Provider name: "ses", "resend", "msg91", etc.
  provider          String
  /// Provider-specific message id (X-SES-Message-ID, Resend's id, etc.)
  /// — useful to correlate with provider dashboards during outages.
  providerMessageId String?
  /// Optional reason / diagnostic from the provider (bounce reason
  /// code, complaint feedback type, etc.) so the dashboard can show
  /// "why did 12% of yesterday's emails bounce".
  reason            String?           @db.Text
  /// Free-form provider event payload for forensics.
  rawPayload        Json?
  occurredAt        DateTime
  createdAt         DateTime          @default(now())

  @@index([channel, kind, occurredAt])
  @@index([occurredAt])
  @@index([recipient])
}

// ─── Webhook delivery log (outbound + inbound) ──────────────
//
// Captures every webhook the platform receives from third parties
// (Razorpay payment events, SES bounce notifications) AND every
// webhook we send to employer-configured endpoints (job-published,
// applicant-stage-changed). Single table because the read patterns
// are identical and the volumes are similar.

enum WebhookDirection {
  INBOUND
  OUTBOUND
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  /// Response received but signature / payload didn't validate.
  INVALID
}

model WebhookEvent {
  id           String           @id @default(cuid())
  direction    WebhookDirection
  /// "razorpay", "ses", "resend", "msg91" for inbound; webhook URL
  /// hostname for outbound.
  source       String
  /// Event topic — "payment.captured", "ses.bounce", "job.published",
  /// "application.stage_changed".
  topic        String
  /// Outbound: our chosen request id. Inbound: provider's id.
  externalId   String?
  url          String?          @db.Text
  status       WebhookStatus    @default(PENDING)
  httpStatus   Int?
  /// Response body or error message — stored for failure forensics,
  /// never shown to non-admins.
  responseBody String?          @db.Text
  attempts     Int              @default(1)
  payload      Json?
  receivedAt   DateTime         @default(now())
  deliveredAt  DateTime?
  /// Optional employer / company context — outbound webhooks are
  /// configured per-company; inbound payment events are per-company too.
  companyId    String?
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([direction, status, receivedAt])
  @@index([source, topic, receivedAt])
  @@index([companyId, receivedAt])
}

// ─── A/B experiments ────────────────────────────────────────
//
// Lightweight experimentation primitives. An Experiment has variants
// (control + N treatments). Allocations are sticky-by-userId so a
// given user always sees the same variant; events log exposures and
// success metrics so the analytics page can compute lift. Designed
// for behavioural copy / UX tweaks, not infrastructure tests — the
// allocation model assumes opt-in, not multi-armed bandits.

enum ExperimentStatus {
  DRAFT /// Not yet running — admins can edit.
  RUNNING /// Allocating traffic; collecting events.
  PAUSED /// Allocation frozen; existing users keep their variant.
  COMPLETED /// Winner selected; experiment archived.
}

model Experiment {
  id          String           @id @default(cuid())
  /// Stable key referenced from code — e.g. "feed-cta-copy" or
  /// "match-rerank-prompt". Snake / kebab case preferred so it reads
  /// well in logs.
  key         String           @unique
  name        String
  hypothesis  String?          @db.Text
  status      ExperimentStatus @default(DRAFT)
  /// Variants stored as JSON: `[{ key: "control", weight: 50 }, { key: "v2", weight: 50 }]`.
  /// Weights sum to 100; admin UI enforces.
  variants    Json
  /// Optional winner key once status=COMPLETED. The allocator can
  /// short-circuit and serve only this variant when set, useful as a
  /// stepping-stone before the code change ships.
  winnerKey   String?
  startedAt   DateTime?
  endedAt     DateTime?
  createdById String
  createdBy   User             @relation("ExperimentAuthor", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  allocations ExperimentAllocation[]
  events      ExperimentEvent[]

  @@index([status])
}

model ExperimentAllocation {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  /// Either userId for signed-in users, or anonymousId for cookie-based
  /// stickiness. The allocator picks one at exposure time.
  userId       String?
  anonymousId  String?
  variantKey   String
  allocatedAt  DateTime   @default(now())

  @@unique([experimentId, userId])
  @@unique([experimentId, anonymousId])
  @@index([experimentId, variantKey])
}

model ExperimentEvent {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantKey   String
  /// "exposed" — variant served. "converted:<goal>" — primary metric
  /// fired (job_apply, sign_up, post_create).
  kind         String
  userId       String?
  anonymousId  String?
  /// Optional metric value (revenue, time-to-action, etc.) — most
  /// experiments leave it null.
  value        Float?
  meta         Json?
  occurredAt   DateTime   @default(now())

  @@index([experimentId, kind, occurredAt])
  @@index([experimentId, variantKey, kind])
}

// ─── Hashtag policy ─────────────────────────────────────────
//
// Per-tag moderation state. A row exists only for tags an admin has
// explicitly acted on; tags without a row behave normally.

enum HashtagState {
  /// Trending / featured — promoted on /tag pages and the explore
  /// surface. Optional `displayName` overrides the lowercase slug.
  FEATURED
  /// Hidden from the trending list + search; existing posts still
  /// resolve at /tag/<slug> but with a "this hashtag has been
  /// flagged" banner.
  BLOCKED
  /// Merged into another canonical tag — server-side normalisation
  /// rewrites every reference at extract time. Useful for "ev" → "ev-jobs".
  MERGED_INTO
}

model HashtagPolicy {
  id          String       @id @default(cuid())
  /// Lowercase, no leading "#". Matches Post.hashtags string entries.
  tag         String       @unique
  state       HashtagState
  /// Display label for FEATURED tags. Null for BLOCKED / MERGED_INTO.
  displayName String?
  /// Free-text reason shown to admins; never to public users.
  reason      String?      @db.Text
  /// For MERGED_INTO: the canonical tag that this one rewrites to.
  mergedInto  String?
  createdById String
  createdBy   User         @relation("HashtagPolicyAuthor", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([state])
}

// ─── Announcements (richer site-wide banners) ───────────────
//
// The existing `system.welcome_banner` setting is fine for one
// permanent string; this model handles dated, audience-targeted,
// dismissible announcements like "We're at the EV Expo Jan 12-14"
// or "Maintenance window Saturday 2 AM IST".

enum AnnouncementAudience {
  EVERYONE
  CANDIDATES
  EMPLOYERS
  ADMINS
}

enum AnnouncementSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String               @db.Text
  ctaLabel    String?
  ctaUrl      String?
  audience    AnnouncementAudience @default(EVERYONE)
  severity    AnnouncementSeverity @default(INFO)
  /// Active window — outside this range the banner doesn't render.
  /// startsAt null = effective immediately on save; endsAt null =
  /// runs forever until manually disabled.
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean              @default(true)
  /// When true, users can click to dismiss for the rest of their
  /// session via a localStorage key. Critical announcements set this
  /// false so it can't be hidden.
  dismissible Boolean              @default(true)
  createdById String
  createdBy   User                 @relation("AnnouncementAuthor", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([isActive, startsAt, endsAt])
}

// ─── Billing scaffolding (v1: schema only) ──────────────────
//
// Per the project plan monetisation is out of scope for v1, but
// designing the schema now means we can ship plans without a
// blocking migration later. UI is a placeholder admin page that
// shows the model contents; the public flow stays disabled by
// the `feature.payments_enabled` flag in lib/settings.ts.

enum PlanInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum PlanScope {
  /// Plans for individual candidates (résumé downloads, premium AI
  /// features later).
  CANDIDATE
  /// Plans for employer companies (job posts, ATS seats, AI matching
  /// limits).
  EMPLOYER
}

model Plan {
  id          String       @id @default(cuid())
  /// Public stable key: "candidate-pro", "employer-startup-monthly".
  key         String       @unique
  name        String
  scope       PlanScope
  /// Pricing in lowest currency unit (paise for INR, cents for USD).
  /// Zero is allowed for free / placeholder plans.
  amountMinor Int          @default(0)
  currency    String       @default("INR")
  interval    PlanInterval
  /// Admin-friendly description shown on the (future) checkout page.
  description String?      @db.Text
  /// Feature limits encoded as JSON: `{ jobsPerMonth: 50,
  /// aiMatchesPerWeek: 200 }`. Server-side feature gates can read
  /// the active subscription's plan.features.
  features    Json?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                 String             @id @default(cuid())
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  /// Either a user (CANDIDATE plan) or a company (EMPLOYER plan).
  userId             String?
  user               User?              @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: SetNull)
  companyId          String?
  company            Company?           @relation("SubscriptionCompany", fields: [companyId], references: [id], onDelete: SetNull)
  status             SubscriptionStatus @default(TRIALING)
  /// Current period bounds. For ONE_TIME plans both are set to the
  /// purchase moment + plan duration; for recurring, billing extends
  /// these on each successful renewal.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  cancelledAt        DateTime?
  /// Razorpay subscription id (or other provider id) so we can
  /// reconcile webhooks with our row.
  providerId         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, status])
  @@index([companyId, status])
  @@index([planId, status])
}

// ─── Postgres-backed rate limiter ────────────────────────────
//
// Audit-trail-style rate limiting used by every public-facing
// server action. Each attempt (allowed or denied) creates a row.
// The helper in `lib/rate-limit-pg.ts` reads recent rows for the
// (action, ip|userId) tuple to decide whether to allow.
//
// Why Postgres + Redis side-by-side: we already have a Redis
// limiter (`lib/rate-limit.ts`) for hot auth paths where every
// extra millisecond hurts UX. The PG limiter is for everything
// else AND for the audit trail — knowing who tried to apply 50
// times in 5 minutes is forensically valuable, and Redis loses
// that context the moment the window slides past.
//
// Rows are TTL'd via the notification-maintenance worker — anything
// older than 30 days gets dropped because the slowest active limit
// window we use is 24 hours.
model RateLimitEvent {
  id        String   @id @default(cuid())
  /// Logical action key — e.g. "post.create", "auth.signin",
  /// "id-verify.submit". Use dotted snake_case so dashboards can
  /// `LIKE 'auth.%'` to filter a category.
  action    String
  /// Best-effort client IP from x-forwarded-for / x-real-ip.
  /// Null for purely server-internal triggers (rare).
  ip        String?
  /// Authenticated user id when known. Null for signed-out paths
  /// (signup, magic-link request, etc.).
  userId    String?
  /// Whether the action was allowed (true) or rate-limited (false).
  /// Denied rows are the most useful signal in dashboards.
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([action, ip, createdAt])
  @@index([action, userId, createdAt])
  @@index([createdAt])
}

// ─── Moderation strike system ───────────────────────────────
//
// Each row is one admin action that costs the user a strike.
// Helper `lib/strikes.ts` writes here AND updates the User's
// `strikes` counter + `accountState` in one transaction.
model Strike {
  id              String       @id @default(cuid())
  targetUserId    String
  target          User         @relation("StrikeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  /// The admin who issued the strike. Null only when the strike was
  /// auto-issued by the system (e.g. banned-word auto-flag → upheld).
  authorId        String?
  author          User?        @relation("StrikeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reason          StrikeReason
  /// Free-text note shown to the user. Required for OTHER, optional
  /// otherwise. The user sees this verbatim on /me/account.
  note            String?      @db.Text
  /// Optional link back to the offending content. Format depends on
  /// reason — for COMMENT_HIDDEN it's the postComment.id, for
  /// REPORT_UPHELD it's the audit-log id, etc. Free-form so the
  /// admin UI can link contextually.
  evidenceRef     String?
  /// Strike-state transition snapshot — what the user's strikes
  /// counter was AFTER this strike was issued. Useful for
  /// "this was your 3rd strike → 7-day suspension" copy.
  newStrikeCount  Int
  newAccountState AccountState
  createdAt       DateTime     @default(now())

  @@index([targetUserId, createdAt])
  @@index([reason, createdAt])
}

// ─── Grievance ticket (Indian IT Rules 2021 compliance) ─────
//
// Every public service in India must publish a grievance officer
// + a 24-hour acknowledgement SLA + a 15-day resolution SLA. We
// ship a public form that creates a ticket; the assigned grievance
// officer (admin role flagged via SiteSetting) actions it.
//
// Ack SLA is auto-met when an admin opens the ticket OR after 24h
// elapses (notification-maintenance tick — closes the window even
// if no human looked, so we can prove SLA compliance via audit log).
model GrievanceTicket {
  id               String          @id @default(cuid())
  /// Optional — anonymous grievances are allowed by IT Rules. When
  /// the filer is signed in we store the userId for follow-up.
  filerId          String?
  filer            User?           @relation("GrievanceFiler", fields: [filerId], references: [id], onDelete: SetNull)
  /// Required even for anonymous filings — used for the 24h ack
  /// email + correspondence.
  filerEmail       String
  filerName        String
  filerPhone       String?
  /// Free-text — what the user is complaining about. 2000 char cap.
  subject          String
  body             String          @db.Text
  /// Optional category — drives routing in the future. Free string
  /// for now.
  category         String?
  status           GrievanceStatus @default(OPEN)
  /// First admin to view / comment — sets ACK and stamps this.
  acknowledgedAt   DateTime?
  acknowledgedById String?
  /// The grievance officer assigned to action it. Initially null;
  /// set when an admin claims the ticket.
  assigneeId       String?
  assignee         User?           @relation("GrievanceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolution       String?         @db.Text
  /// Deadline for resolution (filed + 15 days). Stamped at create
  /// time so SLA reports work even after the rule changes.
  slaDueAt         DateTime
  /// Best-effort client IP captured at filing for forensics.
  filerIp          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([slaDueAt])
}

// ─── Job-match cache (candidate-side scoring) ─────────────────
//
// Persists the hybrid match-score breakdown for a (candidate, job)
// pair so the public job page can surface "87% match" without
// recomputing every view. The compute path runs the existing
// scoring engine (vector + skill jaccard + domain overlap +
// DIYguru boost) plus generates the top-3 reason chips with GPT-4o-mini.
//
// TTL is 7 days — long enough that a candidate revisiting a job
// they bookmarked last week sees the cached value, short enough
// that the score reflects recent profile edits (a candidate who
// added 5 new skills shouldn't see stale scores forever).
//
// One row per (candidate, job). When the candidate edits their
// profile we don't proactively invalidate — the next read past
// `expiresAt` will recompute. The 7-day stale window is acceptable
// because the score is advisory ("look here first"), not a gate.
model JobMatchCache {
  id          String           @id @default(cuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         JobPosting       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// 0..1 weighted score from server/matching/score.ts
  score       Float
  /// JSON breakdown: { vectorScore, skillScore, domainScore, diyguruBoost,
  /// matchedSkills: string[], reasons: { positive: string[], negative: string[] } }
  breakdown   Json
  computedAt  DateTime         @default(now())
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@unique([candidateId, jobId])
  @@index([candidateId, expiresAt])
  @@index([jobId, score])
}

// ─── Currency exchange-rate cache ─────────────────────────────
//
// Daily-refreshed FX table powering cross-country salary
// comparison. The `JobPosting.salaryUsdCanonical` value is
// computed from (salaryMin + salaryMax) / 2 converted via this
// table; the display layer converts back to the viewer's local
// currency on the way out. Why this exists:
//
//   • A UAE recruiter posts a job at AED 18,000-24,000/month.
//     A UK candidate browsing /jobs?country=AE wants to see
//     "£3,800-£5,100/month" in their feed — we need the FX rate
//     to render that on the server without a client API call.
//   • A multi-country employer wants to rank their pipeline by
//     compensation across markets — `salaryUsdCanonical` gives
//     them a single sortable dimension.
//
// One row per currency. The seed/refresh worker hits an FX
// provider (e.g. https://api.frankfurter.app/, free + no key)
// daily at 03:00 IST and upserts each row. `base = "USD"` always
// — the schema reserves the column so we could switch to EUR or
// INR base later without a migration.
//
// Why keyed on Country (not currency code): the platform thinks
// in countries; currency is one of many country-derived
// attributes (alongside timezone, language, etc.). Keying on
// Country gives us a single FK type across the codebase and
// avoids INR-vs-PKR confusion when we add new markets.
model ExchangeRate {
  /// Base currency for the rate. Always "USD" in v1; the column
  /// exists so a future "let's denominate in EUR for European
  /// expansion" doesn't require an ALTER.
  base      String   @default("USD")
  /// Country whose currency the `rate` quotes per 1 unit of `base`.
  /// E.g. for India (INR), rate ≈ 83.5 means 1 USD = 83.5 INR.
  quote     Country  @id
  rate      Float
  updatedAt DateTime @updatedAt
}

// ─── "Why this candidate" GPT explanation cache ───────────────
//
// Per-(job, candidate) cache of the GPT-4o-generated "why this
// candidate fits this job" explanation surfaced on the application
// detail page (and, in future, the matches page pre-application).
//
// Why a separate table from `Application.aiSummary`:
//   • `Application.aiSummary` is a *balanced triage verdict* — the
//     prompt calls out gaps and concerns alongside strengths so the
//     recruiter has a neutral read for the move/pass decision.
//   • This is a focused *make-the-case* explanation — what to tell
//     the hiring manager about why this person is worth the
//     interview slot. Different audience, different prompt, no
//     "concerns" surface.
//
// Keyed on `(jobId, candidateId)` not `applicationId` so the same
// row works on the matches page (where no Application exists yet —
// the recruiter is browsing pre-invite) and on the application
// detail page (after they've applied).
//
// Cache invalidation strategy: none automatic in v1. Recruiter can
// click "Refresh" to force a regenerate, which upserts the row. If
// we later want time-based staleness, add `expiresAt` like
// `JobMatchCache` and check it in the cache-read path.
model WhyCandidateExplanation {
  id                String           @id @default(cuid())
  jobId             String
  job               JobPosting       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// 3-4 sentence explanation. Plain text, ~400-600 chars typical.
  explanation       String           @db.Text
  /// Model name that produced this (e.g. "gpt-4o"). Lets us bump
  /// the cache on a model upgrade when reasoning quality jumps.
  model             String
  promptTokens      Int              @default(0)
  completionTokens  Int              @default(0)
  generatedAt       DateTime         @default(now())

  @@unique([jobId, candidateId])
  @@index([candidateId])
}

// ─── EV Industry Pulse aggregates ─────────────────────────────
//
// Daily snapshot of the platform numbers needed for the Pulse
// trend charts. The on-demand `lib/pulse.ts` helpers compute
// "right now" totals; this table gives us "the trend" — 30 days
// of daily counts to render the hiring-velocity sparkline and
// the comparable counts ("up 12% week-over-week") on /pulse.
//
// One row per (date, kind). Worker fires daily at 02:00 IST and
// upserts that day's row. We keep ~365 days then prune (handled
// by notification-maintenance cleanup tick).
enum PulseSnapshotKind {
  /// Count of NEW jobs published that calendar day (UTC).
  JOBS_NEW
  /// Count of NEW applications submitted that day.
  APPLICATIONS_NEW
  /// Count of HIRED stage transitions that day.
  HIRES
  /// Count of new candidate profiles created that day.
  CANDIDATES_NEW
  /// Count of OPEN jobs at end of day (snapshot).
  JOBS_OPEN_TOTAL
  /// Count of active companies (≥1 OPEN job) at end of day.
  COMPANIES_ACTIVE
}

model PulseSnapshot {
  id        String            @id @default(cuid())
  /// UTC midnight of the day this row covers.
  date      DateTime          @db.Date
  kind      PulseSnapshotKind
  value     Int
  /// Optional bucket — when `kind = JOBS_NEW` and we slice by EV
  /// domain we set this to the domain slug; otherwise empty string.
  /// Stored as `""` (not NULL) so Postgres's NULL-as-distinct rule
  /// can't break the unique constraint or let two rollup rows
  /// silently coexist for the same (date, kind).
  bucket    String            @default("")
  createdAt DateTime          @default(now())

  @@unique([date, kind, bucket])
  @@index([kind, date])
}

// ─── "Who's Moving" — public job-change announcements ─────────
//
// When a candidate updates their CURRENT employer (Experience.current
// flips from one company to another), the workers/processors/profile-
// changes worker writes a JobChangeAnnouncement. Visible only when
// the candidate opted in (announceJobChange flag on CandidateProfile)
// — defaults to OPT_IN required, since not everyone wants their move
// public.
//
// The /pulse page reads the latest 10 announcements that:
//   • are within the last 30 days
//   • the candidate's profile is still PUBLIC (cvVisibility = EVERYONE)
//   • the announcement is `published = true` (the candidate hasn't
//     since hidden it from /me/preferences)
model JobChangeAnnouncement {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// New employer — free text always (matches Experience.company).
  toCompany     String
  /// Optional FK to the canonical Company row when one exists.
  toCompanyId   String?
  toCompanyRef  Company?         @relation("JobChangeToCompany", fields: [toCompanyId], references: [id], onDelete: SetNull)
  toTitle       String
  /// Previous employer (free text). Nullable for the candidate's
  /// first job.
  fromCompany   String?
  fromTitle     String?
  /// User's authored note ("Excited to join — building the next-gen
  /// fast-charging stack"). 280 char cap so it fits the feed card.
  note          String?
  /// Whether the user wants the announcement on /pulse. Defaults to
  /// true; flip to false to retract without deleting (so we keep
  /// the audit row).
  published     Boolean          @default(true)
  /// Reactions count (mirrors Post — no separate Reaction table).
  congratsCount Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([candidateId, createdAt])
  @@index([published, createdAt])
}

// ─── RecruitmentDrive (multi-company job fair) ────────────────
//
// A time-bound public event where MULTIPLE companies participate.
// Distinct from CampusDrive (single company × one institution) —
// the recruitment-drive primitive models a city-level job fair like
// "Pune EV Job Fair · June 2026" with N companies, N challenges, a
// public landing, and a per-fair applicant queue per company.
//
// The event is admin-owned (the platform team curates the fair),
// not company-owned. Each participating company joins via the
// RecruitmentDriveCompany join table after admin invites them.
//
// Apply flow reuses the existing JobPosting + Application + ATS
// pipeline — `Application.recruitmentDriveId` is set automatically
// when a candidate applies via /fairs/[slug] so the recruiter can
// filter their ATS to "applicants from the fair." Optional per-job
// challenge step uses the existing Assessment model with
// `gateAdvance = true`.
enum RecruitmentDriveStatus {
  /// Admin is still drafting — invisible to public + employers.
  DRAFT
  /// Published, registration / company invites open.
  OPEN
  /// Fair is in progress (on-the-day status).
  IN_PROGRESS
  /// Past — keeps URL alive for SEO / recap.
  CLOSED
  /// Admin cancelled before it ran.
  CANCELLED
}

model RecruitmentDrive {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  tagline        String?
  /// Rich description (markdown / plain text). Renders on the
  /// public landing under the hero.
  description    String? @db.Text
  bannerImageUrl String?
  /// Optional secondary hero — the photo of the venue or last
  /// year's fair. Falls back to the brand gradient when null.
  heroImageUrl   String?

  // ─── Downloadable brochures ────────────────────────────────
  // PDF brochures linked from the public fair page. Two audience
  // variants so the right pitch (sponsor opportunities vs. cohort
  // partnerships) lands with the right reader. Both are public —
  // stored in the `logos` bucket with public-read ACL so the
  // download links work without a presign round-trip.
  /// Brochure aimed at hiring partners / employers. Covers booth
  /// packages, sponsor tiers, footfall stats, ROI from past editions.
  hiringPartnerBrochureUrl String?
  /// Brochure aimed at TPOs / colleges. Covers cohort onboarding,
  /// roster CSV import, expected outcomes, fair-day logistics.
  collegeBrochureUrl       String?

  /// Floor map image (PNG/JPEG/WEBP). Rendered on the public fair
  /// page so candidates can find their target booths before walking
  /// the venue. Booth labels live on RecruitmentDriveCompany.boothLabel;
  /// for v1 we don't model coordinates — admin uploads a marked-up
  /// image directly. v2 candidate: interactive booth-pin overlay.
  floorMapUrl              String?

  // ─── Venue ─────────────────────────────────────────────────
  city         String
  state        String?
  country      String   @default("IN")
  venueName    String?
  venueAddress String?
  /// Optional map pin so we can render an embedded map on the
  /// public page. Stored as Decimal so we don't lose precision on
  /// FP round-trips.
  venueLat     Decimal? @db.Decimal(10, 7)
  venueLng     Decimal? @db.Decimal(10, 7)

  // ─── Dates ─────────────────────────────────────────────────
  /// When the fair itself happens (start of day 1 of the event).
  startsAt             DateTime
  /// End of the event window. Same as startsAt for a one-day fair.
  endsAt               DateTime
  /// When candidate registration / job applications open. We use a
  /// separate window from the event itself so candidates can apply
  /// in advance — companies often want pre-screened pipelines
  /// before opening their booths.
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?

  // ─── Lifecycle ─────────────────────────────────────────────
  status      RecruitmentDriveStatus @default(DRAFT)
  publishedAt DateTime?
  /// When set, the fair appears in the homepage / pulse "featured
  /// events" rail. Admin-toggled.
  featuredAt  DateTime?

  // ─── Audit ─────────────────────────────────────────────────
  createdById String
  createdBy   User     @relation("RecruitmentDriveCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Denorm counters — kept fresh inside the same transactions
  /// that mutate the related rows. Saves the public landing from a
  /// COUNT(*) per render.
  participatingCount Int @default(0)
  jobsCount          Int @default(0)
  applicationsCount  Int @default(0)

  participatingCompanies RecruitmentDriveCompany[]
  driveJobs              RecruitmentDriveJob[]
  applications           Application[]
  /// Candidate attendance registrations (separate from applying to
  /// a job). See `RecruitmentDriveRegistration` for the rationale.
  registrations          RecruitmentDriveRegistration[]
  /// CSV bulk-invite batches an admin uploaded for this fair.
  rosterImports          RecruitmentDriveRosterImport[]
  /// Broadcasts that target this fair's audience (candidates / employers /
  /// TPOs registered for this drive). Powers the admin "blast a message
  /// to everyone registered" flow.
  broadcasts             Broadcast[]                    @relation("BroadcastTargetDrive")
  /// Per-fair industry tracks (#1 from the brochure additions).
  /// Defined by the admin at config time; surfaced as filter chips
  /// on the public fair page.
  tracks                 RecruitmentDriveTrack[]
  /// Denorm counter — kept in sync inside the registration server
  /// actions to save the public landing from COUNT(*) on every render.
  registeredCount        Int                            @default(0)
  checkedInCount         Int                            @default(0)

  // ─── Hiring-partner contact + FAQ (#4 from the brochure) ────────
  /// Single named point-of-contact rendered prominently on the
  /// public fair page sidebar — the brochure pattern of "Contact
  /// Muskan Kumari · WhatsApp +91…". Three plain strings so the
  /// admin form is two text inputs + a phone input. Null when the
  /// admin hasn't set them — the sidebar card hides cleanly.
  primaryContactName  String?
  primaryContactPhone String?
  primaryContactEmail String?
  /// FAQ accordion rendered below the open-roles section. JSON
  /// array of `{ q: string, a: string }` capped at ~12 entries by
  /// the admin editor. Null = no FAQ block surfaces. Markdown-free
  /// text — the brochure uses plain prose answers so we don't need
  /// rich-text rendering here.
  faq                 Json?

  // ─── Marketing-grade landing page additions ─────────────────────
  /// Admin-curated hero stat TARGETS (the brochure's "1,000+ /
  /// 50+ / 500+ / 5"). Pre-launch the real `registeredCount` and
  /// `participatingCount` are zero — showing real counts then would
  /// kill momentum, so the public page falls back to these targets
  /// until the real number exceeds them. Null = use the live count.
  heroStatCandidatesTarget Int?
  heroStatCompaniesTarget  Int?
  heroStatPositionsTarget  Int?
  /// Two parallel pitch-block JSON arrays — `[{ heading, body }]`.
  /// Brochure pattern: "Pre-Event / During Event / Post-Event"
  /// stack of value-prop blocks, with separate copy aimed at
  /// hiring partners vs candidates. Either / both can be null to
  /// hide the corresponding section.
  pitchForHiringPartners   Json?
  pitchForCandidates       Json?

  /// Speakers / leadership panel — see RecruitmentDriveSpeaker.
  speakers      RecruitmentDriveSpeaker[]
  /// Event-level endorsement partners (IIT Jammu, AICTE, ASDC,
  /// industry endorsements) — distinct from booth recruiters.
  eventPartners RecruitmentDriveEventPartner[]

  @@index([status, startsAt])
  @@index([city, startsAt])
}

/// A company's participation in a recruitment drive. The join is
/// a real model (not a pure many-to-many) because we carry per-row
/// state — invitation status, booth label, "what we're looking
/// for at this fair" pitch — that doesn't belong on either side.
enum RecruitmentDriveCompanyStatus {
  /// Admin invited, awaiting employer acceptance.
  INVITED
  /// Employer accepted — booth is live.
  CONFIRMED
  /// Employer declined or admin removed them.
  WITHDRAWN
}

model RecruitmentDriveCompany {
  id          String                        @id @default(cuid())
  driveId     String
  drive       RecruitmentDrive              @relation(fields: [driveId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company                       @relation("RecruitmentDriveCompany", fields: [companyId], references: [id], onDelete: Cascade)
  status      RecruitmentDriveCompanyStatus @default(INVITED)
  /// Display label for the booth ("Booth 7", "Hall B / Booth 12").
  /// Free text — admins can leave blank for virtual fairs.
  boothLabel  String?
  /// Per-fair pitch — different from Company.about, which is the
  /// permanent corporate copy. This is what the company is
  /// specifically looking for AT THIS FAIR ("hiring 5 battery
  /// engineers + 2 cell QA leads — talk to us at Booth 7").
  aboutAtFair String?                       @db.Text
  /// Set by admin on invite + on accept.
  invitedAt   DateTime                      @default(now())
  confirmedAt DateTime?
  withdrawnAt DateTime?

  // ─── Recruitathon inline-signup fields ─────────────────────
  // Captured when an employer self-registers for the fair via
  // /fairs/[slug]/register (vs being admin-invited). Nullable so
  // existing admin-invited rows don't need a backfill.
  /// Participation mode the employer is available for.
  fairMode             RecruitathonAvailability?
  /// Whether the employer is open to fresher candidates (vs lateral
  /// only). Used as a filter for candidates browsing employers AND
  /// for the admin's CSV export to placement team.
  hiresFreshers        Boolean?
  /// Whether the employer provides on-the-job training / structured
  /// onboarding programmes. Useful for candidates with no prior EV
  /// exposure looking for ramp-up support.
  providesTraining     Boolean?
  /// Free-text on growth opportunities ("Fast-track to Tech Lead in 2
  /// years; international exposure via Sweden + Germany office swaps").
  /// 2000 char cap enforced server-side.
  growthOpportunities  String?  @db.Text
  /// POC phone for fair-day coordination. POC name + email come from
  /// the linked User row; designation from EmployerProfile.
  pocPhone             String?
  /// Catch-all JSON for any additional self-registration form answers
  /// that don't have a structured column yet. Lets us iterate on the
  /// Recruitathon form without a migration per field add.
  formAnswers          Json?

  driveJobs      RecruitmentDriveJob[]
  /// Booth-level interview slots — see RecruitmentDriveInterviewSlot.
  interviewSlots RecruitmentDriveInterviewSlot[]

  @@unique([driveId, companyId])
  @@index([companyId, status])
}

// ─── Recruitathon availability mode ─────────────────────────────
// Tracks whether a fair participant (candidate OR employer) is
// available in-person at the venue, online via the virtual fair
// platform, or both. Drives the admin's CSV export to the placement
// team + the future routing logic that pairs offline candidates
// only with offline-available booths.
enum RecruitathonAvailability {
  OFFLINE
  ONLINE
  HYBRID
}

// ─── Booth interview slot booking (#3 in the brochure pack) ──────
//
// Brochure pattern: "Dedicated interview bay with company branding,
// AV support. Walk-in interviews begin at 10 AM — highest candidate
// footfall". Today the platform models the BOOTH (RecruitmentDriveCompany)
// but doesn't model the 30-minute interview window AT the booth.
//
// Recruiters create N slots per booth (single or bulk-generated
// every 30 min over the fair days). Registered candidates browse a
// booth's available slots + book one. Eligibility gate: candidate
// must be a registered fair attendee AND pass the fair eligibility
// check (60% + CV + phone + email).
//
// Idempotency: once a slot is BOOKED, its candidateId is set and
// subsequent book attempts return "already taken". Cancelling
// frees the slot back to AVAILABLE.

enum InterviewSlotStatus {
  AVAILABLE // Open to bookings
  BOOKED // Candidate locked in
  CANCELLED // Recruiter killed the slot
  COMPLETED // Recruiter marked interview done
  NO_SHOW // Candidate booked but didn't turn up
}

model RecruitmentDriveInterviewSlot {
  id              String                  @id @default(cuid())
  driveCompanyId  String
  driveCompany    RecruitmentDriveCompany @relation(fields: [driveCompanyId], references: [id], onDelete: Cascade)
  /// Optional job pin — slot scoped to a specific JobPosting at
  /// this booth. Null = generic "talk to us" slot any candidate
  /// can book regardless of which role they're after. Recruiter
  /// chooses at create time; defaults to null.
  jobId           String?
  job             JobPosting?             @relation("InterviewSlotJob", fields: [jobId], references: [id], onDelete: SetNull)
  startsAt        DateTime
  /// 30-minute default matches the brochure's "interview bay"
  /// cadence; recruiter can override per slot.
  durationMinutes Int                     @default(30)
  status          InterviewSlotStatus     @default(AVAILABLE)
  /// Booked-by candidate. Set on book, cleared on cancel. SetNull
  /// on candidate deletion so the audit trail ("slot was once
  /// booked, candidate later purged") survives.
  candidateId     String?
  candidate       CandidateProfile?       @relation("InterviewSlotCandidate", fields: [candidateId], references: [id], onDelete: SetNull)
  bookedAt        DateTime?
  cancelledAt     DateTime?
  /// Recruiter-private note about this slot (e.g. "panel of 2
  /// interviewers", "bring portfolio"). Surfaced to the candidate
  /// once booked.
  notes           String?                 @db.Text
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([driveCompanyId, startsAt])
  @@index([candidateId, startsAt])
  @@index([status, startsAt])
}

/// A specific JobPosting that a participating company is featuring
/// at the fair. One company can feature many jobs at one fair; the
/// same job can be at multiple fairs (e.g. Pune fair + Bangalore
/// fair) without duplicating the JobPosting row.
model RecruitmentDriveJob {
  id                    String                  @id @default(cuid())
  driveId               String
  drive                 RecruitmentDrive        @relation(fields: [driveId], references: [id], onDelete: Cascade)
  jobId                 String
  job                   JobPosting              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Denormalised so we can `where: { driveId, companyId }` in one
  /// query instead of joining to the participation row. Auto-set
  /// from JobPosting.companyId at attach-time.
  companyId             String
  company               Company                 @relation("RecruitmentDriveJobCompany", fields: [companyId], references: [id], onDelete: Cascade)
  participationId       String
  participation         RecruitmentDriveCompany @relation(fields: [participationId], references: [id], onDelete: Cascade)
  /// Optional pre-screening challenge. When set, applying triggers
  /// the existing ATS gate (Assessment.gateAdvance) — the candidate
  /// must complete the challenge before the recruiter can move them
  /// past ASSESSMENT stage.
  challengeAssessmentId String?
  challengeAssessment   Assessment?             @relation("RecruitmentDriveJobChallenge", fields: [challengeAssessmentId], references: [id], onDelete: SetNull)
  /// Optional fair-specific track grouping (e.g. "Battery",
  /// "Embedded", "Sales & Service"). Powers the candidate-side
  /// filter chips on the public fair page. SetNull on track
  /// deletion so removing a track doesn't cascade-delete jobs.
  trackId               String?
  track                 RecruitmentDriveTrack?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  /// Display order on the fair page (admin or company can sort
  /// hot jobs first). Defaults to row creation time.
  sortOrder             Int                     @default(0)
  attachedAt            DateTime                @default(now())

  @@unique([driveId, jobId])
  @@index([driveId, companyId])
  @@index([companyId])
  @@index([trackId])
}

// ─── Event-level endorsement partners ─────────────────────────────
//
// The brochure shows a distinct "Affiliations & Partners" panel
// — IIT Jammu (academic), AICTE / NEAT / ASDC (certifier/government),
// industry endorsements (Bosch / Hyundai / Maruti / Tata) that are
// NOT booth-running recruiters. Today the participatingCompanies
// list conflates "company running a booth" with "company endorsing
// the event" — separating them lets colleges and regulators see
// the trust signals without scrolling through a booth grid.
//
// Per-fair (not platform-wide) because the partner mix differs
// per edition — the Delhi fair lists Ministry of Skill Dev,
// Malaysia DSD, KSA SIMOPS; a Pune edition might lean on MSBTE
// + SPPU + Maharashtra ITI directorate.

enum RecruitmentDrivePartnerType {
  ACADEMIC // IIT Jammu, IISc, NIT Trichy, college boards
  GOVERNMENT // NSDC, Ministry of Skill Dev, state ITI directorates
  CERTIFIER // AICTE, ASDC, NEAT, ISO bodies
  INDUSTRY // Bosch, Hyundai — name-recognised endorsements
  ASSOCIATION // SIAM, ACMA, FICCI
  MEDIA // Trade press
  OTHER
}

model RecruitmentDriveEventPartner {
  id        String                      @id @default(cuid())
  driveId   String
  drive     RecruitmentDrive            @relation(fields: [driveId], references: [id], onDelete: Cascade)
  name      String
  type      RecruitmentDrivePartnerType @default(OTHER)
  /// Optional logo. When null, the public panel falls back to a
  /// text-pill ("IIT Jammu") so a brand-new fair without uploaded
  /// logos still surfaces the partners.
  logoUrl   String?
  /// Optional outbound URL (partner's homepage). When set, the
  /// panel renders the partner as an anchor target=_blank.
  url       String?
  /// Optional one-line context shown in the partner-card tooltip
  /// (e.g. "Patron institution", "Skill ecosystem alignment").
  caption   String?
  sortOrder Int                         @default(0)
  createdAt DateTime                    @default(now())

  @@index([driveId, type, sortOrder])
}

// ─── Speakers / leadership panel ─────────────────────────────────
//
// The brochure's "Event Leadership & Dignitaries" panel — Prof.
// B.K. Panigrahi (Patron), CEO (Event Chair), ASDC Dignitaries,
// L&D Head, Corporate Relations Head, Placement Executive.
//
// The role enum lets the admin classify each entry so the public
// page can group them (Patron → top, Speakers → grid, etc.) and
// so a future search ("fairs where Prof Panigrahi is speaking")
// can index on the column.

enum RecruitmentDriveSpeakerRole {
  PATRON // Honorary head — appears top of panel
  CHAIR // Event chair / organiser
  KEYNOTE // Headlining the opening or closing
  PANELIST // Part of a moderated panel
  DIGNITARY // Government / institutional rep
  SPEAKER // Generic — talks, workshop leads
  COORDINATOR // Operational POC (Corp Relations / Placement Executive)
}

model RecruitmentDriveSpeaker {
  id          String                      @id @default(cuid())
  driveId     String
  drive       RecruitmentDrive            @relation(fields: [driveId], references: [id], onDelete: Cascade)
  name        String
  /// Short title — "CEO, DIYguru", "Head L&D", "Placement Executive".
  title       String?
  /// Optional affiliation when distinct from the title — used when
  /// a speaker's company isn't part of the title, e.g. "Prof. BK
  /// Panigrahi · IIT Delhi CART · Patron & Mentor".
  affiliation String?
  /// Headshot URL. Null falls back to an initials-circle.
  photoUrl    String?
  /// Short bio for the hover-card / expanded view (1-2 sentences).
  bio         String?                     @db.Text
  role        RecruitmentDriveSpeakerRole @default(SPEAKER)
  /// Display order within the speaker panel (admin-controlled).
  sortOrder   Int                         @default(0)
  createdAt   DateTime                    @default(now())

  @@index([driveId, role, sortOrder])
}

/// Per-fair industry track (#1 of the brochure-driven additions).
/// A track is a slicing axis the admin defines at fair-creation —
/// the brochure example has 5: "Electric Vehicles", "Automotive &
/// OEMs", "Embedded Systems", "Manufacturing", "Sales & Service".
/// Each RecruitmentDriveJob optionally maps to one track; the
/// public fair page renders a filter-chip row driven by the track
/// list and a `?track=<slug>` query param.
///
/// Scoped per-fair (not platform-wide) because each fair tends to
/// theme its own track names — a powertrain-focused fair would
/// split into "Battery / Motor / Charging" instead of the 5 above.
/// Keeping the model fair-scoped lets organisers experiment without
/// polluting a global taxonomy.
model RecruitmentDriveTrack {
  id          String           @id @default(cuid())
  driveId     String
  drive       RecruitmentDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  /// Stable slug — used in `?track=<slug>` URLs so a shareable fair
  /// link can pre-filter to "show me the embedded-systems roles".
  slug        String
  /// Human-readable label shown on chips + job cards.
  name        String
  /// Optional accent colour for the chip (Tailwind class name fragment
  /// — e.g. "emce-mid", "amber-400", "rose-300"). Null falls back to
  /// the default chip styling.
  color       String?
  /// Optional one-line description rendered in the chip's tooltip
  /// and on a track's own filtered view header.
  description String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  jobs RecruitmentDriveJob[]

  @@unique([driveId, slug])
  @@index([driveId, sortOrder])
}

// ─── Fair attendee registration (#2 of the fair feature set) ───────
//
// Until now, a candidate "registered" for a fair only implicitly — by
// applying to a job attached to the fair. That's good for high-intent
// applicants but loses every browser who wanted to "just show up" or
// "browse the booths". This separate registration captures attendance
// intent without forcing a job pick at sign-up time.
//
// Each row produces a short, candidate-facing check-in code printed
// on the digital "fair pass" (a 6-char alphanumeric that's easier to
// read off a phone than a QR code; QR rendering can layer in later
// without changing this schema).
//
// The unique(driveId, candidateId) constraint enforces one
// registration per candidate per fair — second clicks idempotently
// no-op rather than creating duplicates.

enum RecruitmentDriveRegistrationStatus {
  /// Default — candidate signed up but hasn't checked in yet.
  REGISTERED
  /// Admin scanned the check-in code (or entered it manually) at
  /// the fair's reception. Stamps `checkedInAt` + `checkedInById`.
  CHECKED_IN
  /// Fair ended without the candidate checking in. Useful for
  /// recap analytics ("47% no-show rate") and for the candidate's
  /// own past-fair history. Stamped by a post-fair cron.
  NO_SHOW
  /// Candidate cancelled before the fair started.
  CANCELLED
}

model RecruitmentDriveRegistration {
  id            String                             @id @default(cuid())
  driveId       String
  drive         RecruitmentDrive                   @relation(fields: [driveId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     CandidateProfile                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Short alphanumeric (6 chars, 32-char alphabet — no I/O/0/1 to
  /// avoid mis-reads at the check-in desk). Minted at create. Unique
  /// across all registrations to keep the admin scanner's input
  /// unambiguous — no per-fair-namespace ambiguity to resolve.
  /// Format: `[A-HJ-NP-Z2-9]{6}`.
  checkInCode   String                             @unique
  /// Optional one-line answer to "what brings you to this fair?".
  /// Surfaced to recruiters who view the registration list so they
  /// can pre-target conversations ("Hi — I saw you wrote you're
  /// looking for BMS roles, our booth is in Hall B").
  intentNote    String?                            @db.Text
  status        RecruitmentDriveRegistrationStatus @default(REGISTERED)
  /// How the candidate landed on the fair — DIRECT = browsed
  /// /fairs/[slug] and clicked Register. ROSTER_IMPORT = an admin
  /// uploaded their email via the CSV import flow.
  /// RECRUITATHON_INLINE = registered via the public Recruitathon
  /// inline-signup form (creates the account + the registration in
  /// one shot — see /fairs/[slug]/register).
  source        String                             @default("DIRECT")
  // ─── Recruitathon inline-signup fields ─────────────────────
  // Captured at registration time via the public form. The candidate's
  // platform profile (CandidateProfile + Education + CandidateSkill +
  // Experience) holds the canonical data; these columns are a
  // fair-day snapshot so the admin CSV exports cleanly even before
  // the candidate completes their full profile.
  /// Participation mode the candidate is available for.
  fairMode      RecruitathonAvailability?
  /// Roles the candidate is targeting at this fair ("Battery Engineer,
  /// BMS Firmware, Vehicle Integration"). Free text — denormalised
  /// for the placement team's export.
  intendedRoles String?
  /// Cities the candidate is willing to relocate / commute to for the
  /// roles they're seeing at this fair. Free text — same shape as
  /// intendedRoles, easier to export than a relation.
  willingLocations String?
  /// Catch-all JSON for additional self-registration form answers
  /// (year of study, internship summary, EV-domain experience flag,
  /// etc). Lets us iterate without per-field migrations.
  formAnswers   Json?

  // ─── Pre-event reminder markers ────────────────────────────
  // Per-registration timestamps so the reminder worker (see
  // workers/processors/fair-reminders.ts) can fire each window
  // exactly once. Idempotent — re-run the worker as often as you
  // like; only un-stamped rows in the time window get pinged.
  reminderWeekBeforeSentAt DateTime?
  reminder3DaysSentAt      DateTime?
  reminderDayBeforeSentAt  DateTime?
  reminderHourBeforeSentAt DateTime?
  /// FK to the CollegePlacementCell whose invite link the candidate
  /// followed when they registered. Null when the candidate found
  /// the fair directly (no TPO referral). Powers the TPO dashboard's
  /// "candidates from my college" view. SetNull on cell delete so
  /// purging a TPO account doesn't cascade-wipe registration history.
  viaTpoCellId  String?
  viaTpoCell    CollegePlacementCell? @relation("RegistrationViaTpo", fields: [viaTpoCellId], references: [id], onDelete: SetNull)
  /// Set when the admin checks the candidate in at the venue.
  checkedInAt   DateTime?
  /// The admin user who scanned / entered the code. SetNull to
  /// preserve the check-in record if the admin account is later
  /// deleted (we still want "checked in by [removed user]").
  checkedInById String?
  checkedInBy   User?                              @relation("FairCheckInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  createdAt     DateTime                           @default(now())
  cancelledAt   DateTime?

  @@unique([driveId, candidateId])
  @@index([driveId, status])
  @@index([candidateId])
  @@index([viaTpoCellId])
}

// ─── Roster CSV import — "Bulk-invite a college's batch" ──────────
//
// Mirror of `DIYguruImportBatch`. Lets an admin upload a CSV of
// (email, optional name, optional college) tied to one fair. For
// each row we either find the existing candidate user or create a
// shell account + send an invite email; either way a
// RecruitmentDriveRegistration row lands in REGISTERED state with
// `source = "ROSTER_IMPORT"`. The job worker processes the CSV
// async so the admin doesn't hold an HTTP request for a 500-row
// upload.
//
// Tracks per-import counters so admin can verify everyone landed
// (`rowCount` = lines parsed, `invitedCount` = invites sent,
// `registeredCount` = successful registrations, `failedCount` =
// errors with a reason captured in `errorReport`).

model RecruitmentDriveRosterImport {
  id              String           @id @default(cuid())
  driveId         String
  drive           RecruitmentDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  uploadedById    String
  uploadedBy      User             @relation("FairRosterImporter", fields: [uploadedById], references: [id])
  fileUrl         String
  fileName        String?
  rowCount        Int              @default(0)
  invitedCount    Int              @default(0)
  registeredCount Int              @default(0)
  failedCount     Int              @default(0)
  /// JSON array of `{ row: number, email: string, reason: string }`
  /// — only populated when failedCount > 0. Helps admins audit which
  /// rows didn't import and why ("invalid email", "duplicate
  /// candidate", "user opt-out").
  errorReport     Json?
  uploadedAt      DateTime         @default(now())
  completedAt     DateTime?

  @@index([driveId, uploadedAt])
}

// ─── CompanyClaim — "I work here, prove me admin" workflow ────
//
// Bridges the gap between two existing onboarding paths:
//   1. Self-create — `createCompany` makes the user the owner.
//   2. Team invite — admin sends a TeamInvite, recipient accepts.
//
// Neither covers an EXISTING employee at a company that's already
// in our DB but where they don't know who the admin is (or there
// is no admin yet — the company was created by a third party who
// abandoned it). Without this workflow they'd have to email
// support; with it, they submit a claim, attach proof, and an
// admin reviews + on approval grants them an EmployerProfile +
// flips the Company to VERIFIED if it isn't already.
//
// Replaces the auto-attach path in `joinExistingCompany` (server/
// employer/actions.ts) — that action used to grant RECRUITER role
// on UNVERIFIED companies without proof, which let an attacker
// create e.g. "Tata Motors" as UNVERIFIED, self-attach as RECRUITER,
// and post jobs. Now every join goes through admin review.
enum CompanyClaimStatus {
  PENDING
  APPROVED
  REJECTED
  /// Claimant cancelled their own claim before admin acted.
  WITHDRAWN
}

model CompanyClaim {
  id             String  @id @default(cuid())
  companyId      String
  company        Company @relation("CompanyClaims", fields: [companyId], references: [id], onDelete: Cascade)
  claimantUserId String
  claimant       User    @relation("CompanyClaimant", fields: [claimantUserId], references: [id], onDelete: Cascade)

  // ─── Proof ────────────────────────────────────────────────
  /// Optional work email (ideally on the company's domain). When the
  /// domain matches `Company.emailDomains` the admin queue surfaces
  /// a green check so the reviewer can fast-path obvious matches.
  workEmail   String?
  /// Optional public LinkedIn URL — admin reads it to corroborate
  /// the role + tenure the claimant typed in `proofText`.
  linkedinUrl String?
  /// Free-text justification ("I'm Senior Battery Engineer reporting
  /// to Anita; my LinkedIn shows 3 years here"). 2000 char cap.
  proofText   String          @db.Text
  /// Role the claimant wants on approval. Defaults to RECRUITER
  /// (no admin permissions). Admin can override on approve.
  desiredRole CompanyTeamRole @default(RECRUITER)
  /// Job title the claimant uses inside the company. Cosmetic —
  /// shown on the team page after approval.
  designation String?

  // ─── Review state ─────────────────────────────────────────
  status       CompanyClaimStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?              @relation("CompanyClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Admin's free-text decision note. On REJECTED, this is sent in
  /// the rejection email so the claimant knows what to fix; on
  /// APPROVED it's optional and just lives in the audit trail.
  reviewerNote String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One open claim per (company, user). The unique implicitly
  // covers all statuses — re-submission after a REJECTED requires
  // admin to wipe the old row OR we can extend with a
  // "supersededAt" pattern in v2. For now, keep it tight.
  @@unique([companyId, claimantUserId])
  @@index([status, createdAt])
  @@index([claimantUserId])
}

// ─── Article CMS — curated knowledge-base content ────────────
//
// Distinct from `Post` (social feed, user-generated, conversational).
// `Article` is the editorial / knowledge-base / SEO layer:
//   • Admin-authored long-form pieces ("How a CCS connector works",
//     "BMS architecture cheat sheet", "What's the difference between
//     LFP and NMC batteries?").
//   • Indexed by Google for top-of-funnel discovery — a user-generated
//     Post will never rank for "ccs connector explainer", a curated
//     Article can.
//   • Categorised (battery / charging / motor / software / careers).
//   • FTS-searchable (uses 'simple' tokeniser + unaccent, same as
//     other searchable models — see scripts/setup-fts.sql).
//
// Single-author for v1 — articles attach to one User (author).
// Multi-author / contributor support (a la Healthandmedic's
// `articleAuthors` join) is a v2 if/when the editorial team grows.
//
// Lifecycle: DRAFT → PUBLISHED → ARCHIVED. PUBLISHED is the only
// public-visible state; ARCHIVED hides from the public index but
// keeps the URL alive for SEO / inbound link preservation.
enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ArticleCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Display order on the /articles index. Lower numbers float up.
  /// Two categories with the same order tie-break by name asc.
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]

  @@index([sortOrder, name])
}

model Article {
  id            String  @id @default(cuid())
  slug          String  @unique
  title         String
  /// Short description used as: SEO meta description, the index-card
  /// preview text, and the OpenGraph description. ~160 char cap so it
  /// fits search-result snippets cleanly.
  excerpt       String?
  /// Long-form body. Markdown for v1 (renders via the same pipeline
  /// as job-description bodies — already in lib/og/* helpers). HTML
  /// stored verbatim is also fine; we don't sanitise here, the
  /// renderer does.
  body          String  @db.Text
  /// Wide hero image — used both inline at the top of the article
  /// page AND as the OG share card. 1500×500 ideal (3:1).
  coverImageUrl String?

  // ─── Categorisation ───────────────────────────────────────
  categoryId String?
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Free-text tags — same conceptual shape as Post.hashtags.
  /// Used for "related articles" + future tag-cloud surfaces.
  tags       String[]         @default([])
  /// Countries this article targets — an array (not single value)
  /// because most articles work across multiple markets (a "Top 10
  /// EV employers" listicle covers UAE+UK+US simultaneously). The
  /// per-country landing pages (/uae, /uk, etc.) filter their
  /// "Related reading" rail on this; the country sitemap shards
  /// also use it. Default [IN] preserves existing articles' scope.
  targetCountries Country[]    @default([IN])

  // ─── Author ───────────────────────────────────────────────
  authorId String
  author   User   @relation("ArticleAuthor", fields: [authorId], references: [id])

  // ─── Lifecycle ────────────────────────────────────────────
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  /// When set, article appears in the homepage "Featured editorial"
  /// rail (a future surface). Admin-toggled.
  featuredAt  DateTime?

  // ─── Reader signals ───────────────────────────────────────
  /// Pre-computed reading time (minutes). Filled at create/update
  /// time using the body's word count ÷ 220 wpm. Avoids re-computing
  /// on every page render.
  readingTimeMins Int @default(3)
  /// Denormalised view counter — incremented inside a fire-and-forget
  /// update on the article-detail page. Used for "popular articles"
  /// rails.
  viewCount       Int @default(0)

  // ─── FTS — same pattern as our other searchable models ────
  searchTsv Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([authorId])
  @@index([featuredAt])
}

// ─── HashtagSubscription — "follow this topic" ────────────────
//
// User-followable channels driven by the existing Post.hashtags
// strings. Hashtags are emergent (extracted from post bodies via
// lib/social/extract.ts) — we deliberately don't have a separate
// `Hashtag` table. A subscription is just (userId, lowercase tag).
//
// The /feed "For you" tab joins on this table to surface posts
// whose hashtags array overlaps the user's subscribed tags. See
// server/social/queries.ts:getForYouFeed for the query shape.
//
// Channel-key namespace also covers Skill slugs and EVDomain slugs
// — they're stored as hashtag strings in this table without a FK
// (we don't enforce that "battery" exists as a Skill row before
// you can follow it). Lets a user follow #BMS or #LFP fluidly
// even if those slugs evolve in the Skill table later.
model HashtagSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("HashtagSubscriber", fields: [userId], references: [id], onDelete: Cascade)
  /// Lowercase, slugified ([a-z0-9][a-z0-9_-]{1,30}). Normalised
  /// at write-time via lib/social/hashtag.ts:normalizeHashtag so
  /// "Battery Engineering" and "battery-engineering" land on the
  /// same row.
  tag       String
  createdAt DateTime @default(now())

  @@unique([userId, tag])
  // Per-tag subscriber count + recent-subscribers query.
  @@index([tag, createdAt])
  // "Tags I follow" lookup on every feed render — needs to be fast.
  @@index([userId])
}

// ─── Profile views ────────────────────────────────────────────
//
// LinkedIn-style "Who viewed your profile". Each row is one viewer→
// viewed event, written fire-and-forget from the public profile
// page. We dedupe per (viewer, viewed) per 24h at the server-action
// layer (cheap because of the composite index), so refreshing the
// page or scrolling back doesn't inflate the counter.
//
// Privacy model:
//   • The VIEWER's `CandidateProfile.viewerVisibility` controls
//     whether their identity is recorded with the view. Setting it
//     to ANONYMOUS writes a row with `viewerUserId = null` and
//     `wasAnonymous = true` — the viewed user sees an anonymous
//     count but no identity. Same trade-off LinkedIn made.
//   • Logged-out viewers always count as anonymous.
//   • Self-views (viewer == viewed) are dropped at the writer level,
//     not stored.
//   • Viewers can't see their OWN audit (we don't expose a "who I
//     viewed" surface in v1) — only viewed users see their list.
//
// Source field is free-form ("feed", "search", "tag-page",
// "company-page-team", "post-author") so the UI can show "viewed
// from search" — useful for recruiters tuning their funnel later.
enum ViewerVisibility {
  VISIBLE // viewer's name + headline shown to the viewed user
  ANONYMOUS // viewed user sees "Someone in EV Engineering" — no identity
}

model ProfileView {
  id           String   @id @default(cuid())
  // The user whose profile was viewed.
  viewedUserId String
  viewedUser   User     @relation("ProfileViewed", fields: [viewedUserId], references: [id], onDelete: Cascade)
  // The viewer. Null for logged-out OR for viewers who chose
  // ANONYMOUS visibility — we deliberately don't store the FK so
  // anonymity holds even against a future schema audit.
  viewerUserId String?
  viewerUser   User?    @relation("ProfileViewer", fields: [viewerUserId], references: [id], onDelete: SetNull)
  /// Mirror of "viewerUserId IS NULL because we honoured anonymity"
  /// vs "viewerUserId IS NULL because no one was logged in". Lets
  /// the UI distinguish "Someone with a hidden identity viewed you"
  /// from "1 unknown view (signed-out)" without an extra join.
  wasAnonymous Boolean  @default(false)
  /// Free-form source label ("feed", "search", "tag", "post"). Helps
  /// the viewed user understand context ("you appeared in search").
  source       String?
  createdAt    DateTime @default(now())

  // Recent-views feed (the home page widget + /me/views detail page).
  // Ordered by createdAt desc with viewedUserId as the leading key.
  @@index([viewedUserId, createdAt])
  // 24-hour dedup query: SELECT 1 WHERE viewedUserId=? AND viewerUserId=?
  // AND createdAt >= NOW() - INTERVAL '1 day'. This compound index
  // turns it into a single index seek.
  @@index([viewedUserId, viewerUserId, createdAt])
  // Backfill / housekeeping — bulk delete views older than the
  // retention window (90d in v1). Indexed for the cron sweep.
  @@index([createdAt])
}

// ─── Pages (CMS) ──────────────────────────────────────────────
//
// Generic content-page surface — landing pages, FAQ, AI-tool
// landing decks, founder bios. Distinct from `Article` because
// articles assume an editorial pipeline (category, publishedAt,
// readingTimeMins, OG share images, listing on /articles); pages
// are evergreen, often free-form HTML, and don't appear in any
// listing index by default.
//
// Body is HTML. WordPress imports come in as raw HTML and we
// sanitise on the way in (see lib/cms/wordpress-import.ts) so we
// can render with dangerouslySetInnerHTML safely. Pages authored
// in-app via the admin form go through the same sanitiser.
//
// Slug is unique and unprefixed — the public route is /p/{slug}
// so platform routes (e.g. /jobs, /feed) can never collide with
// imported page slugs even if the WordPress site had a /jobs page.
enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Render mode for CMS pages. Two strategies, picked per-page
/// because imported WordPress / Elementor pages are usually full
/// HTML documents (with <style> targeting body { ... !important })
/// while hand-authored or simple-text pages are HTML fragments.
///
///   STANDALONE — body is a full HTML document; render in an
///                style-isolated iframe via srcdoc. SiteHeader +
///                SiteFooter still render around it. Default for
///                imported pages.
///   EMBEDDED   — body is an HTML fragment; render inline inside
///                our chrome with auto-injected title + excerpt.
///                Use for hand-written pages that should inherit
///                the platform's typography.
enum PageRenderMode {
  STANDALONE
  EMBEDDED
}

/// Where this page came from. Drives admin filters + the right
/// "edit" surface (a manual page goes to a rich editor; a WP-
/// imported page opens its source HTML for paste-style edits).
enum PageSourceKind {
  MANUAL // Hand-authored via /admin/pages/new
  WP_PAGE // Imported from a WP <wp:post_type>page</wp:post_type>
  WP_POST // Imported from a WP <wp:post_type>post</wp:post_type>
}

model Page {
  id              String         @id @default(cuid())
  slug            String         @unique
  title           String
  /// SEO meta description + index-card preview. ~160 chars.
  excerpt         String?        @db.Text
  /// Sanitised HTML. Stored verbatim and rendered via
  /// dangerouslySetInnerHTML — the sanitiser at write-time is the
  /// trust boundary, not the renderer.
  body            String         @db.Text
  /// Optional hero image. Used as inline cover and as the OG card.
  coverImageUrl   String?
  status          PageStatus     @default(DRAFT)
  /// See PageRenderMode comment. Defaults STANDALONE so freshly
  /// imported Elementor / Gutenberg pages render in their own
  /// style-isolated iframe out of the box.
  renderMode      PageRenderMode @default(STANDALONE)
  /// Tracks where this Page row originated. Imports tag rows
  /// WP_PAGE / WP_POST so an admin filter ("imports vs hand-written")
  /// is one query.
  sourceKind      PageSourceKind @default(MANUAL)
  /// Trusted-scripts mode for AI-tool landing pages. When TRUE:
  ///   • Sanitiser preserves <script> tags on save.
  ///   • Iframe sandbox includes `allow-same-origin` so the page
  ///     can fetch /api/ai/proxy as same-origin (no CORS handshake)
  ///     and use relative URLs.
  /// When FALSE (default): scripts are stripped; iframe stays in
  /// strict opaque-origin sandbox. Only an ADMIN can flip this.
  allowScripts    Boolean        @default(false)
  publishedAt     DateTime?
  /// Per-page SEO overrides. When null, fall back to title/excerpt.
  metaTitle       String?
  metaDescription String?        @db.Text

  // Provenance — link back to the WordPress import that birthed
  // this row, so admins can re-import + diff, or bulk-archive
  // pages from a bad import without nuking hand-authored ones.
  importBatchId String?
  importBatch   WordPressImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /// Source `<wp:post_id>` from the WP XML. Lets re-imports
  /// match-and-update by stable ID instead of slug (which a WP
  /// admin can rename without warning). Unique per batch but not
  /// globally unique — different WordPress sites could collide.
  wpPostId      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Public listing on /admin/pages defaults to status + recency.
  @@index([status, updatedAt])
  // Re-import lookup — per batch we match on wpPostId.
  @@index([importBatchId, wpPostId])
  // Admin filter ("show only WP-imported posts").
  @@index([sourceKind, updatedAt])
}

model WordPressImportBatch {
  id            String  @id @default(cuid())
  /// Filename the admin uploaded. Surface only — not unique.
  fileName      String
  /// SHA-256 of the uploaded XML. Lets us refuse a re-upload of
  /// the same exact file (idempotency check) and audit which
  /// payload produced which page set.
  fileSha256    String
  uploadedById  String
  uploadedBy    User    @relation("WordPressImporter", fields: [uploadedById], references: [id])
  /// Counts after parse.
  itemsTotal    Int
  itemsImported Int
  itemsSkipped  Int
  /// Free-form notes on what was skipped + why ("3 attachments
  /// ignored", "1 page had empty body"). Truncated to 4KB; full
  /// detail goes to the structured logger.
  notes         String? @db.Text

  pages Page[]

  createdAt DateTime @default(now())

  @@index([uploadedById, createdAt])
}

// ─── AI Interview Practice ─────────────────────────────────────
// Candidate-facing mock-interview tools — "Embedded Mock Interview"
// (open-ended practice) and "EV Interview Simulator" (role-play
// against a specific company + role). Both share the same engine;
// the only on-disk difference is `kind` + the scenario fields.

enum InterviewSessionKind {
  /// Open-ended technical / behavioural practice. Candidate picks
  /// role + experience level; the AI plays a generic interviewer.
  MOCK
  /// Scenario role-play. Candidate picks a target company + role;
  /// the AI plays a named interviewer persona at that company.
  SIMULATOR
}

enum InterviewSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model InterviewSession {
  id     String  @id @default(cuid())
  /// Null for anonymous practice runs — the page lets signed-out
  /// visitors try the tool before signing up. On signup we don't
  /// claim back anon sessions (transient practice content).
  userId String?
  user   User?   @relation("InterviewSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  kind   InterviewSessionKind
  status InterviewSessionStatus @default(ACTIVE)

  /// Target role string. Free-form so we can index whatever the
  /// user types ("Battery Engineer", "BMS Firmware Lead").
  targetRole     String
  /// Experience tier the interviewer should pitch the questions at.
  /// Matches SeniorityLevel values but stored as a free-form string
  /// to avoid a coupling that would force us to migrate when one
  /// side changes.
  seniorityLevel String  @default("MID")
  /// EV domain slug (battery-tech, motor-control, …). Optional —
  /// when set, the system prompt nudges the AI to ask domain-
  /// specific questions instead of generic EV-industry ones.
  evDomainSlug   String?

  /// SIMULATOR-only: company being role-played + interviewer
  /// persona ("tough technical lead", "warm HR generalist"). MOCK
  /// sessions leave both null.
  targetCompany      String?
  interviewerPersona String?

  /// Transcript. JSON array of { role: "user" | "assistant",
  /// content: string, ts: ISO string } messages, oldest-first.
  /// Kept in-row instead of a separate Message table because
  /// practice sessions are short and never queried out-of-order.
  messages Json @default("[]")

  /// Filled by the summarise pass after the candidate ends the
  /// session. Mirrors the RoastResult shape so the same UI
  /// components can render both.
  scoreOverall   Int?
  scoreBreakdown Json?
  feedback       Json?
  summary        String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

// ─── AI CV Evaluation ──────────────────────────────────────────
// Deep section-by-section CV analysis — beefier sibling of the
// Roast Resume tool. Roast is a short viral hook (single 0-100
// score + 3-5 fix items); Expert Evaluation reads every section
// and produces rewrite suggestions per bullet. We persist runs
// so the candidate can revisit + share.

model CvEvaluation {
  id              String   @id @default(cuid())
  /// Null for anonymous runs — same pattern as ResumeRoast.
  userId          String?
  user            User?    @relation("CvEvaluationUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Anonymous-session cookie. Lets a signed-out visitor return to
  /// past evaluations from the same browser without a real account.
  anonId          String?
  /// 0-100 overall — same shape as Roast so the result-card UI
  /// reuses cleanly.
  scoreOverall    Int
  /// Per-section JSON ([{ section, score, observation, rewrites: [] }]).
  /// Stored as JSON so the schema can evolve without a migration
  /// every time the result shape changes.
  sectionAnalysis Json
  /// Top 3 things the candidate should fix first — the high-
  /// signal subset of the full analysis.
  topFixes        Json
  /// Length of input text we parsed. Used for sanity checks +
  /// "scored across N characters" line on the result page.
  textLength      Int
  /// Optional target role / EV domain the candidate said they
  /// were aiming for. Helps shape the evaluation's tone.
  targetRole      String?
  evDomainSlug    String?
  ip              String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([anonId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Wave C — Agentic + Differentiators (#14, #16, #22, #23, #26, #28, #29)
//
// The "2026 bar" feature wave. These models support:
//   - #14 EV Career Explorer (no schema needed; pure AI, but caches
//     stored in CareerExplorationLog for the user's own history.)
//   - #16 Vernacular AI Calling Agent (CallingSession + CallingMessage
//     for the structured voice screen + transcript.)
//   - #22 AI Hiring Assistant (HiringAssistantConfig + HiringAssistantRun
//     for per-job agentic loop state.)
//   - #23 Automation Rules (PipelineAutomation rule rows; PipelineAutomationLog
//     for the audit trail of every rule-firing.)
//   - #26 Best EV Employer Award (CompanyReview crowd-sourced reviews +
//     EmployerAward computed yearly).
//   - #28 Verified Skill Assessments (extends existing Assessment via
//     SkillAssessmentMeta sidecar — Assessment already has `isLibrary`
//     so we don't duplicate the core MCQ row; the sidecar adds the
//     EV-skill metadata + badge surfacing.)
//   - #29 EV facet filters (new fields on JobPosting + CandidateProfile;
//     see below — separate from the new tables for visibility).
// ═══════════════════════════════════════════════════════════════════

// ─── #29 EV facet filters ───────────────────────────────────────────
//
// Powertrain area — a recruiter slices EV jobs by where on the EV
// stack they live. Pulled out of free-text "skills" so /jobs and
// /employer/candidates can render a first-class facet pill row.

enum PowertrainArea {
  BATTERY
  BMS
  MOTOR
  CHARGING
  POWER_ELECTRONICS
  VEHICLE_INTEGRATION
  SOFTWARE
  MANUFACTURING
  AFTER_SALES
  OTHER
}

// Company tier — pulled separately from `Company.companyType` because
// the existing enum mixes "type" (battery/charging/fleet) with "tier"
// (OEM/startup). New filter UX wants both axes.
enum CompanyTier {
  OEM
  TIER1_SUPPLIER
  TIER2_SUPPLIER
  STARTUP
  CHARGING_OPERATOR
  RESEARCH_INSTITUTE
  CONSULTING
  OTHER
}

// ─── Company enrichment proposals (admin-review queue) ────────────
//
// Background workers fetch web-verified data (logos from Logo.dev,
// summaries from Wikipedia, etc.) and write a proposal here instead
// of mutating the Company row directly. An admin reviews the diff
// (current vs proposed) at /admin/companies/enrichment-queue and
// chooses APPROVE / EDIT-AND-APPROVE / REJECT.
//
// Design notes:
//   • One row per (companyId, source) pair — re-fetches replace the
//     same row via upsert, so the queue stays clean.
//   • `proposedFields` is a JSON blob — only the fields the source
//     actually surfaced are present. The approve action merges them
//     onto the Company; unset keys leave the existing column alone.
//   • `appliedFields` records what was actually written after admin
//     review (may differ from `proposedFields` if the admin edited
//     before approving). Audit trail for "why is X showing on the
//     company page".
//   • `rawSources` keeps the unparsed payload from each fetcher for
//     debugging — useful when admins flag "this looks wrong, what did
//     the API actually return".

enum EnrichmentProposalStatus {
  PENDING // newly written by the worker, awaiting admin review
  APPROVED // admin approved; fields applied to the Company row
  REJECTED // admin rejected; no fields applied
  ERROR // worker failed to fetch — see `errorMessage`
}

enum EnrichmentSource {
  LOGO_DEV
  WIKIPEDIA
  COMPOSITE // multi-source merged proposal (default)
}

model CompanyEnrichmentProposal {
  id        String                   @id @default(cuid())
  companyId String
  company   Company                  @relation("CompanyEnrichmentProposals", fields: [companyId], references: [id], onDelete: Cascade)
  source    EnrichmentSource         @default(COMPOSITE)
  status    EnrichmentProposalStatus @default(PENDING)

  /// Proposed values keyed by Company column. Shape:
  ///   { logoUrl?, description?, about?, foundedYear?, linkedinUrl?,
  ///     twitterUrl?, facebookUrl?, website? }
  /// Only keys the worker actually populated are present.
  proposedFields Json

  /// Raw fetched payloads keyed by source name. Stored verbatim for
  /// admin debugging — never rendered on the company page.
  rawSources Json?

  /// Worker's self-assessment of confidence in the proposed values
  /// (0–100). High = all sources agreed; low = sparse / conflicting.
  /// Drives the badge colour in the admin queue.
  confidence Int @default(50)

  /// Set when an admin reviews. APPROVED → `reviewedAt` is filled +
  /// `appliedFields` records what actually landed on Company. REJECTED
  /// → `rejectionReason` is filled for the audit trail.
  reviewedById    String?
  reviewedBy      User?     @relation("CompanyEnrichmentReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  appliedFields   Json?
  rejectionReason String?   @db.Text

  /// Populated only when status = ERROR. The worker writes the error
  /// message here so admins can see why a row never reached PENDING.
  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Newest-first paginated queue view sorts by createdAt within
  // a status filter — covering index serves both filters.
  @@index([status, createdAt])
  @@index([companyId])
}

// ─── #28 Verified Skill Assessments ─────────────────────────────────
//
// `Assessment` already supports standalone library assessments via
// `isLibrary=true` + `jobId=null`. This sidecar adds the EV-skill
// metadata + the "what badge does completion earn" pointer. Keeping
// it a sidecar (rather than columns on Assessment) keeps the existing
// job-scoped MCQ flow untouched and lets us surface skill-library
// assessments separately in the UI.

enum SkillAssessmentDifficulty {
  FOUNDATION // ~30 min; verifies the basics. Almost any engineer can clear.
  INTERMEDIATE // ~45 min; hands-on practitioner level.
  ADVANCED // ~60 min; specialist signal. Few candidates clear.
}

model SkillAssessmentMeta {
  id               String                    @id @default(cuid())
  assessmentId     String                    @unique
  assessment       Assessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Stable slug for the URL — e.g. "battery-fundamentals",
  /// "bms-architecture", "ccs-charging-protocols". Used in
  /// `/skills/[slug]/take` + lookup keys for badge filters.
  slug             String                    @unique
  /// EV domain this skill assessment belongs to. Drives the browse
  /// page's grouping ("Battery", "Charging", etc.) and powers the
  /// recruiter filter "candidate verified in {domain}".
  evDomainSlug     String
  difficulty       SkillAssessmentDifficulty @default(INTERMEDIATE)
  /// Marketing blurb for the browse card. ~140 chars.
  blurb            String                    @db.Text
  /// Estimated minutes — shown on the take-this-assessment card before
  /// the candidate commits.
  estimatedMinutes Int                       @default(30)
  /// Suggested prep links (3-5 URLs). Renders as "Brush up" hints
  /// before the test starts. JSON: `[{title, url}]`.
  prepLinks        Json?
  /// Score % at or above which the candidate earns the badge. Defaults
  /// to 70 — distinct from the underlying Assessment.passingScore which
  /// may be lower for in-application MCQs.
  badgeThreshold   Int                       @default(70)
  /// Recruiter-visible weight — drives the boost in candidate search
  /// rank when a recruiter filters by "verified in X". 1-5.
  recruiterWeight  Int                       @default(3)
  /// Public flag — admin-only assessments stay hidden from browse.
  isPublic         Boolean                   @default(true)
  /// Sort order in the browse page within an EV domain group.
  sortOrder        Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  earnedBadges VerifiedSkillBadge[]

  @@index([evDomainSlug, isPublic])
  @@index([difficulty])
}

model VerifiedSkillBadge {
  id          String              @id @default(cuid())
  candidateId String
  candidate   CandidateProfile    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  metaId      String
  meta        SkillAssessmentMeta @relation(fields: [metaId], references: [id], onDelete: Cascade)
  /// Source attempt — the AssessmentAttempt that earned the badge.
  /// Lets the recruiter click through to the score breakdown.
  /// Cascade-on-delete: if the attempt is purged (GDPR erasure or
  /// data hygiene), the badge it earned goes with it. The score is
  /// already denormalised below, so the user-facing badge surface
  /// doesn't depend on the attempt row to render.
  attemptId   String              @unique
  attempt     AssessmentAttempt   @relation("BadgeSourceAttempt", fields: [attemptId], references: [id], onDelete: Cascade)
  /// Snapshot of the score % at award time. Keeping it denormalised
  /// means we don't have to JOIN AssessmentAttempt on every badge
  /// surface render.
  score       Int
  /// Optional expiry — for skills where the field moves fast (e.g.
  /// CCS protocols, OTA software) we may re-issue badges every 24 mo.
  /// Null = never expires.
  expiresAt   DateTime?
  earnedAt    DateTime            @default(now())

  @@unique([candidateId, metaId])
  @@index([candidateId])
  @@index([metaId])
}

// ─── #23 Automation Rules ───────────────────────────────────────────
//
// Cutshort-style "if X then Y" rules a recruiter sets per job (or
// company-wide). Triggers run inside the Application server actions
// (apply / stage-change) — synchronous "evaluate matching rules" pass
// that either auto-moves the application, posts an in-app notice to the
// recruiter team, or fires a templated message to the candidate.

enum AutomationTrigger {
  APPLICATION_RECEIVED // fires when a new application lands
  STAGE_CHANGED // fires when an existing application moves
}

enum AutomationAction {
  AUTO_MOVE_STAGE // move the application to a given stage
  NOTIFY_TEAM // ping the recruiter inbox
  SEND_TEMPLATE // send a templated message to the candidate
  REJECT_WITH_REASON // move to REJECTED + send the candidate a kind note
}

model PipelineAutomation {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Nullable — when null, the rule applies to ALL jobs in the company.
  /// When set, it scopes to one job only. Lets a recruiter say
  /// "auto-move 80%+ matches to Shortlisted across every BMS role"
  /// at the company level OR "for THIS senior battery role only".
  jobId         String?
  job           JobPosting?       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Recruiter who created the rule. Nullable + SetNull so deleting
  /// the creator (e.g. recruiter leaves the company) doesn't take the
  /// company-level automation down with them — the rule belongs to
  /// the company, not the individual.
  createdById   String?
  createdBy     User?             @relation("AutomationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Human-readable name for the rules UI — "Auto-shortlist DIYguru
  /// + 80% match".
  label         String
  trigger       AutomationTrigger
  /// Conditions JSON. Shape (initial v1, can grow):
  ///   {
  ///     matchScoreMin?: 0..1,
  ///     mustBeDIYguruVerified?: boolean,
  ///     mustHaveSkills?: string[],          // skill slugs
  ///     mustHaveVerifiedBadge?: string[],   // SkillAssessmentMeta slugs
  ///     locationsAny?: string[],
  ///     evDomainsAny?: string[],
  ///     experienceMin?: number,             // months
  ///     fromStage?: ApplicationStage,       // for STAGE_CHANGED
  ///     toStage?: ApplicationStage,         // for STAGE_CHANGED
  ///   }
  /// All conditions AND together; arrays are "at least one of".
  conditions    Json
  action        AutomationAction
  /// Action payload shape, again JSON:
  ///   AUTO_MOVE_STAGE: { toStage: ApplicationStage, reason?: string }
  ///   NOTIFY_TEAM:     { message: string }
  ///   SEND_TEMPLATE:   { subject?: string, body: string }
  ///   REJECT_WITH_REASON: { reason: string }
  actionPayload Json
  enabled       Boolean           @default(true)
  /// Audit counters — surface "fired 14 times this week" on the rule card.
  runCount      Int               @default(0)
  lastRunAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  logs PipelineAutomationLog[]

  @@index([companyId, enabled])
  @@index([jobId])
}

model PipelineAutomationLog {
  id            String             @id @default(cuid())
  automationId  String
  automation    PipelineAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  /// Application this log row evaluated. Cascade-on-delete because
  /// log rows reference a single application and lose meaning if the
  /// application disappears (GDPR erasure, candidate-side withdraw
  /// then purge). Was a bare String before — caused dangling refs
  /// when applications were hard-deleted.
  applicationId String
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// Whether the rule actually fired (true) or just evaluated and
  /// no-op'd (false). Lets us answer "how many candidates did this
  /// rule actually touch" vs "how many did it consider".
  fired         Boolean
  /// JSON snapshot of the inputs used + the decision taken — for the
  /// rule audit trail. ~1 KB / row in practice.
  snapshot      Json
  createdAt     DateTime           @default(now())

  @@index([automationId, createdAt])
  @@index([applicationId])
}

// ─── #22 AI Hiring Assistant ────────────────────────────────────────
//
// Per-job agentic configuration. The daily worker tick picks up every
// HiringAssistantConfig with `enabled=true` and runs:
//   1. Rank fresh applications by match score (uses #28 verified
//      badges as a positive signal).
//   2. Draft personalised first-touch outreach for the top N who
//      haven't been messaged yet.
//   3. Chase non-responders on a configurable cadence (followUpAfterDays).
//
// Each run produces a HiringAssistantRun row with a structured summary
// — that's what the recruiter sees as "Your hiring assistant did X
// yesterday" on the dashboard.

model HiringAssistantConfig {
  id                 String     @id @default(cuid())
  jobId              String     @unique
  job                JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Recruiter who enabled the assistant. Nullable + SetNull so
  /// the config persists if that recruiter leaves the company. The
  /// daily worker tick still runs it on behalf of the company —
  /// the run draft messages use the company's display name rather
  /// than the original owner's identity when this is null.
  enabledById        String?
  enabledBy          User?      @relation("HiringAssistantOwner", fields: [enabledById], references: [id], onDelete: SetNull)
  enabled            Boolean    @default(true)
  /// How many of the top-ranked candidates to draft outreach for on
  /// each tick. Default 5 — small enough to feel curated, large enough
  /// to keep the funnel warm.
  draftBatchSize     Int        @default(5)
  /// Days to wait before the assistant chases a non-responder. Null =
  /// no chase. Default 4 days mirrors LinkedIn Recruiter's default.
  followUpAfterDays  Int?       @default(4)
  /// Tone of the drafted outreach. Drives the system prompt.
  /// FORMAL / WARM / CASUAL.
  tone               String     @default("WARM")
  /// Hard cap on outreach per tick — even if the model wants to
  /// message more candidates, we never exceed this. Cost guardrail.
  maxOutreachPerTick Int        @default(10)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  runs HiringAssistantRun[]

  @@index([enabled])
}

enum HiringAssistantRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model HiringAssistantRun {
  id           String                   @id @default(cuid())
  configId     String
  config       HiringAssistantConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  status       HiringAssistantRunStatus @default(PENDING)
  /// Counts surfaced in the recruiter summary card.
  rankedCount  Int                      @default(0)
  draftedCount Int                      @default(0)
  chasedCount  Int                      @default(0)
  /// Total OpenAI tokens used by this run — feeds the company-level
  /// cost dashboard. trackAICall populates AICostLog separately; this
  /// is the rolled-up summary shown to the recruiter.
  tokensUsed   Int                      @default(0)
  /// Natural-language summary the assistant generated for the
  /// recruiter ("I drafted 5 outreach messages and chased 3
  /// non-responders. Top candidate this round: Asha Singh (94% match,
  /// verified BMS, 4 yrs Ola)."). 1-2 short paragraphs.
  summary      String?                  @db.Text
  /// Detailed breakdown JSON: per-candidate decisions, drafted message
  /// preview, errors. ~5-10 KB.
  detail       Json?
  startedAt    DateTime                 @default(now())
  finishedAt   DateTime?
  errorMessage String?                  @db.Text

  @@index([configId, startedAt])
}

// ─── #16 Vernacular AI Calling Agent ────────────────────────────────
//
// Stub for the phone-screening pipeline. A recruiter triggers a
// "screen this candidate by phone" task → the calling worker picks it
// up → calls the candidate in their preferred language → runs a
// structured 5-question screen → transcribes + scores → drops a
// summary into the ATS. Provider-agnostic: the call gateway is
// abstracted in `lib/calling/provider.ts`. Initial provider: Exotel
// (India-first). Twilio is a drop-in alternative.

enum CallingSessionStatus {
  QUEUED // Created, waiting for the worker to pick up
  DIALING // Provider has started the call
  IN_PROGRESS // Connected; questions in progress
  COMPLETED // Both parties hung up, transcript stored
  FAILED // Provider error, no-answer, voicemail
  CANCELLED // Recruiter cancelled before dial
}

enum CallingLanguage {
  EN_IN
  HI_IN
  TA_IN
  TE_IN
  KN_IN
  MR_IN
  GU_IN
  BN_IN
  PA_IN
  ML_IN
}

model CallingSession {
  id              String               @id @default(cuid())
  /// Application being screened. Nullable so a recruiter could screen
  /// a sourced candidate before any application exists.
  applicationId   String?
  application     Application?         @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  candidateId     String
  candidate       CandidateProfile     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId           String?
  job             JobPosting?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Recruiter who triggered the call. Nullable + SetNull so the
  /// audit trail (transcript, fit score, summary) survives the
  /// triggering recruiter's account deletion.
  triggeredById   String?
  triggeredBy     User?                @relation("CallingTriggerer", fields: [triggeredById], references: [id], onDelete: SetNull)
  language        CallingLanguage      @default(HI_IN)
  /// Question script the assistant follows. Each item: `{ id, text }`.
  /// Recruiter customises per job. We auto-suggest a script from the
  /// job description on first run.
  script          Json
  status          CallingSessionStatus @default(QUEUED)
  /// Provider-specific call session ID (returned by Exotel /
  /// Twilio's call-initiate API). Used to correlate webhook events
  /// back to our row.
  providerCallSid String?
  providerName    String? // "exotel" | "twilio" — for analytics + provider migration
  /// Whisper/Deepgram ASR transcript — raw text. Stored alongside the
  /// structured messages because the structured shape only captures
  /// the per-question Q&A, not the candidate's pre-introduction or
  /// post-thank-you remarks which can still be useful for the recruiter.
  rawTranscript   String?              @db.Text
  /// Overall fit score 0-100 produced by a GPT-4o pass over the
  /// transcript with the job description as context.
  fitScore        Int?
  /// 1-2 sentence summary the recruiter sees in their ATS.
  summary         String?              @db.Text
  /// Cost in USD micros, like AICostLog — call cost + ASR cost + LLM
  /// scoring cost rolled up.
  costUsdMicros   Int                  @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  messages CallingMessage[]

  @@index([candidateId, createdAt])
  @@index([jobId, createdAt])
  @@index([status])
  @@index([providerCallSid])
}

enum CallingSpeaker {
  ASSISTANT
  CANDIDATE
}

model CallingMessage {
  id         String         @id @default(cuid())
  sessionId  String
  session    CallingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker    CallingSpeaker
  /// Original spoken text in the vernacular language.
  text       String         @db.Text
  /// English translation — produced by the same Whisper pass via
  /// `translate=true` flag. Lets recruiters who don't speak the
  /// candidate's language still skim the transcript.
  textEn     String?        @db.Text
  /// Question ID this turn corresponds to (from CallingSession.script).
  /// Null on free-form intro / closing turns.
  questionId String?
  /// Speech segment timing — milliseconds from call start. Lets us
  /// scrub the audio at the right point if we ever surface the
  /// recording in the recruiter UI.
  startedMs  Int?
  endedMs    Int?
  createdAt  DateTime       @default(now())

  @@index([sessionId, createdAt])
}

// ─── #26 Best EV Employer Award ─────────────────────────────────────
//
// Glassdoor-style "Best Places to Work", but EV-vertical. Two pieces:
//   1. CompanyReview — anonymous-friendly crowd-sourced reviews
//      contributing to the ranking signal.
//   2. EmployerAward — the computed yearly badge, displayed on the
//      company profile + a public /awards page.

enum CompanyReviewStatus {
  PENDING // Submitted, awaiting moderation
  PUBLISHED // Live on the company profile
  REJECTED // Moderation rejected (spam / personal attack)
  WITHDRAWN // Reviewer asked to remove
}

enum ReviewerRelationship {
  CURRENT_EMPLOYEE
  FORMER_EMPLOYEE
  INTERN
  CONTRACTOR
  INTERVIEWED // Made it to interview, didn't join
}

model CompanyReview {
  id                 String               @id @default(cuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Nullable — anonymous reviews are allowed but moderated more
  /// strictly. Signed-in reviewers get a "verified employee" green
  /// dot when their EmployerProfile.companyId matches.
  reviewerUserId     String?
  reviewerUser       User?                @relation("CompanyReviewAuthor", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  relationship       ReviewerRelationship
  /// 1-5 each — drives the per-axis breakdown on the company profile.
  /// All required so the aggregate ranking is consistent.
  cultureRating      Int
  compensationRating Int
  managementRating   Int
  growthRating       Int
  workLifeRating     Int
  /// 1-5 overall — recommended-to-friend signal. Drives the Best
  /// Employer award weight more than the axis scores.
  overallRating      Int
  /// 200-char headline + free-form body, both moderated.
  headline           String               @db.VarChar(220)
  pros               String               @db.Text
  cons               String               @db.Text
  /// Optional job title at the company. Public on the review card.
  reviewerJobTitle   String?
  /// Optional location of the office reviewed. Helps slice by city.
  reviewerLocation   String?
  status             CompanyReviewStatus  @default(PENDING)
  /// Admin reviewer + decision audit trail.
  moderatedById      String?
  moderatedBy        User?                @relation("CompanyReviewModerator", fields: [moderatedById], references: [id])
  moderatedAt        DateTime?
  moderationNotes    String?              @db.Text
  /// Helpfulness counters — drive the top-review surfacing.
  helpfulCount       Int                  @default(0)
  reportCount        Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([companyId, reviewerUserId])
  @@index([companyId, status])
  @@index([status, createdAt])
}

// ─── InstitutionReview ────────────────────────────────────────
//
// Mirrors CompanyReview structure but with axis ratings tuned for
// educational institutions — faculty / infrastructure / placement /
// content quality / alumni network — and an institution-specific
// reviewer-relationship enum (CURRENT_STUDENT, ALUMNI, FACULTY,
// EMPLOYER_RECRUITER, TRAINEE).
//
// Public reviews drive AggregateRating JSON-LD on the institution
// detail page → Google rich-result eligibility. Same PENDING-by-
// default moderation flow as CompanyReview.

enum InstitutionReviewerRelationship {
  CURRENT_STUDENT
  ALUMNI
  FACULTY
  EMPLOYER_RECRUITER // recruiter who hired graduates from this institution
  TRAINEE // short-course / certification participant
  PROSPECTIVE // attended an open day / talked to admissions
}

enum InstitutionReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  WITHDRAWN
}

model InstitutionReview {
  id                   String                          @id @default(cuid())
  institutionId        String
  institution          Institution                     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// Nullable — anonymous reviews allowed (moderated more strictly).
  /// Signed-in reviewers with an Education row at this institution
  /// get a "verified alumni" pill on the public profile.
  reviewerUserId       String?
  reviewerUser         User?                           @relation("InstitutionReviewAuthor", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  relationship         InstitutionReviewerRelationship
  /// Five-axis ratings, 1-5 each. All required so the aggregate
  /// shown on the public page is consistent.
  facultyRating        Int
  infrastructureRating Int
  placementRating      Int
  contentRating        Int
  alumniRating         Int
  overallRating        Int
  headline             String                          @db.VarChar(220)
  pros                 String                          @db.Text
  cons                 String                          @db.Text
  programName          String? // "B.Tech EV", "PG Diploma in BMS"
  graduationYear       Int?
  status               InstitutionReviewStatus         @default(PENDING)
  moderatedById        String?
  moderatedBy          User?                           @relation("InstitutionReviewModerator", fields: [moderatedById], references: [id])
  moderatedAt          DateTime?
  moderationNotes      String?                         @db.Text
  helpfulCount         Int                             @default(0)
  reportCount          Int                             @default(0)
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@unique([institutionId, reviewerUserId])
  @@index([institutionId, status])
  @@index([status, createdAt])
}

// ─── EntityDiscussion (Reddit-style Q&A on Company / Institution) ──
//
// A polymorphic discussion surface attached to either a Company or
// an Institution — same UX, same table, different `entityType`.
// Anyone signed in can start a thread or reply. Threads get a public
// URL so Google indexes them as `DiscussionForumPosting` for SERP
// "Discussions and forums" rich results.
//
// Moderation: every new thread + reply lands PUBLISHED (low friction)
// but admin can hide / delete and the report counter on each row
// surfaces abuse for review.

enum EntityDiscussionTarget {
  COMPANY
  INSTITUTION
}

enum EntityDiscussionStatus {
  PUBLISHED
  HIDDEN // admin / author hid
  REMOVED // admin removed for policy violation
}

model EntityDiscussionThread {
  id           String                 @id @default(cuid())
  /// Which entity this thread belongs to. Combined with `entityId`
  /// to make the FK polymorphic. We don't model FK constraints to
  /// Company / Institution because Prisma doesn't support
  /// conditional / polymorphic relations cleanly; the application
  /// layer validates the FK shape on insert.
  entityType   EntityDiscussionTarget
  entityId     String
  /// Public thread slug. /company/<slug>/discuss/<threadSlug> or
  /// /institutions/<slug>/discuss/<threadSlug>. Unique per entity.
  slug         String
  title        String
  body         String                 @db.Text
  authorUserId String
  authorUser   User                   @relation("DiscussionThreadAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  status       EntityDiscussionStatus @default(PUBLISHED)
  /// Denormalised counts to keep the listing page fast — incremented
  /// inside the reply / report / vote actions.
  replyCount   Int                    @default(0)
  upvoteCount  Int                    @default(0)
  reportCount  Int                    @default(0)
  /// Last activity drives the "Recently active" rail on the
  /// discussion tab; bumped on every new reply.
  lastActivity DateTime               @default(now())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  replies EntityDiscussionReply[]

  @@unique([entityType, entityId, slug])
  @@index([entityType, entityId, lastActivity])
  @@index([status, createdAt])
}

model EntityDiscussionReply {
  id            String                  @id @default(cuid())
  threadId      String
  thread        EntityDiscussionThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// Optional parent reply for nested threading (Reddit-style).
  /// NULL = top-level reply directly under the thread.
  parentReplyId String?
  parentReply   EntityDiscussionReply?  @relation("DiscussionReplyParent", fields: [parentReplyId], references: [id], onDelete: Cascade)
  childReplies  EntityDiscussionReply[] @relation("DiscussionReplyParent")
  body          String                  @db.Text
  authorUserId  String
  authorUser    User                    @relation("DiscussionReplyAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  status        EntityDiscussionStatus  @default(PUBLISHED)
  upvoteCount   Int                     @default(0)
  reportCount   Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([threadId, createdAt])
  @@index([parentReplyId])
}

enum EmployerAwardCategory {
  BEST_OVERALL // top-of-the-list award
  BEST_FOR_BATTERY_ROLES
  BEST_FOR_CHARGING_ROLES
  BEST_FOR_MOTOR_ROLES
  BEST_FOR_SOFTWARE_ROLES
  BEST_FOR_FRESHERS
  BEST_REMOTE_CULTURE
  FASTEST_RESPONDER // best applicant response time
  MOST_LOVED_BY_DIYGURU // highest DIYguru-cohort retention
}

model EmployerAward {
  id             String                @id @default(cuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Year the award is for ("2026" badge stays up across 2026).
  year           Int
  category       EmployerAwardCategory
  /// 1 = winner, 2 = runner-up. Top 10 in each category get badges.
  rank           Int
  /// Composite signal that produced the rank (rolled-up for the
  /// award-page tooltip: "Based on 124 reviews, 4.6 avg, 87% recommend,
  /// avg response time 6h").
  scoreBreakdown Json
  awardedAt      DateTime              @default(now())

  @@unique([companyId, year, category])
  @@index([year, category, rank])
}

// ─── #29 EV facet filter — sidecar tables ───────────────────────────
//
// New facet columns are added directly to JobPosting / Company /
// CandidateProfile below via Prisma's `@map`-less inline additions.
// We chose sidecar tables for `JobCertification` / `CandidateCertification`
// over plain `String[]` columns because the same canonical certification
// (ARAI, FAME-II, BIS, ASDC) appears across thousands of jobs/profiles
// and a free-text array would let typos drift the recruiter filter into
// uselessness. The canonical list is seeded; admins can add new entries.

// Canonical EV-industry credential (ARAI / FAME-II / BIS / ASDC). The
// existing `Certification` model is free-text per-candidate; this is the
// admin-curated lookup that the filter dropdown reads from. Distinct
// table so the recruiter facet doesn't drift on typos.
model Credential {
  id           String  @id @default(cuid())
  /// Stable slug — "arai", "fame-ii", "bis-is15129", "asdc-level-3".
  slug         String  @unique
  /// Display name on chips / filter rows.
  name         String
  /// Long-form authority — "Automotive Research Association of India".
  authority    String?
  /// Optional EV domain this credential belongs to. Lets the filter UI
  /// group "ARAI under Vehicle Engineering".
  evDomainSlug String?
  /// Order in the filter dropdown.
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  jobs       JobCredential[]
  candidates CandidateCredential[]

  @@index([evDomainSlug, isActive])
}

model JobCredential {
  jobId        String
  credentialId String
  job          JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  /// When true, the candidate MUST hold this credential for the job
  /// to surface in their match results. When false, it's a "nice to
  /// have" — boosts the score but doesn't gate inclusion.
  required     Boolean    @default(false)

  @@id([jobId, credentialId])
  @@index([credentialId])
}

model CandidateCredential {
  candidateId   String
  credentialId  String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  credential    Credential       @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  /// When the candidate earned it. Used to highlight recent (<2y)
  /// credentials on the profile.
  earnedAt      DateTime?
  /// Optional URL to the credential PDF / verification page.
  credentialUrl String?

  @@id([candidateId, credentialId])
  @@index([credentialId])
}

// ─── #14 EV Career Explorer ─────────────────────────────────────────
//
// Cached per-user exploration runs. We don't precompute the adjacency
// graph — instead, when a user explores a role, the result is cached
// here for ~30 days so revisits + share links don't re-burn AI tokens.

model CareerExplorationLog {
  id            String   @id @default(cuid())
  /// Nullable — anonymous explorations are allowed (visible only via
  /// the share link UUID).
  userId        String?
  user          User?    @relation("CareerExplorerUser", fields: [userId], references: [id], onDelete: SetNull)
  /// Free-text "current role" the user entered.
  fromRole      String
  /// Optional EV domain slug context.
  evDomainSlug  String?
  /// Comma-joined skill snapshot at exploration time. Lets us
  /// re-rank later if their skills change without re-prompting OpenAI.
  fromSkillsCsv String   @db.Text
  /// AI result: an array of `{ toRole, score, skillGap[],
  /// reason, prepLinks }`. Stored JSON for schema agility.
  result        Json
  /// 30-day cache key — same fromRole + evDomain + skill set returns
  /// the cached row instead of re-prompting.
  cacheKey      String
  tokensUsed    Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([cacheKey, createdAt])
  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Wave A — Profile signals & feed delight (#5, #10)
// ═══════════════════════════════════════════════════════════════════

// ─── #10 Profile Performance (search-impression tracking) ───────────
//
// Each week, every candidate row that surfaces in a recruiter's
// /employer/candidates query gets counted once per recruiter per week.
// We aggregate (not per-event) so cardinality stays low — at scale a
// candidate might appear in 200+ searches per week and we never need
// per-search granularity for the "you appeared in X searches" stat.
//
// Why per-recruiter per-week rather than just per-week: the same
// recruiter scrolling a search page hits the query repeatedly. Without
// the recruiter axis we'd over-count by 5-10x just from pagination.

model ProfileSearchAppearance {
  id              String           @id @default(cuid())
  candidateId     String
  candidate       CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// The recruiter who ran the search (their User id; we resolve back
  /// to EmployerProfile lazily in the analytics view). Null when a
  /// public visitor browses the same candidate list — kept distinct
  /// so "recruiter views" and "public views" don't blur together.
  recruiterUserId String?
  /// Monday-aligned UTC date so weekly buckets are stable across
  /// timezone boundaries. Stored as a date-truncated DateTime.
  weekStart       DateTime
  /// Times this candidate appeared in the recruiter's search results
  /// over the week. Incremented on each new query (capped at 50 per
  /// week per recruiter to keep one obsessive recruiter from
  /// inflating the stat).
  count           Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([candidateId, recruiterUserId, weekStart])
  @@index([candidateId, weekStart])
}

// ─── #5 EV Community Groups ─────────────────────────────────────────
//
// Groups are curated topic spaces (Battery Engineers, Charging Infra,
// BMS, EV Service Techs, etc.) — a thin branded layer over the existing
// HashtagSubscription / hashtag-based feed. Each Group has a stable
// slug that doubles as a hashtag; a post that uses #<slug> shows in
// the group's feed automatically.
//
// We keep `memberCount` denormalised on the Group row so the browse
// page doesn't have to JOIN-count every render. The join action keeps
// the counter in sync inside a transaction.

model Group {
  id           String   @id @default(cuid())
  /// Stable slug — also used as the hashtag. "battery-engineers",
  /// "charging-infrastructure", "bms-design". Hashtag matching is
  /// case-insensitive so #BatteryEngineers and #battery-engineers
  /// hit the same group feed.
  slug         String   @unique
  name         String
  /// One-line tagline shown on the group card.
  tagline      String?  @db.VarChar(220)
  /// Long-form description rendered on the group detail page. Stored
  /// as plain text; rich text gets sanitised at render time via the
  /// existing htmlOrFallback helper.
  description  String?  @db.Text
  /// Banner image (cover photo) — 1500×500 ideal. Falls back to the
  /// brand mesh gradient when null.
  bannerUrl    String?
  /// EV domain this group is anchored to. Drives the browse-by-
  /// domain layout on /groups.
  evDomainSlug String
  /// Denormalised counter — incremented on join, decremented on
  /// leave. Surfaces on the browse card without a count() per render.
  memberCount  Int      @default(0)
  postCount    Int      @default(0)
  /// Public flag — admin-only groups stay hidden from browse.
  isPublic     Boolean  @default(true)
  /// Optional rules string shown above the post composer ("Posts must
  /// cite an EV topic; no recruiting; no self-promotion"). Rendered
  /// as plain text.
  rules        String?  @db.Text
  /// Sort order within an EV domain section.
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships GroupMembership[]

  @@index([evDomainSlug, isPublic])
}

model GroupMembership {
  id       String          @id @default(cuid())
  groupId  String
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation("GroupMember", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime        @default(now())
  /// Per-member notification preference — defaults to weekly digest
  /// to avoid spamming members who joined for browsability.
  notify   GroupNotifyMode @default(WEEKLY)

  @@unique([groupId, userId])
  @@index([userId])
}

enum GroupNotifyMode {
  REALTIME // every new post pings the member
  WEEKLY // Sunday digest
  OFF // joined-but-quiet
}

// ═══════════════════════════════════════════════════════════════════
// Wave B — Recruiter superpowers (#21 Sequenced outreach)
// ═══════════════════════════════════════════════════════════════════

// ─── #21 Sequenced outreach ──────────────────────────────────────────
//
// A recruiter defines a cadence per job (or one default cadence per
// company). Each cadence is a series of OutreachStep rows: "Day 0
// first-touch, Day 4 follow-up, Day 10 final". When a candidate is
// enrolled (via the recruiter or the AI Hiring Assistant), an
// OutreachEnrollment row tracks their position. A daily worker tick
// advances enrollments to the next step when (a) the step's delay
// has elapsed and (b) the candidate hasn't responded.
//
// We intentionally DON'T model the messages themselves here — they
// flow through the existing MessageThread + dispatchNotification
// path. Each OutreachStep just carries the template + scheduling
// metadata; the engine fills the template into a regular message
// when it fires.

model OutreachCadence {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Null = company-wide default cadence. Set = scoped to one job.
  /// Lets a recruiter customise the cadence for a senior role
  /// without rewriting the company default.
  jobId       String?
  job         JobPosting? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /// Cadence creator — nullable + SetNull so a recruiter leaving the
  /// company doesn't take their cadences with them (cadences belong
  /// to the company; enrollments continue firing).
  createdById String?
  createdBy   User?       @relation("OutreachCadenceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Friendly name for the rules list ("3-touch senior cadence",
  /// "Engineering screen pass").
  label       String
  enabled     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  steps       OutreachStep[]
  enrollments OutreachEnrollment[]

  @@index([companyId, enabled])
  @@index([jobId])
}

model OutreachStep {
  id        String          @id @default(cuid())
  cadenceId String
  cadence   OutreachCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  /// 0-indexed position in the sequence. Step 0 = first touch.
  order     Int
  /// Days from enrollment (not from previous step). So a "Day 0,
  /// Day 4, Day 10" cadence has delayDays = 0, 4, 10. Simplifies
  /// the engine's "is this step due" check to a single DateTime
  /// comparison against enrolledAt.
  delayDays Int             @default(0)
  /// Subject + body template strings. Placeholders supported:
  ///   {{candidateFirstName}}, {{candidateName}}, {{jobTitle}},
  ///   {{companyName}}, {{recruiterName}}, {{location}}.
  /// The engine does literal token replacement — no Mustache deps.
  subject   String?
  body      String          @db.Text
  /// Channel mask — usually [IN_APP, EMAIL], optionally [WHATSAPP]
  /// for high-volume blue-collar cadences. Stored as a string[] of
  /// the NotificationChannel enum values.
  channels  String[]        @default(["IN_APP", "EMAIL"])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([cadenceId, order])
}

enum OutreachEnrollmentStatus {
  ACTIVE // Still progressing through the cadence
  RESPONDED // Candidate replied — cadence paused
  COMPLETED // Last step fired with no response
  CANCELLED // Recruiter manually pulled the candidate
  FAILED // Provider rejected too many sends; auto-paused
}

model OutreachEnrollment {
  id            String                   @id @default(cuid())
  cadenceId     String
  cadence       OutreachCadence          @relation(fields: [cadenceId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application?             @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  candidateId   String
  candidate     CandidateProfile         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  /// Recruiter who enrolled the candidate. Nullable + SetNull so an
  /// in-flight cadence keeps firing even if the enrolling recruiter
  /// leaves. The engine sends from the company's identity, not the
  /// individual's, so this is purely an audit reference.
  enrolledById  String?
  enrolledBy    User?                    @relation("OutreachEnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull)
  enrolledAt    DateTime                 @default(now())
  /// Step index the engine is currently waiting to fire. Starts at 0
  /// (= "ready for first touch"). Increments after each send. The
  /// cadence is "done" when this exceeds the step count.
  nextStepIndex Int                      @default(0)
  /// Timestamp of the last step fired — engine uses this PLUS the
  /// step's delayDays-from-enrolledAt to compute due time.
  lastSentAt    DateTime?
  status        OutreachEnrollmentStatus @default(ACTIVE)
  /// Stamped when the candidate responds (any message from them on
  /// the thread). Engine flips status → RESPONDED.
  respondedAt   DateTime?
  cancelReason  String?

  @@unique([cadenceId, candidateId])
  @@index([status, nextStepIndex])
  @@index([candidateId])
}

// ─── Notification templates (admin-editable copy) ────────────────
//
// Until now, every notification's title / body text was hard-coded
// at the call site. That made small copy fixes a code+deploy round
// trip and put translation / tone management out of admin's reach.
//
// This model gives admin a row-per-type editable surface:
//
//   • `key` matches the `type` string passed to `dispatchNotification`
//     (e.g. "fair.slot_booked", "application.stage_changed"). The
//     dispatcher does a lookup on every call; if a row exists AND
//     `active = true`, its title/body OVERRIDE the inline values.
//     Backward-compat: if no row exists, behaviour is unchanged.
//   • Channel pinning is intentional — admin can flip "send the
//     'stage changed' notification via EMAIL+IN_APP only" without
//     touching code.
//   • `variables` documents what placeholders the inline call passes
//     (e.g. ["candidateName", "companyName", "stage"]). Used by the
//     editor preview pane to show admins what they can interpolate.
//
// Templates ARE NOT migrations — they coexist with the hard-coded
// defaults. A template row is opt-in per-key.

enum NotificationTemplateChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

model NotificationTemplate {
  id            String                        @id @default(cuid())
  /// Notification type key — matches `dispatchNotification({ type })`.
  /// Unique because one template per type. Examples:
  /// "application.stage_changed", "fair.slot_booked".
  key           String                        @unique
  /// Human label for the admin list. Optional — falls back to `key`.
  label         String?
  /// Short admin-facing note about when this fires.
  description   String?                       @db.Text
  /// Title override. Supports `{{var}}` placeholders sourced from
  /// the inline call's `title` PLUS payload. If null, inline wins.
  titleOverride String?
  /// Body override. Same placeholder rules as title.
  bodyOverride  String?                       @db.Text
  /// Which channels this template should fan out to. Null = use
  /// channels passed at the call site. Non-empty = enforce this set.
  channels      NotificationTemplateChannel[] @default([])
  /// Documented variables the call site provides. Used by the
  /// preview pane in the admin editor — not enforced at dispatch.
  variables     String[]                      @default([])
  /// Inactive templates are skipped by the dispatcher — useful for
  /// testing copy without breaking sends.
  active        Boolean                       @default(true)
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  authorId      String?
  author        User?                         @relation("NotificationTemplateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([active])
}

// ─── Notification dispatch log (per-user send history) ───────────
//
// The existing `Notification` model records IN_APP deliveries only.
// EMAIL / SMS / WHATSAPP / PUSH go to BullMQ + external providers,
// so there's been no central log of "did we send the welcome SMS
// to user X". This model fills that gap — the worker writes one row
// per channel per dispatch, including the provider's message id +
// final status. Powers /admin/notifications/logs and ad-hoc
// troubleshooting ("did the candidate get the rejection email?").

enum NotificationLogStatus {
  /// Worker accepted the dispatch and queued the provider call.
  QUEUED
  /// Provider accepted the message (returned 2xx + a message id).
  SENT
  /// Provider rejected the message (4xx) or upstream returned an error.
  FAILED
  /// Optional inbound webhook from the provider (e.g. SES bounce,
  /// MSG91 delivery) flipped the status post-send.
  DELIVERED
  BOUNCED
}

model NotificationLog {
  id                String                      @id @default(cuid())
  userId            String
  user              User                        @relation("NotificationLogUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Same `type` as `dispatchNotification` — links log rows back
  /// to the template / call site.
  type              String
  channel           NotificationTemplateChannel
  /// Snapshot of what actually went out (post-template, post-
  /// interpolation). Stored so we can show admins the exact copy
  /// the user received, not the template version at audit time.
  title             String?
  body              String?                     @db.Text
  /// Provider message id (Resend id, MSG91 id, Soketi message id).
  /// Useful for cross-referencing in the provider's own dashboard.
  providerMessageId String?
  status            NotificationLogStatus       @default(QUEUED)
  /// Provider error message on FAILED / BOUNCED.
  errorMessage      String?
  sentAt            DateTime                    @default(now())
  /// Stamped when status flips post-send (DELIVERED / BOUNCED via
  /// inbound webhook).
  deliveredAt       DateTime?

  @@index([userId, sentAt])
  @@index([type, sentAt])
  @@index([status, sentAt])
}

// ─── Feature flags (gradual rollout + targeted enrolment) ────────
//
// `SiteSetting` already handles binary kill switches for the four
// pillars. This model layers on top for the messier case: rolling a
// new feature out to 5% → 25% → 100% over a week, or A-team-only
// access during a private beta.
//
// Resolution order at `isFeatureEnabled(key, ctx)`:
//   1. If `enabled = false` → return false (universal kill).
//   2. If the user is in `FeatureFlagTarget` rows for this flag →
//      return targeted bool (overrides everything).
//   3. If `rolloutPercent > 0` → deterministic hash(key, userId) %
//      100 < rolloutPercent → true. Sticky per user.
//   4. Otherwise → false.
//
// Anonymous (signed-out) checks use the flag's `defaultForAnonymous`
// value rather than hashing — no userId to bucket on.

enum FeatureFlagType {
  /// Pure on/off — equivalent to a kill switch but lives in
  /// FeatureFlag rather than SiteSetting so newer flags ride the
  /// same audit surface.
  BOOLEAN
  /// Rolled out to `rolloutPercent`% of users via deterministic
  /// hashing. Sticky — same user gets same answer until percent
  /// changes.
  PERCENTAGE
  /// Only members of `FeatureFlagTarget` get true. Use for private
  /// betas, internal team flags, single-customer early access.
  TARGETED
}

model FeatureFlag {
  id                  String              @id @default(cuid())
  /// Programmatic key (e.g. "new_search_ui"). Unique.
  key                 String              @unique
  /// Human label for the admin list.
  label               String
  /// Markdown-supported notes — what does this flag toggle? Who owns it?
  description         String?             @db.Text
  type                FeatureFlagType     @default(BOOLEAN)
  /// Master switch — false short-circuits all resolution. Set to
  /// false to fully kill without losing the percent / target config.
  enabled             Boolean             @default(false)
  /// 0–100 for PERCENTAGE flags. Ignored for BOOLEAN / TARGETED.
  rolloutPercent      Int                 @default(0)
  /// Behaviour for signed-out (anonymous) calls. PERCENTAGE flags
  /// have no userId to hash on — this is what they return instead.
  defaultForAnonymous Boolean             @default(false)
  /// Soft milestones — admin-set, not enforced. Useful for the
  /// "started rollout 3 days ago" banner.
  startedAt           DateTime?
  completedAt         DateTime?
  authorId            String?
  author              User?               @relation("FeatureFlagAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  targets             FeatureFlagTarget[]

  @@index([enabled])
}

model FeatureFlagTarget {
  id        String      @id @default(cuid())
  flagId    String
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("FeatureFlagTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Boolean override for this user on this flag. Almost always
  /// true (private-beta enrolment), but `false` lets us explicitly
  /// EXCLUDE a user from a PERCENTAGE rollout that would otherwise
  /// have included them.
  enabled   Boolean     @default(true)
  /// Optional admin note ("VIP customer; opted into beta").
  note      String?
  createdAt DateTime    @default(now())

  @@unique([flagId, userId])
  @@index([userId])
}

// ─── Slug redirects (generic 308 lookup) ──────────────────────
//
// When we merge two entities (e.g. consolidating multiple DIYguru
// Company / Institution rows into one canonical row), the historical
// URLs at the old slugs must keep working so:
//   • inbound links from search engines, shares, and PDFs don't 404
//   • link equity flows to the canonical URL
//   • bookmarks survive
//
// This table holds a generic (entityType, fromSlug → toSlug) map.
// The /company/[slug], /institutions/[slug] and /[username] routes
// each do a redirect lookup *before* the entity-table lookup so the
// 308 fires fast (sub-50ms) without us touching the entity table.
//
// Idempotent — re-running a dedupe script overwrites the toSlug if
// it already exists for that (entityType, fromSlug) pair.

enum SlugRedirectEntityType {
  COMPANY
  INSTITUTION
  ARTICLE
  CANDIDATE
}

model SlugRedirect {
  id          String                 @id @default(cuid())
  entityType  SlugRedirectEntityType
  /// The old slug that should 308-redirect. Stored verbatim.
  fromSlug    String
  /// The canonical slug to redirect to. The frontend constructs the
  /// final URL by combining the entityType and toSlug.
  toSlug      String
  /// Free-text note for the admin who set this up — usually the
  /// rationale (e.g. "Merged DIYguru Foundation → canonical DIYguru
  /// company on 2026-05-18").
  reason      String?
  createdById String?
  createdAt   DateTime               @default(now())

  @@unique([entityType, fromSlug])
  @@index([entityType, toSlug])
}

// ─── Job-description templates (SEO + lead-gen surface) ────────
//
// 200+ EV-industry job-description templates surfaced at /jd and
// /jd/<slug>. The intent is twofold:
//   1. SEO — when HRs / candidates search "EV battery engineer job
//      description" or "EV charging technician JD India salary",
//      emobility.careers ranks for the long-tail query.
//   2. Lead-gen — public visitors see the top fold of every JD
//      (title, summary, overview, salary band, demand signal,
//      first ~3 responsibilities). The full body — complete
//      responsibilities/requirements, interview questions,
//      certifications, career path — is gated behind a sign-up
//      wall so we convert search traffic into platform accounts.
//
// Distinct from `JobPosting` (an actual employer-posted role with
// applications) and `Article` (free-form editorial copy). This is
// a templated role library: one row per canonical role title,
// admin-curated, evergreen.

enum JDCollarType {
  BLUE // Operators, helpers, technicians at the production / install end
  GREY // Skilled trades — service technicians, fitters, electricians
  WHITE // Engineers, managers, software, business roles
  CXO // C-suite + Heads-of executive positions
}

enum JDSeniority {
  ENTRY // 0-1 yr — apprentice / fresher
  JUNIOR // 1-3 yr
  MID // 3-6 yr
  SENIOR // 6-10 yr
  LEAD // 10-15 yr — managers / staff individual contributors
  PRINCIPAL // 15+ yr — directors / VPs / principal engineers
  EXECUTIVE // CXO / Head-of, separate from the IC ladder
}

enum JDFunctionalArea {
  ENGINEERING
  RESEARCH_AND_DEVELOPMENT
  SOFTWARE
  DATA_AND_AI
  PRODUCT
  DESIGN
  MANUFACTURING
  QUALITY
  SUPPLY_CHAIN
  OPERATIONS
  SERVICE_AND_AFTERSALES
  SALES
  MARKETING
  BUSINESS_DEVELOPMENT
  HR_AND_RECRUITING
  FINANCE
  LEGAL_AND_COMPLIANCE
  STRATEGY
  EXECUTIVE
}

enum JDStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model JobDescriptionTemplate {
  id                String   @id @default(cuid())
  /// URL-safe identifier. Surfaced at /jd/<slug>. Stable — renaming
  /// is a 30x redirect, not a slug edit.
  slug              String   @unique
  /// Canonical role title (e.g. "Battery Cell Engineer").
  title             String
  /// Common synonyms the role is known by ("Lithium-ion Cell
  /// Engineer", "Cell Design Engineer"). Indexed into searchTsv so
  /// /jd?q= matches them; also shown as "Also known as: …" on the
  /// detail page.
  alternativeTitles String[] @default([])
  /// Single-line summary — used as the OG description, /jd card
  /// preview, and search-snippet meta. ≤160 chars.
  summary           String

  // ─── Classification ───────────────────────────────────────
  collarType        JDCollarType
  seniority         JDSeniority
  functionalArea    JDFunctionalArea
  /// Optional FK into EVDomain (Battery / Charging / Motor / etc.) —
  /// drives the per-domain hub pages at /jd?domain=<slug>.
  evDomainId        String?
  evDomain          EVDomain?        @relation(fields: [evDomainId], references: [id], onDelete: SetNull)
  /// Companies the role typically lives at — surfaced as suggestion
  /// chips on the public page and used to seed `/jd?company=` queries.
  typicalCompanies  String[]         @default([])
  /// Industry verticals where the role appears (e.g. "EV OEM",
  /// "Tier-1 supplier", "Charging operator").
  typicalIndustries String[]         @default([])

  // ─── Body ─────────────────────────────────────────────────
  /// Long-form overview paragraph. Markdown allowed; rendered with
  /// the same pipeline as Article bodies. Visible to public.
  overview                String   @db.Text
  /// 6-12 bullet responsibilities. First 3 are visible to public;
  /// the rest are gated behind sign-up.
  responsibilities        String[] @default([])
  /// Mandatory qualifications. First 3 visible to public; rest gated.
  requirements            String[] @default([])
  /// Nice-to-haves — fully gated.
  preferredQualifications String[] @default([])
  /// Skills/keywords — fully visible (drives the SEO keyword
  /// density). Aim for 8-15 entries.
  keySkills               String[] @default([])
  /// Tools / software / hardware the role uses (e.g. "MATLAB",
  /// "Altium", "AVL CRUISE"). Fully visible.
  tools                   String[] @default([])
  /// Industry certifications relevant to the role (e.g. "ASDC Level
  /// 4", "SAE J2954"). Gated.
  certifications          String[] @default([])

  // ─── Salary insights (India-default) ──────────────────────
  experienceMinYears Int          @default(0)
  experienceMaxYears Int          @default(2)
  salaryMinLakhs     Float?
  salaryMedianLakhs  Float?
  salaryMaxLakhs     Float?
  salaryCurrency     String       @default("INR")
  salaryPeriod       SalaryPeriod @default(YEARLY)
  /// Optional LIKE pattern matched against `SalarySubmission.jobTitle`
  /// when computing the live "what people on platform earn" badge.
  /// Example: "%Battery%Engineer%". Falls back to the static
  /// salaryMin/Median/Max above when no matches.
  salaryRoleQuery    String?

  // ─── Career path + reporting structure ───────────────────
  /// Ordered career-path string array — e.g.
  /// ["Junior Battery Engineer", "Battery Engineer",
  ///  "Senior Battery Engineer", "Lead — Battery Systems"].
  /// Renders as a numbered ladder on the detail page (gated).
  careerPath String[] @default([])
  /// Typical manager title (e.g. "Battery Systems Manager"). Single
  /// string. Visible to public.
  reportsTo  String?
  /// Titles that typically report to this role (set when this role
  /// itself is a manager). Gated.
  reports    String[] @default([])

  // ─── Interview prep (gated, used for AI-driven lead-gen) ──
  sampleInterviewQuestions String[] @default([])

  // ─── Hiring signals (always public — SEO surface) ─────────
  /// Free-text demand label — "Critical", "High", "Emerging",
  /// "Steady". Renders as a coloured pill. Admin picks from the
  /// dropdown; not enforced as an enum so we can add new labels
  /// without a schema migration.
  demandSignal   String?
  remoteFriendly Boolean @default(false)
  /// Free-text growth blurb ("+45% YoY hiring in India FY24-25").
  growthOutlook  String?

  // ─── Lifecycle ────────────────────────────────────────────
  status      JDStatus  @default(DRAFT)
  publishedAt DateTime?
  /// FK on the admin user who created the row. Nullable so
  /// scripted seeds don't fail when the author user is missing.
  authorId    String?
  author      User?     @relation("JDTemplateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // ─── SEO overrides ────────────────────────────────────────
  /// When set, overrides the auto-generated <title>. Useful for
  /// matching exact long-tail queries.
  metaTitle       String?
  metaDescription String?

  // ─── Reader signals ───────────────────────────────────────
  /// Fire-and-forget increment on the public detail page. Used for
  /// "Most-viewed JDs" widgets and ranking the /jd index.
  viewCount Int @default(0)

  // FTS — same generated-tsvector pattern as Skill / Institution.
  searchTsv Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([collarType, seniority])
  @@index([functionalArea])
  @@index([evDomainId])
  @@index([viewCount])
}

/// Kind of a `LearningCredential`. Drives which section of the
/// candidate profile renders the row and whether it shows by default.
///   • LESSON_COMPLETION — granular per-lesson activity; not surfaced
///     on the public profile (too noisy), kept for analytics + the
///     activity feed.
///   • COURSE_COMPLETION — "Completed: <Course>" line on the
///     Verified Learning section.
///   • CERTIFICATE — PDF + public verify link rendered with a
///     deep-link "Verify →" button.
///   • QUIZ_PASSED / QUIZ_FAILED — pass-only by default; the failed
///     row is still here for analytics + retake prompts.
///   • PROJECT — graded assignment.
///   • PLACEMENT_SESSION — attendance of a placement-team session.
enum LearningCredentialKind {
  LESSON_COMPLETION
  COURSE_COMPLETION
  CERTIFICATE
  QUIZ_PASSED
  QUIZ_FAILED
  PROJECT
  PLACEMENT_SESSION
}

/// Learning achievements imported from the academy app (or other
/// external systems in the future). Written by the outbox-webhook
/// receiver at /api/v1/sync/academy on a per-event basis — the
/// (`sourceEventId`) unique constraint makes replay-safe upserts:
/// academy can resend the same OutboxEvent.id and the second write
/// is a no-op.
///
/// Rendered on the candidate profile as the "Verified Learning"
/// section. The certificate kind carries the public verify code so
/// recruiters can deep-link to academy's /verify/<code> page for
/// one-click validation.
model LearningCredential {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Identifies the system that minted this row. Today: "academy".
  /// Reserved for future third-party MOOC integrations.
  sourceSystem String

  /// Opaque ID of the source row in the source system. For a course
  /// completion that's the academy Course.id; for a quiz it's
  /// "<courseId>:<quizId>"; for a certificate it's the publicCode.
  /// Composite with `sourceEventId` is the dedup signal, but most
  /// queries use `sourceEventId` alone (it's the unique key).
  sourceId String

  /// The originating OutboxEvent.id on academy. UNIQUE so academy
  /// retries on transient careers errors are idempotent here —
  /// second-delivery webhook upsert is a no-op.
  sourceEventId String @unique

  kind  LearningCredentialKind
  title String

  /// 0-100 score for quiz/project credentials; null for others.
  scorePct Float?

  /// Only set when `kind = CERTIFICATE`. Profile UI deep-links to
  /// https://emobility.academy/verify/<code> via a "Verify →" button.
  publicVerificationCode String?
  pdfUrl                 String?

  /// For corporate-sponsored completions careers shows "Sponsored
  /// by <name>". Stores the academy Tenant.id (Organisations were
  /// collapsed into Tenant.kind=CORPORATE on academy, per Phase 1.2).
  /// Display-name resolution is a careers-side concern.
  sponsorTenantId String?

  completedAt DateTime
  createdAt   DateTime @default(now())

  @@index([userId, kind])
  @@index([userId, completedAt])
}
